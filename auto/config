#!/bin/sh
# live-build configuration for MangOS. Called by `lb config` from build.sh,
# which exports the variables from scripts/versions.env.
set -e
: "${MANGOS_VERSION:=0.1.0}" "${DEBIAN_SUITE:=trixie}"
: "${DEBIAN_MIRROR:=https://deb.debian.org/debian}"
: "${DEBIAN_SECURITY_MIRROR:=https://security.debian.org/debian-security}"

lb config noauto \
  --mode debian \
  --distribution "$DEBIAN_SUITE" \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "$DEBIAN_MIRROR" \
  --mirror-chroot "$DEBIAN_MIRROR" \
  --mirror-binary "$DEBIAN_MIRROR" \
  --mirror-chroot-security "$DEBIAN_SECURITY_MIRROR" \
  --mirror-binary-security "$DEBIAN_SECURITY_MIRROR" \
  --security true \
  --updates true \
  --apt-recommends false \
  --binary-images iso-hybrid \
  --bootloaders "syslinux,grub-efi" \
  --uefi-secure-boot auto \
  --build-with-chroot false \
  --debian-installer none \
  --firmware-chroot true \
  --firmware-binary true \
  --linux-flavours amd64 \
  --memtest none \
  --chroot-squashfs-compression-type zstd \
  --iso-application "MangOS" \
  --iso-publisher "MangOS project" \
  --iso-volume "MangOS ${MANGOS_VERSION}" \
  --image-name "MangOS-${MANGOS_VERSION}" \
  --hdd-label "MANGOS" \
  --bootappend-live "boot=live components quiet splash username=mangos user-fullname=MangOS hostname=mangos locales=en_US.UTF-8 keyboard-layouts=us" \
  ${MANGOS_APT_PROXY:+--apt-http-proxy "$MANGOS_APT_PROXY"} \
  "${@}"
