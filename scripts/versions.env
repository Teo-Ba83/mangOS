# Pinned upstream sources, so builds are reproducible. Update deliberately.
MANGOS_VERSION=0.1.0
MANGOS_CODENAME=alphonso
DEBIAN_SUITE=trixie
DEBIAN_MIRROR=https://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=https://security.debian.org/debian-security

# WhiteSur themes by vinceliuice (GPL-3.0 / MIT)
WHITESUR_GTK_REPO=https://github.com/vinceliuice/WhiteSur-gtk-theme
WHITESUR_GTK_REF=d5782652d412137e26fb8ff55b55a5572e4c6995
WHITESUR_ICON_REPO=https://github.com/vinceliuice/WhiteSur-icon-theme
WHITESUR_ICON_REF=73d8040da51a9ed74e47c7366e7e9ff437601a5c
WHITESUR_CURSOR_REPO=https://github.com/vinceliuice/WhiteSur-cursors
WHITESUR_CURSOR_REF=e190baf618ed95ee217d2fd45589bd309b37672b

# ArtCraft (storytold). "latest" resolves the newest release at build time;
# set an explicit version (e.g. 0.7.0) to pin it.
ARTCRAFT_APPS="craft-launcher:artcraft-launcher wordcraft:wordcraft pdfcraft:pdfcraft photocraft:photocraft"
ARTCRAFT_VERSION_craft_launcher=latest
ARTCRAFT_VERSION_wordcraft=latest
ARTCRAFT_VERSION_pdfcraft=latest
ARTCRAFT_VERSION_photocraft=latest
