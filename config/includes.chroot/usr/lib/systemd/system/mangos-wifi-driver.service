[Unit]
Description=MangOS: Wi-Fi driver chosen on the kernel command line (mangos.wifi=)
ConditionKernelCommandLine=|mangos.wifi=b43
ConditionKernelCommandLine=|mangos.wifi=wl
After=systemd-modules-load.service systemd-udev-trigger.service
Before=NetworkManager.service network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/bin/mangos-wifi-driver --boot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
