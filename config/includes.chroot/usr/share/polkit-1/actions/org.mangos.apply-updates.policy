<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.mangos.apply-updates">
    <description>Install software updates</description>
    <description xml:lang="it">Installa gli aggiornamenti software</description>
    <message>Authentication is required to install updates</message>
    <message xml:lang="it">È richiesta l'autenticazione per installare gli aggiornamenti</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mangos/apply-updates</annotate>
  </action>
</policyconfig>
