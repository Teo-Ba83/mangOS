<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.mangos.store">
    <description>Install or remove software</description>
    <description xml:lang="it">Installa o rimuovi software</description>
    <message>Authentication is required to install or remove software</message>
    <message xml:lang="it">È richiesta l'autenticazione per installare o rimuovere software</message>
    <icon_name>mangos-store</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mangos/store-helper</annotate>
  </action>
</policyconfig>
