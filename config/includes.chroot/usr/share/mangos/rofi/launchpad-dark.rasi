/* MangOS Launchpad (dark) */
configuration {
  show-icons: true;
  icon-theme: "WhiteSur-dark";
  font: "Inter 11";
  scroll-method: 0;   /* page by page */
  drun-match-fields: "name,generic,exec,categories,keywords";
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: "MousePrimary";
  kb-cancel: "Escape,Super+space";
}
* {
  background-color: transparent;
  text-color: #F5F5F7;
}
window {
  fullscreen: true;
  transparency: "real";
  background-color: rgba(22,20,34,0.90);
  padding: 6% 12% 4% 12%;
}
mainbox { children: [ inputbar, listview ]; spacing: 4%; }
inputbar {
  children: [ entry ];
  background-color: rgba(255,255,255,0.12);
  border-radius: 10px;
  padding: 8px 14px;
  margin: 0 34% 0 34%;
}
entry { placeholder: "Search"; placeholder-color: #F5F5F7; horizontal-align: 0.5; }
listview {
  columns: 6;
  lines: 4;
  spacing: 3%;
  fixed-columns: true;
  flow: horizontal;
  cycle: false;
  scrollbar: false;
}
element {
  orientation: vertical;
  padding: 10px;
  spacing: 8px;
  border-radius: 14px;
}
element selected { background-color: rgba(255,255,255,0.14); }
element-icon { size: 64px; horizontal-align: 0.5; }
element-text { horizontal-align: 0.5; vertical-align: 0.5; text-color: inherit; }
