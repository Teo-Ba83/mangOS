[Desktop Entry]
Type=Application
Name=Audio Check
Name[it]=Controllo audio
Comment=Show the sound card and the state of the audio system
Comment[it]=Mostra la scheda audio e lo stato del sistema audio
Exec=xfce4-terminal --hold --geometry=110x40 --title="Audio Check" -x mangos-audio-check
Icon=audio-card
Terminal=false
Categories=AudioVideo;Audio;System;Utility;
Keywords=audio;sound;speaker;volume;suono;altoparlanti;
