#!/bin/sh
# Launchpad: full-screen grid of all applications with search.
# Press again (or Esc) to close. Light/dark follows the MangOS appearance.
if pgrep -u "$(id -u)" -x rofi >/dev/null; then pkill -u "$(id -u)" -x rofi; exit 0; fi
mode=$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/mangos/appearance" 2>/dev/null || echo light)
case "$LANG" in it*) prompt="Cerca";; *) prompt="Search";; esac
exec rofi -show drun -theme "/usr/share/mangos/rofi/launchpad-$mode.rasi" \
  -drun-display-format "{name}" -display-drun "$prompt" -no-drun-show-actions "$@"
