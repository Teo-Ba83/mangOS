#!/bin/sh
# Starts the MangOS installer from the live session.
[ -e /etc/fstab ] && sudo mv /etc/fstab /etc/fstab.orig.calamares
export QT_AUTO_SCREEN_SCALE_FACTOR=1
xhost +si:localuser:root >/dev/null
pkexec env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" calamares "$@"
xhost -si:localuser:root >/dev/null
[ -e /etc/fstab.orig.calamares ] && sudo mv /etc/fstab.orig.calamares /etc/fstab
exit 0
