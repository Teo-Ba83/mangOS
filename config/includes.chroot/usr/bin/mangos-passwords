#!/usr/bin/python3
"""MangOS Passwords: the saved passwords and Wi-Fi networks, like the Mac's Keychain.

- Passwords: the items of the login keyring (GNOME Keyring, unlocked at
  login), the one apps use through libsecret. Add, copy, show, delete.
- Wi-Fi: the saved networks (NetworkManager): show the password, copy it,
  share it as a QR code a phone can scan, forget the network.
- Firefox keeps its own passwords: a button opens them (about:logins).
Showing or copying a password first asks for the user's password, like the
Mac (checked with pam_unix's unix_chkpwd, for this user only), then not
again for 5 minutes."""
import os, pwd, subprocess, sys, time
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Secret", "1")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango, Secret
from mangos import tr, load_css

SCHEMA = Secret.Schema.new("org.mangos.Password", Secret.SchemaFlags.NONE,
                           {"url": Secret.SchemaAttributeType.STRING,
                            "username": Secret.SchemaAttributeType.STRING})
ENV = dict(os.environ, LC_ALL="C", LANG="C")
GRACE = 300

CSS = b"""
.pw-side { background: alpha(currentColor, .04); }
.pw-side list { background: transparent; }
.pw-side row { padding: 7px 10px; border-radius: 7px; margin: 1px 6px; }
.pw-side row:selected { background: #0A84FF; color: white; }
.pw-list row { padding: 7px 12px; }
.pw-name { font-weight: 600; }
.pw-sub { font-size: 11px; opacity: .6; }
.pw-big { font-size: 20px; font-weight: 800; }
.pw-key { opacity: .6; }
.pw-secret { font-family: monospace; font-size: 14px; }
.pw-empty { opacity: .5; font-size: 14px; }
"""

USER = pwd.getpwuid(os.getuid()).pw_name


def run(*args, inp=None):
    try:
        p = subprocess.run(list(args), capture_output=True, text=True, env=ENV, input=inp, timeout=20)
        return p.returncode, p.stdout
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""


def first_attr(attrs, *keys):
    for k in keys:
        if attrs.get(k):
            return attrs[k]
    return ""


# ---------------------------------------------------------------- data ----
def keyring_items():
    try:
        svc = Secret.Service.get_sync(Secret.ServiceFlags.OPEN_SESSION | Secret.ServiceFlags.LOAD_COLLECTIONS, None)
    except GLib.Error:
        return None
    items = []
    for col in svc.get_collections() or []:
        if col.get_locked():
            try:
                svc.unlock_sync([col], None)
            except GLib.Error:
                continue
        col.load_items_sync(None)
        for it in col.get_items() or []:
            a = it.get_attributes()
            schema = a.get("xdg:schema", "")
            if schema.startswith("org.freedesktop.NetworkManager"):
                continue            # shown under Wi-Fi
            items.append({
                "item": it, "label": it.get_label() or tr("Password", "Password"),
                "site": first_attr(a, "url", "origin_url", "server", "host", "domain", "service"),
                "user": first_attr(a, "username", "user", "username_value", "account", "login"),
                "kind": schema.rsplit(".", 1)[-1] if schema else "",
                "modified": it.get_modified()})
    return sorted(items, key=lambda i: i["label"].lower())


def wifi_networks():
    _, out = run("nmcli", "-t", "-f", "NAME,UUID,TYPE,TIMESTAMP", "connection", "show")
    nets = []
    for line in out.splitlines():
        parts = line.replace("\\:", "\0").split(":")
        if len(parts) >= 4 and parts[2] == "802-11-wireless":
            nets.append({"name": parts[0].replace("\0", ":"), "uuid": parts[1],
                         "used": int(parts[3] or 0)})
    return sorted(nets, key=lambda n: n["name"].lower())


def wifi_secret(uuid):
    """SSID, security and password of a saved network ('' if it has none)."""
    q = "802-11-wireless.ssid,802-11-wireless-security.key-mgmt,802-11-wireless-security.psk,802-11-wireless-security.wep-key0"
    rc, out = run("nmcli", "-s", "-g", q, "connection", "show", "uuid", uuid)
    vals = out.splitlines()
    if rc != 0 or len(vals) < 3 or (vals[1] and not (vals[2] or (len(vals) > 3 and vals[3]))):
        # secrets of system-wide networks may need administrator rights
        rc, out = run("pkexec", "nmcli", "-s", "-g", q, "connection", "show", "uuid", uuid)
        vals = out.splitlines()
    vals += [""] * (4 - len(vals))
    ssid, mgmt, psk, wep = (v.replace("\\:", ":") for v in vals[:4])
    return ssid, mgmt, psk or wep


# ------------------------------------------------------------ the window ----
class Passwords(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=tr("Passwords", "Password"))
        self.set_default_size(880, 560)
        self.set_icon_name("org.gnome.Seahorse")
        self.unlocked_at = 0
        self.section = "passwords"

        hb = Gtk.HeaderBar(show_close_button=True, title=tr("Passwords", "Password"))
        self.set_titlebar(hb)
        self.add_btn = Gtk.Button.new_from_icon_name("list-add-symbolic", Gtk.IconSize.BUTTON)
        self.add_btn.set_tooltip_text(tr("Add a Password", "Aggiungi una password"))
        self.add_btn.connect("clicked", lambda *_: self.add_dialog())
        hb.pack_start(self.add_btn)
        self.search = Gtk.SearchEntry(placeholder_text=tr("Search", "Cerca"), width_chars=20)
        self.search.connect("search-changed", lambda *_: self.fill())
        hb.pack_end(self.search)

        paned = Gtk.Paned(); self.add(paned)
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); side.get_style_context().add_class("pw-side")
        side.set_size_request(190, -1)
        self.sections = Gtk.ListBox(margin_top=8)
        for key, icon, label in (("passwords", "changes-prevent-symbolic", tr("Passwords", "Password")),
                                 ("wifi", "network-wireless-symbolic", "Wi-Fi")):
            row = Gtk.ListBoxRow(); row.key = key
            b = Gtk.Box(spacing=8)
            b.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU), False, False, 0)
            b.pack_start(Gtk.Label(label=label, xalign=0), True, True, 0)
            row.add(b); self.sections.add(row)
        self.sections.connect("row-selected", self.on_section)
        side.pack_start(self.sections, False, False, 0)
        ff = Gtk.Button(label=tr("Firefox Passwords…", "Password di Firefox…"), relief=Gtk.ReliefStyle.NONE,
                        margin=8, valign=Gtk.Align.END)
        ff.set_tooltip_text(tr("Firefox keeps the passwords of websites itself",
                               "Firefox conserva da sé le password dei siti"))
        ff.connect("clicked", lambda *_: subprocess.Popen(["firefox-esr", "about:logins"]))
        side.pack_end(ff, False, False, 0)
        paned.pack1(side, False, False)

        inner = Gtk.Paned(); paned.pack2(inner, True, False)
        self.list = Gtk.ListBox(); self.list.get_style_context().add_class("pw-list")
        self.list.connect("row-selected", self.on_row)
        ls = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER); ls.add(self.list); ls.set_size_request(280, -1)
        inner.pack1(ls, False, False)
        self.detail = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=24)
        inner.pack2(self.detail, True, False)

        self.sections.select_row(self.sections.get_row_at_index(0))

    # ---- authentication (like the Mac asking for the login password)
    def authenticate(self):
        if time.monotonic() - self.unlocked_at < GRACE:
            return True
        d = Gtk.Dialog(title=tr("Passwords", "Password"), transient_for=self, modal=True)
        d.add_buttons(tr("Cancel", "Annulla"), Gtk.ResponseType.CANCEL, "OK", Gtk.ResponseType.OK)
        d.set_default_response(Gtk.ResponseType.OK)
        box = d.get_content_area(); box.set_spacing(10); box.set_border_width(16)
        top = Gtk.Box(spacing=12)
        img = Gtk.Image.new_from_icon_name("dialog-password", Gtk.IconSize.DIALOG)
        top.pack_start(img, False, False, 0)
        top.pack_start(Gtk.Label(label=tr("Enter your password to see saved passwords.",
                                          "Inserisci la tua password per vedere le password salvate."),
                                 wrap=True, max_width_chars=40, xalign=0), True, True, 0)
        box.add(top)
        e = Gtk.Entry(visibility=False, activates_default=True, placeholder_text=tr("Password", "Password"))
        box.add(e)
        err = Gtk.Label(xalign=0); box.add(err)
        d.show_all()
        ok = False
        while d.run() == Gtk.ResponseType.OK:
            rc, _ = run("/usr/sbin/unix_chkpwd", USER, "nullok", inp=e.get_text() + "\0")
            if rc == 0:
                ok = True
                break
            err.set_markup("<span foreground='#FF453A'>" + tr("Wrong password", "Password errata") + "</span>")
            e.set_text("")
        d.destroy()
        if ok:
            self.unlocked_at = time.monotonic()
        return ok

    def copy(self, text, what):
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(text, -1)
        self.toast(tr(f"{what} copied", f"{what} copiato"))
        # clear a copied password from the clipboard after a minute
        GLib.timeout_add_seconds(60, lambda: (Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).wait_for_text() == text
                                              and Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text("", -1), False)[1])

    def toast(self, msg):
        if hasattr(self, "status"):
            self.status.set_text(msg)

    # ---- lists
    def on_section(self, lb, row):
        if row is None:
            return
        self.section = row.key
        self.add_btn.set_visible(self.section == "passwords")
        self.fill()

    def fill(self):
        q = self.search.get_text().strip().lower()
        for c in self.list.get_children():
            c.destroy()
        self.clear_detail()
        rows = []
        if self.section == "passwords":
            items = keyring_items()
            if items is None:
                self.empty(tr("The keyring is not available.", "Il portachiavi non è disponibile."))
                return
            for it in items:
                if q and q not in (it["label"] + it["site"] + it["user"]).lower():
                    continue
                rows.append((it, "dialog-password", it["label"], it["user"] or it["site"]))
        else:
            for n in wifi_networks():
                if q and q not in n["name"].lower():
                    continue
                rows.append((n, "network-wireless", n["name"],
                             tr("Last used ", "Ultimo uso ") + time.strftime("%d/%m/%Y", time.localtime(n["used"]))
                             if n["used"] else ""))
        for data, icon, name, sub in rows:
            row = Gtk.ListBoxRow(); row.data = data
            b = Gtk.Box(spacing=10)
            b.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
            t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            n = Gtk.Label(label=name, xalign=0, ellipsize=Pango.EllipsizeMode.END); n.get_style_context().add_class("pw-name")
            t.pack_start(n, False, False, 0)
            if sub:
                s = Gtk.Label(label=sub, xalign=0, ellipsize=Pango.EllipsizeMode.END); s.get_style_context().add_class("pw-sub")
                t.pack_start(s, False, False, 0)
            b.pack_start(t, True, True, 0)
            row.add(b); self.list.add(row)
        self.list.show_all()
        if not rows:
            self.empty(tr("No saved passwords", "Nessuna password salvata") if self.section == "passwords"
                       else tr("No saved Wi-Fi networks", "Nessuna rete Wi-Fi salvata"))

    def empty(self, text):
        self.clear_detail()
        l = Gtk.Label(label=text, vexpand=True); l.get_style_context().add_class("pw-empty")
        self.detail.pack_start(l, True, True, 0); self.detail.show_all()

    def clear_detail(self):
        for c in self.detail.get_children():
            c.destroy()

    def on_row(self, lb, row):
        if row is None:
            return
        (self.show_password if self.section == "passwords" else self.show_wifi)(row.data)

    # ---- detail pages
    def header(self, icon, title):
        top = Gtk.Box(spacing=14)
        img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG); img.set_pixel_size(48)
        top.pack_start(img, False, False, 0)
        t = Gtk.Label(label=title, xalign=0, wrap=True); t.get_style_context().add_class("pw-big")
        top.pack_start(t, True, True, 0)
        self.detail.pack_start(top, False, False, 0)
        self.grid = Gtk.Grid(column_spacing=14, row_spacing=10, margin_top=10)
        self.detail.pack_start(self.grid, False, False, 0)
        self.grow = 0

    def field(self, key, value, copy_what=None):
        k = Gtk.Label(label=key, xalign=1); k.get_style_context().add_class("pw-key")
        v = Gtk.Label(label=value or "—", xalign=0, selectable=True, ellipsize=Pango.EllipsizeMode.MIDDLE)
        self.grid.attach(k, 0, self.grow, 1, 1); self.grid.attach(v, 1, self.grow, 1, 1)
        if copy_what and value:
            b = Gtk.Button.new_from_icon_name("edit-copy-symbolic", Gtk.IconSize.BUTTON)
            b.set_tooltip_text(tr("Copy", "Copia")); b.set_relief(Gtk.ReliefStyle.NONE)
            b.connect("clicked", lambda *_: self.copy(value, copy_what))
            self.grid.attach(b, 2, self.grow, 1, 1)
        self.grow += 1

    def secret_field(self, get_secret, what):
        k = Gtk.Label(label=tr("Password", "Password"), xalign=1); k.get_style_context().add_class("pw-key")
        v = Gtk.Label(label="••••••••••", xalign=0, selectable=True); v.get_style_context().add_class("pw-secret")
        show = Gtk.Button(label=tr("Show", "Mostra"))
        cp = Gtk.Button.new_from_icon_name("edit-copy-symbolic", Gtk.IconSize.BUTTON)
        cp.set_tooltip_text(tr("Copy Password", "Copia la password")); cp.set_relief(Gtk.ReliefStyle.NONE)
        state = {"shown": False}

        def on_show(_b):
            if state["shown"]:
                v.set_text("••••••••••"); show.set_label(tr("Show", "Mostra")); state["shown"] = False
                return
            if not self.authenticate():
                return
            s = get_secret()
            v.set_text(s if s else tr("(none)", "(nessuna)")); show.set_label(tr("Hide", "Nascondi")); state["shown"] = True

        def on_copy(_b):
            if self.authenticate():
                s = get_secret()
                if s:
                    self.copy(s, what)
        show.connect("clicked", on_show); cp.connect("clicked", on_copy)
        bx = Gtk.Box(spacing=6); bx.pack_start(v, True, True, 0); bx.pack_start(show, False, False, 0)
        self.grid.attach(k, 0, self.grow, 1, 1); self.grid.attach(bx, 1, self.grow, 1, 1)
        self.grid.attach(cp, 2, self.grow, 1, 1)
        v.set_hexpand(True)
        self.grow += 1

    def footer(self, buttons):
        self.status = Gtk.Label(xalign=0); self.status.get_style_context().add_class("pw-sub")
        row = Gtk.Box(spacing=8, margin_top=16)
        for label, cb, destructive in buttons:
            b = Gtk.Button(label=label); b.connect("clicked", cb)
            if destructive:
                b.get_style_context().add_class("destructive-action")
            row.pack_start(b, False, False, 0)
        self.detail.pack_start(row, False, False, 0)
        self.detail.pack_start(self.status, False, False, 0)
        self.detail.show_all()

    def show_password(self, it):
        self.clear_detail()
        self.header("dialog-password", it["label"])
        if it["site"]:
            self.field(tr("Website", "Sito"), it["site"], tr("Address", "Indirizzo"))
        self.field(tr("User name", "Nome utente"), it["user"], tr("User name", "Nome utente"))

        def secret():
            try:
                it["item"].load_secret_sync(None)
                s = it["item"].get_secret()
                return s.get_text() if s else ""
            except GLib.Error:
                return ""
        self.secret_field(secret, tr("Password", "Password"))
        if it["modified"]:
            self.field(tr("Modified", "Modificata"), time.strftime("%d/%m/%Y %H:%M", time.localtime(it["modified"])))
        if it["kind"]:
            self.field(tr("Kind", "Tipo"), it["kind"])

        def delete(_b):
            if self.confirm(tr(f"Delete “{it['label']}”?", f"Eliminare “{it['label']}”?"),
                            tr("The app that saved it will ask for it again.",
                               "L'app che l'ha salvata la chiederà di nuovo.")):
                try:
                    it["item"].delete_sync(None)
                except GLib.Error:
                    pass
                self.fill()
        self.footer([(tr("Delete", "Elimina"), delete, True)])

    def show_wifi(self, n):
        self.clear_detail()
        self.header("network-wireless", n["name"])
        cache = {}

        def secret():
            if "s" not in cache:
                cache["s"] = wifi_secret(n["uuid"])
            return cache["s"][2]
        self.field(tr("Network", "Rete"), n["name"], tr("Name", "Nome"))
        self.secret_field(secret, tr("Password", "Password"))

        def share(_b):
            if not self.authenticate():
                return
            if "s" not in cache:
                cache["s"] = wifi_secret(n["uuid"])
            ssid, mgmt, pw = cache["s"]
            esc = lambda s: "".join("\\" + c if c in "\\;,:\"" else c for c in s)
            kind = "nopass" if not mgmt or mgmt == "none" and not pw else ("WEP" if mgmt == "none" else "WPA")
            payload = f"WIFI:T:{kind};S:{esc(ssid or n['name'])};" + (f"P:{esc(pw)};" if kind != "nopass" else "") + ";"
            rc = subprocess.run(["qrencode", "-s", "8", "-m", "2", "-o", "-", payload], capture_output=True)
            if rc.returncode != 0:
                self.toast(tr("qrencode is missing", "Manca qrencode")); return
            loader = GdkPixbuf.PixbufLoader.new_with_type("png"); loader.write(rc.stdout); loader.close()
            d = Gtk.Dialog(title=n["name"], transient_for=self, modal=True)
            d.add_buttons(tr("Done", "Fine"), Gtk.ResponseType.CLOSE)
            box = d.get_content_area(); box.set_spacing(8); box.set_border_width(16)
            box.add(Gtk.Image.new_from_pixbuf(loader.get_pixbuf()))
            box.add(Gtk.Label(label=tr("Scan it with the phone's camera to join the network.",
                                       "Inquadralo con la fotocamera del telefono per collegarti alla rete."),
                              wrap=True, max_width_chars=36))
            d.show_all(); d.run(); d.destroy()

        def forget(_b):
            if self.confirm(tr(f"Forget “{n['name']}”?", f"Dimenticare “{n['name']}”?"),
                            tr("Its password is deleted; to connect again you will need it.",
                               "La password viene cancellata; per ricollegarti ti servirà di nuovo.")):
                run("nmcli", "connection", "delete", "uuid", n["uuid"])
                self.fill()
        self.footer([(tr("Share with QR Code…", "Condividi con codice QR…"), share, False),
                     (tr("Forget This Network", "Dimentica questa rete"), forget, True)])

    def confirm(self, text, sub):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                              buttons=Gtk.ButtonsType.OK_CANCEL, text=text)
        d.format_secondary_text(sub)
        ok = d.run() == Gtk.ResponseType.OK
        d.destroy()
        return ok

    def add_dialog(self):
        d = Gtk.Dialog(title=tr("Add a Password", "Aggiungi una password"), transient_for=self, modal=True)
        d.add_buttons(tr("Cancel", "Annulla"), Gtk.ResponseType.CANCEL, tr("Add", "Aggiungi"), Gtk.ResponseType.OK)
        d.set_default_response(Gtk.ResponseType.OK)
        g = Gtk.Grid(column_spacing=10, row_spacing=8, margin=16)
        entries = {}
        for i, (key, label, vis) in enumerate((("label", tr("Name", "Nome"), True),
                                               ("url", tr("Website", "Sito"), True),
                                               ("username", tr("User name", "Nome utente"), True),
                                               ("password", tr("Password", "Password"), False))):
            g.attach(Gtk.Label(label=label, xalign=1), 0, i, 1, 1)
            e = Gtk.Entry(visibility=vis, activates_default=True, width_chars=30)
            g.attach(e, 1, i, 1, 1); entries[key] = e
        d.get_content_area().add(g); d.show_all()
        if d.run() == Gtk.ResponseType.OK and entries["password"].get_text():
            label = entries["label"].get_text().strip() or entries["url"].get_text().strip() or tr("Password", "Password")
            try:
                Secret.password_store_sync(SCHEMA, {"url": entries["url"].get_text().strip(),
                                                    "username": entries["username"].get_text().strip()},
                                           Secret.COLLECTION_DEFAULT, label, entries["password"].get_text(), None)
            except GLib.Error as e:
                self.toast(str(e))
            self.fill()
        d.destroy()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.mangos.Passwords")

    def do_activate(self):
        w = self.get_active_window()
        if w is None:
            load_css()
            p = Gtk.CssProvider(); p.load_from_data(CSS)
            Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            w = Passwords(self); w.show_all()
        w.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
