# columns of the models
C_NAME, C_ICON, C_FILE, C_ISDIR, C_SIZE, C_MTIME, C_KIND, C_KEY, C_SIZESTR, C_DATESTR, C_SMALL, C_URI = range(12)


def human_size(n):
    for unit in ("byte", "KB", "MB", "GB", "TB"):
        if n < 1000 or unit == "TB":
            return f"{n} byte" if unit == "byte" else f"{n:.1f} {unit}".replace(".", tr(".", ","))
        n /= 1000.0


def nice_date(ts):
    if not ts:
        return "—"
    d = time.localtime(ts)
    now = time.localtime()
    if d.tm_year == now.tm_year and d.tm_yday == now.tm_yday:
        return tr("Today, ", "Oggi, ") + time.strftime("%H:%M", d)
    if d.tm_year == now.tm_year and d.tm_yday == now.tm_yday - 1:
        return tr("Yesterday, ", "Ieri, ") + time.strftime("%H:%M", d)
    return time.strftime("%d %b %Y, %H:%M", d)


WINDOW_KEYS = ("view", "sort", "desc", "hidden", "w", "h", "servers")
PREF_KEYS = ("automount", "autoopen", "new_window")


def load_cfg():
    c = {"view": "icons", "sort": "name", "desc": False, "hidden": False, "w": 980, "h": 600,
         "automount": True, "autoopen": True, "new_window": "home"}
    try:
        c.update(json.load(open(CFG)))
    except (OSError, ValueError):
        pass
    return c


def save_cfg(c, keys=WINDOW_KEYS):
    """Saves only these keys (windows and Preferences share the file)."""
    try:
        fresh = load_cfg()
        fresh.update({k: c[k] for k in keys if k in c})
        os.makedirs(os.path.dirname(CFG), exist_ok=True)
        tmp = CFG + ".tmp"
        json.dump(fresh, open(tmp, "w"))
        os.replace(tmp, CFG)
    except OSError:
        pass


# The clipboard with files, the way the desktop and other file managers read
# it (x-special/gnome-copied-files, text/uri-list) and as text for the other
# apps. PyGObject cannot offer several clipboard formats, so GTK is called
# directly (gtk_clipboard_set_with_data).
_clip_keep = []


def set_file_clipboard(mode, uris, text):
    import ctypes
    try:
        gtk = ctypes.CDLL("libgtk-3.so.0")
    except OSError:
        return False

    class Target(ctypes.Structure):
        _fields_ = [("target", ctypes.c_char_p), ("flags", ctypes.c_uint), ("info", ctypes.c_uint)]
    GET = ctypes.CFUNCTYPE(None, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_uint, ctypes.c_void_p)
    CLEAR = ctypes.CFUNCTYPE(None, ctypes.c_void_p, ctypes.c_void_p)
    gtk.gtk_clipboard_get.restype = ctypes.c_void_p
    gtk.gtk_clipboard_get.argtypes = [ctypes.c_void_p]
    gtk.gdk_atom_intern.restype = ctypes.c_void_p
    gtk.gdk_atom_intern.argtypes = [ctypes.c_char_p, ctypes.c_int]
    gtk.gtk_clipboard_set_with_data.restype = ctypes.c_int
    gtk.gtk_clipboard_set_with_data.argtypes = [ctypes.c_void_p, ctypes.POINTER(Target), ctypes.c_uint, GET, CLEAR, ctypes.c_void_p]
    gtk.gtk_selection_data_get_target.restype = ctypes.c_void_p
    gtk.gtk_selection_data_get_target.argtypes = [ctypes.c_void_p]
    gtk.gtk_selection_data_set.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_int]
    gtk.gtk_selection_data_set_text.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
    data = {0: (mode + "\n" + "\n".join(uris)).encode(), 1: ("\r\n".join(uris) + "\r\n").encode(), 2: text.encode()}
    names = [(b"x-special/gnome-copied-files", 0), (b"text/uri-list", 1), (b"UTF8_STRING", 2),
             (b"text/plain;charset=utf-8", 2), (b"text/plain", 2), (b"STRING", 2), (b"TEXT", 2)]
    targets = (Target * len(names))(*[Target(n, 0, i) for n, i in names])

    def get(_cb, sd, info, _ud):
        if info == 2:
            gtk.gtk_selection_data_set_text(sd, data[2], len(data[2]))
        else:
            gtk.gtk_selection_data_set(sd, gtk.gtk_selection_data_get_target(sd), 8, data[info], len(data[info]))

    def clear(_cb, _ud):
        pass
    cbs = (GET(get), CLEAR(clear), targets)
    _clip_keep[:] = [cbs]                       # GTK keeps calling them until something else is copied
    clip = gtk.gtk_clipboard_get(gtk.gdk_atom_intern(b"CLIPBOARD", 0))
    return bool(gtk.gtk_clipboard_set_with_data(clip, targets, len(names), cbs[0], cbs[1], None))


class Thumbnails:
    """Asks Tumbler (the thumbnail service Thunar uses) for missing thumbnails."""
    def __init__(self, ready_cb):
        self.ready_cb = ready_cb
        self.proxy = None
        try:
            self.proxy = Gio.DBusProxy.new_for_bus_sync(
                Gio.BusType.SESSION, Gio.DBusProxyFlags.NONE, None, "org.freedesktop.thumbnails.Thumbnailer1",
                "/org/freedesktop/thumbnails/Thumbnailer1", "org.freedesktop.thumbnails.Thumbnailer1", None)
            self.proxy.connect("g-signal", self.on_signal)
        except GLib.Error:
            self.proxy = None

    def queue(self, items):          # [(uri, mime)]
        if not self.proxy or not items:
            return
        for i in range(0, len(items), 50):
            part = items[i:i + 50]
            try:
                self.proxy.call("Queue", GLib.Variant("(asasssu)", ([u for u, _ in part], [m for _, m in part],
                                                                     "normal", "default", 0)),
                                Gio.DBusCallFlags.NONE, -1, None, None)
            except GLib.Error:
                pass

    def on_signal(self, proxy, sender, signal, params):
        if signal == "Ready":
            self.ready_cb(params.unpack()[1])


class Jobs:
    """File jobs with their dialogs and progress bar: shared by the Finder
    windows and by the helper that does what the desktop asks (D-Bus)."""
    reselect = set()

    def in_trash(self):
        return False

    def reload_keep(self):
        return False

    def build_progress(self):
        self.jobs = []
        self.prog_rev = Gtk.Revealer(transition_type=Gtk.RevealerTransitionType.SLIDE_UP)
        pb = Gtk.Box(spacing=10, margin=8); pb.get_style_context().add_class("fd-progress")
        self.prog_label = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE)
        self.prog_bar = Gtk.ProgressBar(valign=Gtk.Align.CENTER)
        stop = Gtk.Button.new_from_icon_name("process-stop-symbolic", Gtk.IconSize.BUTTON)
        stop.set_tooltip_text(tr("Stop", "Interrompi")); stop.connect("clicked", lambda *_: self.stop_jobs())
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        col.pack_start(self.prog_label, False, False, 0); col.pack_start(self.prog_bar, False, False, 0)
        pb.pack_start(col, True, True, 0); pb.pack_end(stop, False, False, 0)
        self.prog_rev.add(pb)
        return self.prog_rev

    def after_job(self, job, errs):
        pass

    def display_name(self, f):
        try:
            return f.query_info("standard::display-name", Gio.FileQueryInfoFlags.NONE, None).get_display_name()
        except GLib.Error:
            return f.get_basename() or f.get_uri()

    def message(self, text):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
                              buttons=Gtk.ButtonsType.OK, text=text)
        d.run(); d.destroy()

    def run_job(self, kind, files, dest=None, label=None, **kw):
        if self.in_trash() and kind in ("copy", "move", "new_folder", "duplicate") and dest is not None and dest.get_uri_scheme() == "trash":
            if kind == "move":
                kind, dest = "trash", None          # dropping into the Trash = Move to Trash
            else:
                return
        job = fileops.Job(kind, files, dest, copy_word=tr("copy", "copia"),
                          folder_word=tr("untitled folder", "Nuova cartella"), **kw)
        job.progress = lambda d, t, n: GLib.idle_add(self.on_progress, job, d, t, n)
        job.conflict_cb = lambda src, dst: self.ask_main(self.ask_conflict, src, dst)
        job.confirm = lambda what, fs: self.ask_main(self.ask_confirm, what, fs)
        job.label = label or self.job_label(kind, files, dest)
        job.started = time.monotonic()
        self.jobs.append(job)

        def work():
            job.run()
            GLib.idle_add(self.job_done, job)
        threading.Thread(target=work, daemon=True).start()
        GLib.timeout_add(500, self.maybe_show_progress, job)
        return job

    def job_label(self, kind, files, dest):
        n = len(files)
        what = files[0].get_basename() if n == 1 else tr(f"{n} items", f"{n} elementi")
        where = self.display_name(dest) if dest else ""
        return {"copy": tr(f"Copying {what} to “{where}”", f"Copia di {what} in “{where}”"),
                "move": tr(f"Moving {what} to “{where}”", f"Spostamento di {what} in “{where}”"),
                "trash": tr(f"Moving {what} to the Trash", f"Spostamento di {what} nel Cestino"),
                "delete": tr(f"Deleting {what}", f"Eliminazione di {what}"),
                "empty_trash": tr("Emptying the Trash", "Svuotamento del Cestino"),
                "duplicate": tr(f"Duplicating {what}", f"Duplicazione di {what}"),
                "restore": tr(f"Putting back {what}", f"Ripristino di {what}"),
                "compress": tr(f"Compressing {what}", f"Compressione di {what}"),
                "copy_to": tr(f"Copying {what}", f"Copia di {what}"),
                "link": tr(f"Making an alias of {what}", f"Creazione alias di {what}")}.get(kind, "")

    def ask_main(self, fn, *args):
        """Runs a dialog on the main thread and waits for the answer (called from a job's thread)."""
        box, ev = {}, threading.Event()

        def run():
            box["r"] = fn(*args); ev.set()
            return False
        GLib.idle_add(run)
        ev.wait()
        return box["r"]

    def ask_conflict(self, src, dst):
        folder = fileops.is_dir(dst)
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                              buttons=Gtk.ButtonsType.NONE,
                              text=tr(f"An item named “{dst.get_basename()}” already exists in this location.",
                                      f"In questa posizione esiste già un elemento chiamato “{dst.get_basename()}”."))
        d.format_secondary_text(tr("Do you want to replace it with the one you are copying?",
                                   "Vuoi sostituirlo con quello che stai copiando?") if not folder else
                                tr("Merging adds the items of the folder you are copying; nothing is deleted.",
                                   "Unire aggiunge gli elementi della cartella che stai copiando; non viene eliminato niente."))
        d.add_buttons(tr("Stop", "Interrompi"), 1, tr("Skip", "Salta"), 2, tr("Keep Both", "Mantieni entrambi"), 3,
                      tr("Merge", "Unisci") if folder else tr("Replace", "Sostituisci"), 4)
        allc = Gtk.CheckButton(label=tr("Apply to all", "Applica a tutti"), margin_start=12)
        d.get_message_area().pack_start(allc, False, False, 0); allc.show()
        d.set_default_response(3)
        r = d.run(); a = allc.get_active(); d.destroy()
        return ({1: "cancel", 2: "skip", 3: "keep", 4: "replace"}.get(r, "cancel"), a)

    def ask_confirm(self, what, files):
        if what == "no-trash":
            n = len(files)
            return self.yes_no(tr(f"“{files[0].get_basename()}” cannot be moved to the Trash." if n == 1 else
                                  f"{n} items cannot be moved to the Trash.",
                                  f"“{files[0].get_basename()}” non può andare nel Cestino." if n == 1 else
                                  f"{n} elementi non possono andare nel Cestino."),
                               tr("This disk has no Trash. Delete immediately? You cannot undo this.",
                                  "Questo disco non ha un Cestino. Eliminare subito? Non si potrà annullare."),
                               tr("Delete", "Elimina"))
        return False

    def yes_no(self, text, sub, ok_label):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                              buttons=Gtk.ButtonsType.NONE, text=text)
        d.format_secondary_text(sub)
        d.add_buttons(tr("Cancel", "Annulla"), Gtk.ResponseType.CANCEL, ok_label, Gtk.ResponseType.OK)
        d.get_widget_for_response(Gtk.ResponseType.OK).get_style_context().add_class("destructive-action")
        d.set_default_response(Gtk.ResponseType.CANCEL)
        r = d.run(); d.destroy()
        return r == Gtk.ResponseType.OK

    def maybe_show_progress(self, job):
        if job in self.jobs:                       # still running after half a second: show the bar
            self.prog_rev.set_reveal_child(True)
        return False

    def on_progress(self, job, done, total, name):
        if not self.jobs or job is not self.jobs[-1]:
            return False
        frac = done / total if total else 0
        self.prog_bar.set_fraction(min(1, frac))
        left = ""
        el = time.monotonic() - job.started
        if frac > 0.02 and el > 2:
            secs = int(el / frac - el)
            left = (tr(f" — about {secs} s left", f" — circa {secs} s") if secs < 90 else
                    tr(f" — about {secs // 60} min left", f" — circa {secs // 60} min"))
        self.prog_label.set_text(f"{job.label}  {int(frac * 100)}%{left}")
        return False

    def stop_jobs(self):
        for j in list(self.jobs):
            j.cancel()

    def job_done(self, job):
        if job in self.jobs:
            self.jobs.remove(job)
        if not self.jobs:
            self.prog_rev.set_reveal_child(False)
        if job.undo:
            self.get_application().undo_stack.append((job.label, job.undo))
        self.reselect |= {f.get_uri() for f in job.created}
        errs = [e for e in job.errors if e != "cancelled"]
        if errs:
            self.message(tr("The operation could not be completed:\n", "L'operazione non è stata completata:\n") +
                         "\n".join(errs[:5]))
        self.after_job(job, errs)
        self.reload_keep()
        return False

    def rename_dialog(self, f=None):
        if f is None:
            sel = self.selected()
            if len(sel) != 1 or self.in_trash():
                return False
            f = sel[0][0]
        old = f.get_basename()
        d = Gtk.Dialog(title=tr("Rename", "Rinomina"), transient_for=self, modal=True)
        d.add_buttons(tr("Cancel", "Annulla"), Gtk.ResponseType.CANCEL, tr("Rename", "Rinomina"), Gtk.ResponseType.OK)
        d.set_default_response(Gtk.ResponseType.OK)
        e = Gtk.Entry(text=old, activates_default=True, width_chars=36, margin=14)
        d.get_content_area().add(e); d.show_all()
        base, ext = fileops.split_ext(old)
        e.select_region(0, len(base) if not fileops.is_dir(f) else -1)   # name without the extension, like the Mac
        while d.run() == Gtk.ResponseType.OK:
            new = e.get_text().strip()
            if new == old or not new:
                break
            job = fileops.Job("rename", [f], new_name=new).run()
            if job.errors:
                self.message(tr("Cannot rename: ", "Impossibile rinominare: ") + job.errors[0])
                continue
            self.get_application().undo_stack.append((tr("Rename", "Rinomina"), job.undo))
            self.reselect |= {c.get_uri() for c in job.created}
            self.reload_keep()
            break
        d.destroy()
        return False


class Finder(Jobs, Gtk.ApplicationWindow):
    def __init__(self, app, start):
        super().__init__(application=app, title="Mango Finder")
        self.cfg = load_cfg()
        self.set_default_size(self.cfg["w"], self.cfg["h"])
        self.set_icon_name("system-file-manager")
        self.history, self.future = [], []
        self.folder = None
        self.load_token = 0
        self.icon_theme = Gtk.IconTheme.get_default()
        self.icon_cache = {}
        self.rows_by_uri = {}
        self.thumbs = Thumbnails(self.on_thumbs_ready)

        # ---- header bar (the Mac's toolbar)
        hb = Gtk.HeaderBar(show_close_button=True)
        self.set_titlebar(hb)
        nav = Gtk.Box(); nav.get_style_context().add_class("linked")
        self.back_btn = Gtk.Button.new_from_icon_name("go-previous-symbolic", Gtk.IconSize.BUTTON)
        self.fwd_btn = Gtk.Button.new_from_icon_name("go-next-symbolic", Gtk.IconSize.BUTTON)
        self.back_btn.set_tooltip_text(tr("Back", "Indietro")); self.fwd_btn.set_tooltip_text(tr("Forward", "Avanti"))
        self.back_btn.connect("clicked", lambda *_: self.go_back())
        self.fwd_btn.connect("clicked", lambda *_: self.go_forward())
        nav.pack_start(self.back_btn, False, False, 0); nav.pack_start(self.fwd_btn, False, False, 0)
        hb.pack_start(nav)
        self.hb = hb

        self.search = Gtk.SearchEntry(placeholder_text=tr("Search", "Cerca"), width_chars=16)
        self.search.connect("search-changed", lambda *_: self.refilter())
        hb.pack_end(self.search)
        sort_btn = Gtk.MenuButton(image=Gtk.Image.new_from_icon_name("view-sort-ascending-symbolic", Gtk.IconSize.BUTTON))
        sort_btn.set_tooltip_text(tr("Sort By", "Ordina per"))
        sort_btn.set_popover(self.sort_popover(sort_btn))
        hb.pack_end(sort_btn)
        views = Gtk.Box(); views.get_style_context().add_class("linked")
        self.view_btns = {}
        group = None
        for key, icon, tip in (("icons", "view-grid-symbolic", tr("as Icons (Ctrl+1)", "come Icone (Ctrl+1)")),
                               ("list", "view-list-symbolic", tr("as List (Ctrl+2)", "come Elenco (Ctrl+2)")),
                               ("columns", "view-column-symbolic", tr("as Columns (Ctrl+3)", "come Colonne (Ctrl+3)")),
                               ("gallery", "view-coverflow-symbolic", tr("as Gallery (Ctrl+4)", "come Galleria (Ctrl+4)"))):
            b = Gtk.RadioButton.new_from_widget(group); group = group or b
            b.set_mode(False); b.set_image(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON))
            b.set_tooltip_text(tip)
            b.connect("toggled", lambda w, k=key: w.get_active() and self.set_view(k))
            views.pack_start(b, False, False, 0); self.view_btns[key] = b
        hb.pack_end(views)

        # ---- body
        paned = Gtk.Paned(); self.add(paned)
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); side.get_style_context().add_class("fd-side")
        side.set_size_request(190, -1)
        ss = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER); ss.add(side)
        paned.pack1(ss, False, False)
        self.side = side
        self.volumes = Gio.VolumeMonitor.get()
        for sig in ("mount-added", "mount-removed", "volume-added", "volume-removed"):
            self.volumes.connect(sig, lambda *_: self.fill_sidebar())
        self.fill_sidebar()

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        paned.pack2(right, True, False)
        # model: shared by both views; the list view uses a tree store for expandable folders
        self.new_stores()
        self.filter = self.store.filter_new(); self.filter.set_visible_func(self.visible)
        self.sorted = Gtk.TreeModelSort(model=self.filter)
        self.sorted.set_default_sort_func(self.compare)

        self.stack = Gtk.Stack()
        self.iconview = Gtk.IconView(model=self.sorted, pixbuf_column=C_ICON, text_column=C_NAME,
                                     item_width=96, column_spacing=6, row_spacing=10, margin=12,
                                     selection_mode=Gtk.SelectionMode.MULTIPLE, activate_on_single_click=False)
        self.iconview.get_style_context().add_class("fd-icons")
        self.iconview.connect("item-activated", lambda v, path: self.activate(self.sorted[path][C_FILE], self.sorted[path][C_ISDIR]))
        self.iconview.connect("button-press-event", self.on_button)
        isw = Gtk.ScrolledWindow(); isw.add(self.iconview)
        self.stack.add_named(isw, "icons")

        self.tree_sorted = Gtk.TreeModelSort(model=self.tree)
        self.tree_sorted.set_default_sort_func(self.compare)
        self.listview = Gtk.TreeView(model=self.tree_sorted, enable_search=False, headers_clickable=True)
        self.listview.get_selection().set_mode(Gtk.SelectionMode.MULTIPLE)
        col = Gtk.TreeViewColumn(tr("Name", "Nome")); col.set_expand(True); col.set_resizable(True)
        pr = Gtk.CellRendererPixbuf(); col.pack_start(pr, False); col.add_attribute(pr, "pixbuf", C_SMALL)
        tx = Gtk.CellRendererText(ellipsize=Pango.EllipsizeMode.END); col.pack_start(tx, True); col.add_attribute(tx, "text", C_NAME)
        col.set_clickable(True); col.connect("clicked", lambda *_: self.header_sort("name"))
        self.listview.append_column(col)
        for title, idx, key, xalign in ((tr("Date Modified", "Data di modifica"), C_DATESTR, "date", 0),
                                        (tr("Size", "Dimensione"), C_SIZESTR, "size", 1),
                                        (tr("Kind", "Tipo"), C_KIND, "kind", 0)):
            r = Gtk.CellRendererText(xalign=xalign); r.set_property("foreground-rgba", Gdk.RGBA(0.45, 0.45, 0.47, 1))
            c = Gtk.TreeViewColumn(title, r, text=idx); c.set_resizable(True); c.set_clickable(True)
            c.set_min_width(110 if key != "size" else 80)
            c.connect("clicked", lambda _c, k=key: self.header_sort(k))
            self.listview.append_column(c)
        self.listview.connect("row-activated", self.on_row_activated)
        self.listview.connect("test-expand-row", self.on_expand)
        self.listview.connect("button-press-event", self.on_button)
        lsw = Gtk.ScrolledWindow(); lsw.add(self.listview)
        self.stack.add_named(lsw, "list")
        self.columns = ColumnsView(self)
        self.stack.add_named(self.columns, "columns")
        self.gallery = GalleryView(self)
        self.stack.add_named(self.gallery, "gallery")
        self.empty = Gtk.Label(); self.empty.get_style_context().add_class("fd-empty")
        self.stack.add_named(self.empty, "empty")
        right.pack_start(self.stack, True, True, 0)

        # Trash: Empty Trash bar
        self.trash_bar = Gtk.Box(spacing=8, margin=6)
        tl = Gtk.Label(label=tr("Trash", "Cestino"), xalign=0); tl.get_style_context().add_class("fd-prev-name")
        self.trash_bar.pack_start(tl, True, True, 6)
        eb = Gtk.Button(label=tr("Empty", "Svuota")); eb.connect("clicked", lambda *_: self.empty_trash())
        self.trash_bar.pack_end(eb, False, False, 0)
        right.pack_start(self.trash_bar, False, False, 0); right.reorder_child(self.trash_bar, 0)
        self.trash_bar.set_no_show_all(True)      # shown only in the Trash (show_all must not show it)
        for c in self.trash_bar.get_children():
            c.show()
        # copy / move progress
        right.pack_start(self.build_progress(), False, False, 0)

        self.pathbar = Gtk.Box(spacing=0); self.pathbar.get_style_context().add_class("fd-path")
        right.pack_start(self.pathbar, False, False, 0)
        self.status = Gtk.Label(xalign=0.5); self.status.get_style_context().add_class("fd-status")
        right.pack_start(self.status, False, False, 0)

        self.connect("key-press-event", self.on_key)
        self.connect("delete-event", self.on_close)
        self.view_btns[self.cfg["view"]].set_active(True)
        self.set_view(self.cfg["view"])
        self.reselect = set()
        self.monitor = None
        self.setup_dnd()
        self.open_location(start, record=False)

    # ---------------------------------------------------------- models
    COLS = (str, GdkPixbuf.Pixbuf, object, bool, GObject.TYPE_INT64, GObject.TYPE_INT64, str, str, str, str, GdkPixbuf.Pixbuf, str)

    def new_stores(self):
        """Fresh stores, not yet shown: filling a model nobody watches is fast
        (no re-sorting on every row), which matters with thousands of files."""
        self.store = Gtk.ListStore(*self.COLS)
        self.tree = Gtk.TreeStore(*self.COLS)

    def attach_models(self):
        self.filter = self.store.filter_new(); self.filter.set_visible_func(self.visible)
        self.sorted = Gtk.TreeModelSort(model=self.filter)
        self.sorted.set_default_sort_func(self.compare)
        self.sorted.set_sort_column_id(Gtk.TREE_SORTABLE_DEFAULT_SORT_COLUMN_ID, Gtk.SortType.ASCENDING)
        self.iconview.set_model(self.sorted)
        self.tree_sorted = Gtk.TreeModelSort(model=self.tree)
        self.tree_sorted.set_default_sort_func(self.compare)
        self.tree_sorted.set_sort_column_id(Gtk.TREE_SORTABLE_DEFAULT_SORT_COLUMN_ID, Gtk.SortType.ASCENDING)
        self.listview.set_model(self.tree_sorted)

    # ---------------------------------------------------------- sidebar
    def fill_sidebar(self):
        for c in self.side.get_children():
            c.destroy()
        fav = [(tr("Recents", "Recenti"), "recent:///", "document-open-recent-symbolic")]
        for d, icon in ((GLib.UserDirectory.DIRECTORY_DESKTOP, "user-desktop-symbolic"),
                        (GLib.UserDirectory.DIRECTORY_DOCUMENTS, "folder-documents-symbolic"),
                        (GLib.UserDirectory.DIRECTORY_DOWNLOAD, "folder-download-symbolic"),
                        (GLib.UserDirectory.DIRECTORY_PICTURES, "folder-pictures-symbolic"),
                        (GLib.UserDirectory.DIRECTORY_MUSIC, "folder-music-symbolic"),
                        (GLib.UserDirectory.DIRECTORY_VIDEOS, "folder-videos-symbolic")):
            p = GLib.get_user_special_dir(d)
            if p and os.path.isdir(p) and os.path.realpath(p) != os.path.realpath(GLib.get_home_dir()):
                fav.append((os.path.basename(p), GLib.filename_to_uri(p), icon))
        fav.append((GLib.get_user_name(), GLib.filename_to_uri(GLib.get_home_dir()), "user-home-symbolic"))
        self.side_section(tr("Favourites", "Preferiti"), fav)
        loc, net = [], []
        for m in self.volumes.get_mounts():
            if m.is_shadowed():
                continue
            root = m.get_root()
            ejectable = m.can_eject() or m.can_unmount()
            if root.get_uri_scheme() not in ("file",) and not root.is_native():
                # a network share (smb, sftp, ftp, webdav), a phone (mtp) or a camera (gphoto2)
                scheme = root.get_uri_scheme()
                icon = {"mtp": "phone-symbolic", "gphoto2": "camera-photo-symbolic", "afc": "phone-symbolic",
                        "archive": "package-x-generic-symbolic"}.get(scheme, "folder-remote-symbolic")
                (loc if scheme in ("mtp", "gphoto2", "afc", "archive") else net).append((m.get_name(), root.get_uri(), icon, m))
                continue
            loc.append((m.get_name(), root.get_uri(), "drive-removable-media-symbolic" if m.can_eject()
                        else "drive-harddisk-symbolic", m if ejectable else None))
        for v in self.volumes.get_volumes():
            if v.get_mount() is None and v.can_mount():
                d = v.get_drive()
                loc.append((v.get_name(), ("volume", v),
                            "drive-removable-media-symbolic" if d and d.is_removable() else "drive-harddisk-symbolic",
                            v if v.can_eject() else None))
        loc.append((tr("Computer", "Computer"), "file:///", "computer-symbolic", None))
        loc.append((tr("Trash", "Cestino"), "trash:///", "user-trash-symbolic", None))
        self.side_section(tr("Locations", "Posizioni"), loc)
        net.insert(0, (tr("Network", "Rete"), "network:///", "network-workgroup-symbolic", None))
        net.append((tr("Connect to Server…", "Connetti al server…"), ("connect",), "list-add-symbolic", None))
        self.side_section(tr("Network", "Rete"), net)
        self.side.show_all()
        if self.folder:
            self.mark_sidebar()

    def side_section(self, title, items):
        h = Gtk.Label(label=title, xalign=0); h.get_style_context().add_class("fd-side-head")
        self.side.pack_start(h, False, False, 0)
        # no GTK selection (it picked rows by itself); the current place is marked by mark_sidebar
        lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE); lb.connect("row-activated", self.on_side)
        for name, target, icon, *rest in items:
            # not focusable: otherwise the first row takes the keyboard focus
            # when the window opens and stays highlighted wherever you are
            row = Gtk.ListBoxRow(can_focus=False); row.target = target
            b = Gtk.Box(spacing=8)
            img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU)
            img.get_style_context().add_class("dim-label")
            b.pack_start(img, False, False, 0)
            b.pack_start(Gtk.Label(label=name, xalign=0, ellipsize=Pango.EllipsizeMode.END), True, True, 0)
            ej = rest[0] if rest else None
            if ej is not None:                         # the eject button, like the Mac's sidebar
                eb = Gtk.Button(image=Gtk.Image.new_from_icon_name("media-eject-symbolic", Gtk.IconSize.MENU),
                                relief=Gtk.ReliefStyle.NONE, can_focus=False)
                eb.get_style_context().add_class("fd-eject")
                eb.set_tooltip_text(tr("Eject", "Espelli") + f" “{name}”")
                eb.connect("clicked", lambda _b, o=ej: self.eject(o))
                b.pack_end(eb, False, False, 0)
            row.add(b); lb.add(row)
            if hasattr(self, "dnd_targets") and (isinstance(target, str)):
                self.dnd_sidebar_row(row)
        self.side.pack_start(lb, False, False, 0)

    def on_side(self, lb, row):
        t = row.target
        if t == ("connect",):
            self.connect_dialog(); return
        if isinstance(t, tuple):                     # an unmounted volume: mount it, then open it
            def mounted(v, res):
                try:
                    v.mount_finish(res)
                except GLib.Error as e:
                    self.message(tr("Cannot open this drive: ", "Non riesco ad aprire questa unità: ") + e.message)
                    return
                if v.get_mount():
                    self.open_location(v.get_mount().get_root())
            t[1].mount(Gio.MountMountFlags.NONE, Gtk.MountOperation.new(self), None, mounted)
            return
        self.open_location(t)

    def mark_sidebar(self):
        uri = self.folder.get_uri().rstrip("/")
        for lb in [c for c in self.side.get_children() if isinstance(c, Gtk.ListBox)]:
            for row in lb.get_children():
                here = isinstance(row.target, str) and row.target.rstrip("/") == uri
                (row.get_style_context().add_class if here else row.get_style_context().remove_class)("fd-current")

    # ---------------------------------------------------------- navigation
    def open_location(self, where, record=True):
        f = where if isinstance(where, Gio.File) else (Gio.File.new_for_uri(where) if "://" in where
                                                       else Gio.File.new_for_path(where))
        if record and self.folder is not None and not self.folder.equal(f):
            self.history.append(self.folder); self.future.clear()
        self.folder = f
        self.mount_tried = None
        self.search.set_text("")
        self.back_btn.set_sensitive(bool(self.history)); self.fwd_btn.set_sensitive(bool(self.future))
        self.load()

    def go_back(self):
        if self.history:
            self.future.append(self.folder)
            self.folder = self.history.pop(); self.back_btn.set_sensitive(bool(self.history)); self.fwd_btn.set_sensitive(True)
            self.load()

    def go_forward(self):
        if self.future:
            self.history.append(self.folder)
            self.folder = self.future.pop(); self.fwd_btn.set_sensitive(bool(self.future)); self.back_btn.set_sensitive(True)
            self.load()

    def go_up(self):
        p = self.folder.get_parent()
        if p is not None:
            self.open_location(p)

    def activate(self, info_file, is_dir):
        f = info_file
        if is_dir:
            self.open_location(f)
            return
        if self.launch_desktop_file(f):
            return
        try:
            Gio.AppInfo.launch_default_for_uri(f.get_uri(), None)
        except GLib.Error as e:
            self.message(tr("Cannot open this file: ", "Non riesco ad aprire questo file: ") + e.message)

    # ---------------------------------------------------------- loading
    def load(self):
        self.load_token += 1
        token = self.load_token
        self.iconview.set_model(None); self.listview.set_model(None)
        self.new_stores(); self.rows_by_uri = {}; self.hidden_rows = set()
        name = self.display_name(self.folder)
        self.set_title(name); self.hb.set_title(name)
        self.fill_pathbar(); self.mark_sidebar()
        self.status.set_text(tr("Loading…", "Caricamento…"))
        self.loaded, self.pending_thumbs = 0, []
        self.load_started = time.monotonic()
        self.trash_bar.set_visible(self.in_trash())
        # changes made by others (or by our own jobs) show up by themselves
        if self.monitor:
            self.monitor.cancel()
        try:
            self.monitor = self.folder.monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
            self.monitor.connect("changed", self.on_folder_changed)
        except GLib.Error:
            self.monitor = None
        self.folder.enumerate_children_async(ATTRS, Gio.FileQueryInfoFlags.NONE, GLib.PRIORITY_DEFAULT, None,
                                             self.on_enum, (token, self.folder, None))

    def on_enum(self, src, res, data):
        token, folder, parent = data
        try:
            en = src.enumerate_children_finish(res)
        except GLib.Error as e:
            if token == self.load_token and parent is None:
                if not getattr(self, "mount_tried", None) == folder.get_uri() and self.try_mount(folder, e):
                    return
                self.show_empty(tr("This folder cannot be opened: ", "Questa cartella non si può aprire: ") + e.message)
            return
        en.next_files_async(BATCH, GLib.PRIORITY_DEFAULT, None, self.on_batch, (token, folder, parent, en))

    def on_batch(self, en, res, data):
        token, folder, parent, _ = data
        if token != self.load_token:
            en.close_async(GLib.PRIORITY_LOW, None, None)
            return
        try:
            infos = en.next_files_finish(res)
        except GLib.Error:
            infos = []
        for info in infos:
            self.add_entry(folder, info, parent)
        if parent is None and infos:
            self.status.set_text(tr("Loading… ", "Caricamento… ") + str(self.loaded))
        if infos:
            en.next_files_async(BATCH, GLib.PRIORITY_DEFAULT, None, self.on_batch, data)
            return
        en.close_async(GLib.PRIORITY_LOW, None, None)
        if parent is None:
            self.attach_models()
            self.finished_loading()
        else:
            self.remove_placeholder(parent)
        self.thumbs.queue(self.pending_thumbs); self.pending_thumbs = []

    def row_values(self, folder, info):
        name = info.get_display_name()
        ftype = info.get_file_type()
        target = info.get_attribute_string("standard::target-uri")
        child = Gio.File.new_for_uri(target) if target else folder.get_child(info.get_name())
        is_dir = ftype in (Gio.FileType.DIRECTORY, Gio.FileType.MOUNTABLE) or (
            ftype == Gio.FileType.SYMBOLIC_LINK and child.query_file_type(Gio.FileQueryInfoFlags.NONE, None) == Gio.FileType.DIRECTORY)
        ctype = info.get_content_type() or ""
        size = 0 if is_dir else info.get_size()
        dt = info.get_modification_date_time()
        mtime = dt.to_unix() if dt else 0
        kind = tr("Folder", "Cartella") if is_dir else self.describe(ctype)
        big = self.icon_for(info, 64, child, ctype)
        small = self.icon_for(info, 16, child, ctype, thumb=False)
        hidden = info.get_is_hidden() or info.get_is_backup()
        return [name, big, child, is_dir, size, mtime, kind, ("0" if is_dir else "1") + name.lower(),
                "—" if is_dir else human_size(size), nice_date(mtime), small, child.get_uri()], hidden, ctype

    def describe(self, ctype):
        cache = self.__dict__.setdefault("kind_cache", {})
        if ctype not in cache:
            cache[ctype] = Gio.content_type_get_description(ctype) if ctype else ""
        return cache[ctype]

    def add_entry(self, folder, info, parent):
        vals, hidden, ctype = self.row_values(folder, info)
        if parent is None:
            if hidden:                       # before appending: the filter decides on insert
                self.hidden_rows.add(vals[C_URI])
            it = self.store.append(vals)
            if not (hidden and not self.cfg["hidden"]):
                tit = self.tree.append(None, vals)
                if vals[C_ISDIR]:
                    self.tree.append(tit, [""] + [None, None, False, 0, 0, "", "", "", "", None, ""])  # placeholder: shows the triangle
                self.rows_by_uri.setdefault(vals[C_URI], []).append(("tree", Gtk.TreeRowReference.new(self.tree, self.tree.get_path(tit))))
            self.rows_by_uri.setdefault(vals[C_URI], []).append(("store", Gtk.TreeRowReference.new(self.store, self.store.get_path(it))))
            self.loaded += 1
        else:
            if hidden and not self.cfg["hidden"]:
                return
            tit = self.tree.append(parent, vals)
            if vals[C_ISDIR]:
                self.tree.append(tit, [""] + [None, None, False, 0, 0, "", "", "", "", None, ""])
            self.rows_by_uri.setdefault(vals[C_URI], []).append(("tree", Gtk.TreeRowReference.new(self.tree, self.tree.get_path(tit))))
        if not info.get_attribute_byte_string("thumbnail::path") and not info.get_attribute_boolean("thumbnail::failed") \
                and ctype.startswith(THUMB_TYPES) and vals[C_FILE].get_uri_scheme() == "file":
            self.pending_thumbs.append((vals[C_URI], ctype))

    def finished_loading(self):
        if os.environ.get("MANGOS_FINDER_DEBUG"):
            print(f"loaded {self.loaded} items in {time.monotonic() - self.load_started:.2f} s", flush=True)
        n = sum(1 for r in self.store if self.visible(self.store, r.iter, None))
        if n == 0 and not self.search.get_text():
            self.show_empty(tr("This folder is empty", "Questa cartella è vuota"))
        else:
            self.stack.set_visible_child_name(self.cfg["view"])
            self.refresh_special_view()
            if not self.search.has_focus():       # arrows move among the files, like the Mac
                GLib.idle_add(lambda: self.grab_view() or False)
            if self.reselect:
                self.select_uris(self.reselect); self.reselect = set()
        self.update_status()

    def refresh_special_view(self):
        if self.cfg["view"] == "columns":
            self.columns.show(self.folder)
        elif self.cfg["view"] == "gallery":
            self.gallery.refresh()

    def show_empty(self, text):
        self.empty.set_text(text)
        self.stack.set_visible_child_name("empty")
        self.update_status()

    def update_status(self):
        n = sum(1 for r in self.store if self.visible(self.store, r.iter, None))
        free = ""
        try:
            fi = self.folder.query_filesystem_info("filesystem::free", None)
            if fi.has_attribute("filesystem::free"):
                free = tr(", ", ", ") + human_size(fi.get_attribute_uint64("filesystem::free")) + tr(" available", " disponibili")
        except GLib.Error:
            pass
        items = tr(f"{n} item" + ("s" if n != 1 else ""), f"{n} element" + ("i" if n != 1 else "o"))
        self.status.set_text(items + free)

    # list view: expand folders in place
    def on_expand(self, view, it, path):
        cit = self.tree_sorted.convert_iter_to_child_iter(it)
        first = self.tree.iter_children(cit)
        if first is not None and self.tree[first][C_FILE] is None:      # still the placeholder
            folder = self.tree[cit][C_FILE]
            folder.enumerate_children_async(ATTRS, Gio.FileQueryInfoFlags.NONE, GLib.PRIORITY_DEFAULT, None,
                                            self.on_enum, (self.load_token, folder,
                                                           self.tree.get_iter(self.tree.get_path(cit))))
        return False

    def remove_placeholder(self, parent):
        try:
            it = self.tree.iter_children(parent)
        except (TypeError, ValueError):
            return
        while it is not None:
            if self.tree[it][C_FILE] is None:
                self.tree.remove(it)
                return
            it = self.tree.iter_next(it)

    # ---------------------------------------------------------- icons and thumbnails
    def icon_for(self, info, size, child, ctype, thumb=True):
        tp = info.get_attribute_byte_string("thumbnail::path") if thumb else None
        if tp:
            pb = self.load_thumb(tp, size)
            if pb:
                return pb
        gicon = info.get_icon()
        key = (gicon.to_string() if gicon else "", size)
        if key in self.icon_cache:
            return self.icon_cache[key]
        pb = None
        if gicon:
            ii = self.icon_theme.lookup_by_gicon(gicon, size, Gtk.IconLookupFlags.FORCE_SIZE)
            if ii:
                try:
                    pb = ii.load_icon()
                except GLib.Error:
                    pb = None
        if pb is None:
            pb = self.icon_theme.load_icon("text-x-generic", size, Gtk.IconLookupFlags.FORCE_SIZE)
        self.icon_cache[key] = pb
        return pb

    def load_thumb(self, path, size):
        try:
            return GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size, size, True)
        except GLib.Error:
            return None

    def on_thumbs_ready(self, uris):
        for uri in uris:
            f = Gio.File.new_for_uri(uri)
            try:
                info = f.query_info("thumbnail::path", Gio.FileQueryInfoFlags.NONE, None)
            except GLib.Error:
                continue
            tp = info.get_attribute_byte_string("thumbnail::path")
            pb = self.load_thumb(tp, 64) if tp else None
            if not pb:
                continue
            for kind, ref in self.rows_by_uri.get(uri, []):
                if kind == "store" and ref.valid():
                    self.store.set_value(self.store.get_iter(ref.get_path()), C_ICON, pb)

    # ---------------------------------------------------------- sorting, filtering, views
    def compare(self, model, a, b, _data=None):
        ra, rb = model[a], model[b]
        if ra[C_FILE] is None or rb[C_FILE] is None:
            return 0
        return self.cmp_rows(ra, rb)

    def cmp_rows(self, ra, rb):
        if ra[C_ISDIR] != rb[C_ISDIR]:                 # folders first, whatever the order
            return -1 if ra[C_ISDIR] else 1
        k = self.cfg["sort"]
        if k == "date":
            x, y = ra[C_MTIME], rb[C_MTIME]
        elif k == "size":
            x, y = ra[C_SIZE], rb[C_SIZE]
        elif k == "kind":
            x, y = (ra[C_KIND] or "").lower(), (rb[C_KIND] or "").lower()
        else:
            x, y = GLib.utf8_collate_key_for_filename(ra[C_NAME], -1), GLib.utf8_collate_key_for_filename(rb[C_NAME], -1)
        if x == y and k != "name":
            x, y = GLib.utf8_collate_key_for_filename(ra[C_NAME], -1), GLib.utf8_collate_key_for_filename(rb[C_NAME], -1)
        r = (x > y) - (x < y)
        return -r if self.cfg["desc"] else r

    def resort(self):
        for m in (self.sorted, self.tree_sorted):
            m.set_default_sort_func(self.compare)
            m.set_sort_column_id(Gtk.TREE_SORTABLE_DEFAULT_SORT_COLUMN_ID, Gtk.SortType.ASCENDING)
        save_cfg(self.cfg)
        if self.folder is not None and self.cfg["view"] == "columns":
            self.columns.resort()

    def header_sort(self, key):
        if self.cfg["sort"] == key:
            self.cfg["desc"] = not self.cfg["desc"]
        else:
            self.cfg["sort"], self.cfg["desc"] = key, key in ("date", "size")
        self.sync_sort_menu(); self.resort()

    def sort_popover(self, relative):
        pop = Gtk.Popover(relative_to=relative)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin=8, spacing=2)
        lab = Gtk.Label(label=tr("Sort By", "Ordina per"), xalign=0); lab.set_opacity(0.6)
        box.pack_start(lab, False, False, 2)
        self.sort_radios = {}
        group = None
        for key, label in (("name", tr("Name", "Nome")), ("date", tr("Date Modified", "Data di modifica")),
                           ("size", tr("Size", "Dimensione")), ("kind", tr("Kind", "Tipo"))):
            r = Gtk.RadioButton.new_with_label_from_widget(group, label); group = group or r
            r.connect("toggled", lambda w, k=key: w.get_active() and self.set_sort(k))
            box.pack_start(r, False, False, 0); self.sort_radios[key] = r
        box.pack_start(Gtk.Separator(margin_top=4, margin_bottom=4), False, False, 0)
        self.desc_check = Gtk.CheckButton(label=tr("Descending", "Decrescente"))
        self.desc_check.connect("toggled", lambda w: self.set_desc(w.get_active()))
        box.pack_start(self.desc_check, False, False, 0)
        self.hidden_check = Gtk.CheckButton(label=tr("Show Hidden Files", "Mostra file nascosti"))
        self.hidden_check.connect("toggled", lambda w: self.set_hidden(w.get_active()))
        box.pack_start(self.hidden_check, False, False, 0)
        box.show_all(); pop.add(box)
        self.updating_menu = True
        self.sync_sort_menu()
        self.updating_menu = False
        return pop

    def sync_sort_menu(self):
        self.updating_menu = True
        self.sort_radios[self.cfg["sort"]].set_active(True)
        self.desc_check.set_active(self.cfg["desc"])
        self.hidden_check.set_active(self.cfg["hidden"])
        self.updating_menu = False

    def set_sort(self, key):
        if getattr(self, "updating_menu", False):
            return
        self.cfg["sort"] = key; self.resort()

    def set_desc(self, on):
        if getattr(self, "updating_menu", False):
            return
        self.cfg["desc"] = on; self.resort()

    def set_hidden(self, on):
        if getattr(self, "updating_menu", False) or on == self.cfg["hidden"]:
            return
        self.cfg["hidden"] = on; save_cfg(self.cfg)
        self.load()

    def visible(self, model, it, _data):
        uri = model[it][C_URI]
        if not self.cfg["hidden"] and uri in getattr(self, "hidden_rows", set()):
            return False
        q = self.search.get_text().strip().lower() if hasattr(self, "search") else ""
        return not q or q in (model[it][C_NAME] or "").lower()

    def refilter(self):
        # a new filter instead of refilter(): refiltering under a sort model
        # trips a GTK reference-count bug (criticals, sometimes wrong rows)
        self.iconview.set_model(None)
        self.filter = self.store.filter_new(); self.filter.set_visible_func(self.visible)
        self.sorted = Gtk.TreeModelSort(model=self.filter)
        self.sorted.set_default_sort_func(self.compare)
        self.sorted.set_sort_column_id(Gtk.TREE_SORTABLE_DEFAULT_SORT_COLUMN_ID, Gtk.SortType.ASCENDING)
        self.iconview.set_model(self.sorted)
        q = self.search.get_text().strip().lower()
        # the list view shows the same matches (top level); rebuilt unattached
        self.listview.set_model(None)
        self.tree = Gtk.TreeStore(*self.COLS)
        for r in self.store:
            if self.visible(self.store, r.iter, None):
                vals = [r[i] for i in range(12)]
                tit = self.tree.append(None, vals)
                if vals[C_ISDIR]:
                    self.tree.append(tit, [""] + [None, None, False, 0, 0, "", "", "", "", None, ""])
        self.tree_sorted = Gtk.TreeModelSort(model=self.tree)
        self.tree_sorted.set_default_sort_func(self.compare)
        self.tree_sorted.set_sort_column_id(Gtk.TREE_SORTABLE_DEFAULT_SORT_COLUMN_ID, Gtk.SortType.ASCENDING)
        self.listview.set_model(self.tree_sorted)
        if self.stack.get_visible_child_name() == "empty" and q:
            self.stack.set_visible_child_name(self.cfg["view"])
        self.refresh_special_view()
        self.update_status()

    def set_view(self, key):
        self.cfg["view"] = key; save_cfg(self.cfg)
        if self.stack.get_visible_child_name() != "empty":
            self.stack.set_visible_child_name(key)
        if self.view_btns[key].get_active() is False:
            self.view_btns[key].set_active(True)
        self.resort()
        if self.folder is not None and self.stack.get_visible_child_name() != "empty":
            self.refresh_special_view()

    # ---------------------------------------------------------- path bar, selection, menus
    def fill_pathbar(self):
        for c in self.pathbar.get_children():
            c.destroy()
        if self.folder.get_uri_scheme() == "trash":
            b = Gtk.Button(label=tr("Trash", "Cestino"), relief=Gtk.ReliefStyle.NONE)
            self.pathbar.pack_start(b, False, False, 0); self.pathbar.show_all()
            return
        chain, f = [], self.folder
        while f is not None:
            chain.insert(0, f)
            f = f.get_parent()
        for i, f in enumerate(chain[-6:]):
            if i:
                sep = Gtk.Label(label="›"); sep.set_opacity(0.5); self.pathbar.pack_start(sep, False, False, 0)
            b = Gtk.Button(label=tr("Computer", "Computer") if f.get_uri() == "file:///" else self.display_name(f),
                           relief=Gtk.ReliefStyle.NONE)
            b.connect("clicked", lambda _b, x=f: self.open_location(x))
            self.pathbar.pack_start(b, False, False, 0)
        self.pathbar.show_all()

    def selected(self):
        """[(Gio.File, is_dir)] of the selection in the current view."""
        out = []
        if self.cfg["view"] == "columns":
            return self.columns.selected()
        if self.cfg["view"] == "gallery":
            return self.gallery.selected()
        if self.cfg["view"] == "icons":
            for p in self.iconview.get_selected_items():
                out.append((self.sorted[p][C_FILE], self.sorted[p][C_ISDIR]))
        else:
            model, paths = self.listview.get_selection().get_selected_rows()
            for p in paths:
                if model[p][C_FILE] is not None:
                    out.append((model[p][C_FILE], model[p][C_ISDIR]))
        return out

    def on_row_activated(self, view, path, col):
        r = self.tree_sorted[path]
        if r[C_FILE] is not None:
            self.activate(r[C_FILE], r[C_ISDIR])

    def on_button(self, w, ev):
        if ev.button != 3:
            return False
        if isinstance(w, Gtk.IconView):
            p = w.get_path_at_pos(int(ev.x), int(ev.y))
            if p is not None and not w.path_is_selected(p):
                w.unselect_all(); w.select_path(p)
        else:
            hit = w.get_path_at_pos(int(ev.x), int(ev.y))
            if hit and not w.get_selection().path_is_selected(hit[0]):
                w.get_selection().unselect_all(); w.get_selection().select_path(hit[0])
        self.context_menu(ev)
        return True

    def context_menu(self, ev):
        sel = self.selected()
        m = Gtk.Menu()

        def item(label, cb, sensitive=True, accel=None, submenu=None):
            it = Gtk.MenuItem(label=label); it.set_sensitive(sensitive)
            if submenu is not None:
                it.set_submenu(submenu)
            else:
                it.connect("activate", lambda *_: cb())
            if accel:
                key, mods = Gtk.accelerator_parse(accel)
                it.get_child().set_accel(key, mods)
            m.append(it)

        def sep():
            if m.get_children() and not isinstance(m.get_children()[-1], Gtk.SeparatorMenuItem):
                m.append(Gtk.SeparatorMenuItem())
        trash = self.in_trash()
        files = [f for f, _ in sel]
        if sel:
            item(tr("Open", "Apri"), lambda: [self.activate(f, d) for f, d in sel[:10]])
            if not trash and any(not d for _, d in sel):
                item(tr("Open With", "Apri con"), None, submenu=self.open_with_menu([f for f, d in sel if not d] or files))
            if not trash and len(sel) == 1 and sel[0][1]:
                item(tr("Open in Terminal", "Apri nel Terminale"), lambda: self.open_terminal(files[0]))
            sep()
            if trash:
                item(tr("Put Back", "Rimetti"), self.act_restore)
                item(tr("Delete Immediately…", "Elimina definitivamente…"), self.act_delete_now)
            else:
                item(tr("Move to Trash", "Sposta nel Cestino"), self.act_trash, True, "Delete")
            sep()
            item(tr("Get Info", "Informazioni"), self.get_info, True, "<Control>i")
            if not trash:
                item(tr("Rename…", "Rinomina…"), self.rename_dialog, len(sel) == 1, "F2")
                n = len(sel)
                item(tr(f"Compress “{files[0].get_basename()}”" if n == 1 else f"Compress {n} Items",
                        f"Comprimi “{files[0].get_basename()}”" if n == 1 else f"Comprimi {n} elementi"), self.act_compress)
                if any(self.is_archive(f) for f in files):
                    item(tr("Extract Here", "Estrai qui"), self.act_extract)
                item(tr("Duplicate", "Duplica"), self.act_duplicate, True, "<Control>d")
                item(tr("Make Alias", "Crea alias"), self.act_alias, True, "<Control>l")
                if len(sel) == 1 and files[0].query_file_type(Gio.FileQueryInfoFlags.NOFOLLOW_SYMLINKS, None) == Gio.FileType.SYMBOLIC_LINK:
                    item(tr("Show Original", "Mostra originale"), self.show_original, True, "<Control>r")
                item(tr("Quick Look", "Anteprima rapida"), self.quicklook, any(not d for _, d in sel), "space")
                sep()
                item(tr("Copy", "Copia"), lambda: self.clip_set("copy"), True, "<Control>c")
                item(tr("Cut", "Taglia"), lambda: self.clip_set("cut"), True, "<Control>x")
        if not trash:
            item(tr("Paste", "Incolla"), self.paste, True, "<Control>v")
            if not sel:
                sep()
                item(tr("New Folder", "Nuova cartella"), self.act_new_folder, True, "<Control><Shift>n")
                item(tr("New Document", "Nuovo documento"), None, submenu=self.new_document_menu())
                sep()
                item(tr("Get Info", "Informazioni"), lambda: self.get_info([self.folder]), True, "<Control>i")
                item(tr("Open in Terminal", "Apri nel Terminale"), self.open_terminal)
        else:
            sep()
            item(tr("Empty Trash…", "Svuota il Cestino…"), self.empty_trash, True, "<Control><Shift>Delete")
        sep()
        if sel:
            item(tr("Copy Path", "Copia percorso"), self.copy_path, True, "<Control><Shift>c")
        item(tr("Show Hidden Files", "Mostra file nascosti") if not self.cfg["hidden"] else tr("Hide Hidden Files", "Nascondi file nascosti"),
             lambda: self.hidden_check.set_active(not self.cfg["hidden"]), True, "<Control><Shift>period")
        try:
            mnt = self.folder.find_enclosing_mount(None)
        except GLib.Error:
            mnt = None
        if mnt and (mnt.can_eject() or mnt.can_unmount()) and not trash:
            item(tr(f"Eject “{mnt.get_name()}”", f"Espelli “{mnt.get_name()}”"), lambda: self.eject(mnt), True, "<Control>e")
        if self.get_application().undo_stack:
            sep()
            item(tr("Undo ", "Annulla ") + self.get_application().undo_stack[-1][0], self.act_undo, True, "<Control>z")
        if isinstance(m.get_children()[-1], Gtk.SeparatorMenuItem):
            m.get_children()[-1].destroy()
        m.show_all(); m.popup_at_pointer(ev)

    def quicklook(self):
        files = [f.get_path() for f, d in self.selected() if not d and f.get_path()]
        if files:
            subprocess.Popen(["mangos-quicklook"] + files[:20])

    def copy_path(self):
        paths = [f.get_path() or f.get_uri() for f, _ in self.selected()]
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text("\n".join(paths), -1)

    # ---------------------------------------------------------- keyboard (Cmd is Ctrl on MangOS)
    def on_key(self, w, ev):
        k = Gdk.keyval_name(ev.keyval) or ""
        ctrl = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)
        shift = bool(ev.state & Gdk.ModifierType.SHIFT_MASK)
        if self.search.has_focus() and (not ctrl or k.lower() in ("c", "x", "v", "a", "z")):
            if k == "Escape":
                self.search.set_text(""); self.grab_view()
                return True
            return False
        if ctrl and k in ("1", "2", "3", "4"):
            self.view_btns[("icons", "list", "columns", "gallery")[int(k) - 1]].set_active(True); return True
        # file operations (Cmd is Ctrl on MangOS)
        if ctrl and not shift and k.lower() == "c":
            self.clip_set("copy"); return True
        if ctrl and k.lower() == "x":
            self.clip_set("cut"); return True
        if ctrl and k.lower() == "v":
            self.paste(move=bool(ev.state & Gdk.ModifierType.MOD1_MASK)); return True
        if ctrl and k.lower() == "z":
            self.act_undo(); return True
        if ctrl and k.lower() == "a":
            self.select_all(); return True
        if ctrl and not shift and k.lower() == "d":
            self.act_duplicate(); return True
        if ctrl and shift and k.lower() == "n":
            self.act_new_folder(); return True
        if (ctrl and k == "BackSpace") or (not ctrl and k == "Delete"):
            self.act_trash(); return True
        if ctrl and shift and k == "Delete":
            self.empty_trash(); return True
        if k == "F2":
            self.rename_dialog(); return True
        if ctrl and not shift and k.lower() == "i":
            self.get_info(); return True
        if ctrl and not shift and k.lower() == "k":
            self.connect_dialog(); return True
        if ctrl and shift and k.lower() == "k":
            self.open_location("network:///"); return True
        if ctrl and not shift and k.lower() == "e":
            self.eject_selected(); return True
        if ctrl and not shift and k.lower() == "l":
            self.act_alias(); return True
        if ctrl and not shift and k.lower() == "r":
            self.show_original(); return True
        if ctrl and not shift and k.lower() == "n":
            self.get_application().new_window(self.folder); return True
        if ctrl and shift and k.lower() == "h":
            self.open_location(GLib.get_home_dir()); return True
        if ctrl and shift and k.lower() == "d":
            self.open_location(GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DESKTOP) or GLib.get_home_dir()); return True
        if ctrl and shift and k.lower() == "o":
            self.open_location(GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS) or GLib.get_home_dir()); return True
        if ctrl and k == "comma":
            self.get_application().activate_action("preferences", None); return True
        if ctrl and k in ("bracketleft",):
            self.go_back(); return True
        if ctrl and k in ("bracketright",):
            self.go_forward(); return True
        if ctrl and k == "Up":
            self.go_up(); return True
        if (ctrl and k == "Down") or (not ctrl and k in ("Return", "KP_Enter")):
            for f, d in self.selected()[:10]:
                self.activate(f, d)
            return True
        if ctrl and shift and k in ("period", "greater"):
            self.hidden_check.set_active(not self.cfg["hidden"]); return True
        if ctrl and k.lower() == "f":
            self.search.grab_focus(); return True
        if ctrl and shift and k.lower() == "c":
            self.copy_path(); return True
        if not ctrl and k == "space":
            self.quicklook(); return True
        if ctrl and k.lower() in ("w", "q"):
            self.close(); return True
        if k == "BackSpace" and not ctrl:
            self.go_up(); return True
        return False

    def grab_view(self):
        {"icons": self.iconview, "list": self.listview, "columns": self.columns,
         "gallery": self.gallery}[self.cfg["view"]].grab_focus()

    # ---------------------------------------------------------- file operations (stage 3)
    def in_trash(self):
        return bool(self.folder) and self.folder.get_uri_scheme() == "trash"

    def on_folder_changed(self, mon, f, other, event):
        if getattr(self, "change_id", None):
            GLib.source_remove(self.change_id)
        self.change_id = GLib.timeout_add(350, self.reload_keep)

    def reload_keep(self):
        """Reload the folder, keeping the selection (and selecting what a job made)."""
        self.change_id = None
        if self.cfg["view"] == "columns" and len(self.columns.cols) > 1:
            # browsing deeper in the column view: refresh the deepest folder shown, where things happen
            self.columns.refresh_last(self.reselect)
            self.reselect = set()
            return False
        self.reselect |= {f.get_uri() for f, _ in self.selected()}
        self.load()
        return False

    def select_uris(self, uris):
        if self.cfg["view"] in ("icons", "gallery"):
            view = self.iconview if self.cfg["view"] == "icons" else self.gallery.strip
            view.unselect_all()
            first = None
            for r in self.sorted:
                if r[C_URI] in uris:
                    view.select_path(r.path); first = first or r.path
            if first is not None:
                view.scroll_to_path(first, False, 0, 0)
                if self.cfg["view"] == "icons":
                    self.iconview.set_cursor(first, None, False)
        elif self.cfg["view"] == "list":
            sel = self.listview.get_selection(); sel.unselect_all()
            for r in self.tree_sorted:
                if r[C_URI] in uris:
                    sel.select_path(r.path); self.listview.scroll_to_cell(r.path, None, False, 0, 0)

    def select_all(self):
        if self.cfg["view"] == "icons":
            self.iconview.select_all()
        elif self.cfg["view"] == "list":
            self.listview.get_selection().select_all()

    # clipboard: shared by all Mango Finder windows; Thunar's clipboard is read too
    def clip_set(self, mode):
        files = [f for f, _ in self.selected()]
        if not files:
            return
        app = self.get_application()
        app.clip = (mode, files)
        text = "\n".join(f.get_path() or f.get_uri() for f in files)
        if not set_file_clipboard(mode, [f.get_uri() for f in files], text):
            Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(text, -1)
        app.clip_text = text
        n = len(files)
        one = n == 1
        self.status.set_text((tr(f"{n} item{'' if one else 's'} copied", "1 elemento copiato" if one else f"{n} elementi copiati")
                              if mode == "copy" else
                              tr(f"{n} item{'' if one else 's'} cut: paste to move",
                                 "1 elemento tagliato: incolla per spostarlo" if one else f"{n} elementi tagliati: incolla per spostarli")))

    def paste(self, move=False):
        app = self.get_application()
        cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        # ours, unless something else was copied since (then the system clipboard wins)
        own = app.clip if app.clip and cb.wait_for_text() == getattr(app, "clip_text", None) else None
        files, mode = [], "copy"
        target = Gdk.Atom.intern("x-special/gnome-copied-files", False)
        data = cb.wait_for_contents(target)            # copied in Thunar (or GNOME Files)
        if data and data.get_data() and not own:
            lines = data.get_data().decode("utf-8", "replace").splitlines()
            if lines and lines[0] in ("copy", "cut"):
                mode = lines[0]
                files = [Gio.File.new_for_uri(u) for u in lines[1:] if u.strip()]
        elif own:
            mode, files = own
        else:
            uris = cb.wait_for_uris() or []
            files = [Gio.File.new_for_uri(u) for u in uris]
        if not files:
            return
        dest = self.drop_folder()
        kind = "move" if (move or mode == "cut") else "copy"
        self.run_job(kind, files, dest)
        if mode == "cut" and own:
            app.clip = None

    def drop_folder(self):
        """Where pasted items go: the current folder (or, in the column view, the deepest one shown)."""
        if self.cfg["view"] == "columns" and self.columns.cols:
            return self.columns.cols[-1][0]
        return self.folder

    def after_job(self, job, errs):
        if job.kind in ("new_folder", "new_file") and job.created and not errs:
            GLib.timeout_add(450, self.rename_dialog, job.created[0])

    # the actions
    def act_trash(self):
        files = [f for f, _ in self.selected()]
        if not files:
            return
        if self.in_trash():
            self.act_delete_now(); return
        self.run_job("trash", files)

    def act_delete_now(self):
        files = [f for f, _ in self.selected()]
        if files and self.yes_no(tr("Delete immediately?", "Eliminare definitivamente?"),
                                 tr("These items will be deleted. You cannot undo this.",
                                    "Questi elementi verranno eliminati. Non si potrà annullare."),
                                 tr("Delete", "Elimina")):
            self.run_job("delete", files)

    def empty_trash(self):
        if self.yes_no(tr("Empty the Trash?", "Vuoi svuotare il Cestino?"),
                       tr("Everything in the Trash will be deleted. You cannot undo this.",
                          "Tutti gli elementi nel Cestino verranno eliminati. Non si potrà annullare."),
                       tr("Empty Trash", "Svuota il Cestino")):
            self.run_job("empty_trash", [])

    def act_restore(self):
        files = [f for f, _ in self.selected()]
        if files:
            self.run_job("restore", files)

    def act_new_folder(self):
        if not self.in_trash():
            self.run_job("new_folder", [], self.drop_folder())

    def act_duplicate(self):
        files = [f for f, _ in self.selected()]
        if files and not self.in_trash():
            self.run_job("duplicate", files)

    def act_undo(self):
        stack = self.get_application().undo_stack
        if not stack:
            self.status.set_text(tr("Nothing to undo", "Niente da annullare"))
            return
        label, records = stack.pop()

        def work():
            errs = fileops.undo(records)
            GLib.idle_add(done, errs)

        def done(errs):
            if errs:
                self.message(tr("Undo was not complete:\n", "Annullamento non completo:\n") + "\n".join(errs[:5]))
            else:
                self.status.set_text(tr("Undone: ", "Annullato: ") + label)
            self.reload_keep()
            return False
        threading.Thread(target=work, daemon=True).start()

    # drag and drop: between Mango Finder windows, Thunar, the desktop, other apps
    def setup_dnd(self):
        targets = [Gtk.TargetEntry.new("text/uri-list", 0, 0)]
        actions = Gdk.DragAction.COPY | Gdk.DragAction.MOVE
        for v in (self.iconview, self.gallery.strip):
            v.enable_model_drag_source(Gdk.ModifierType.BUTTON1_MASK, targets, actions)
            v.connect("drag-data-get", self.on_drag_get)
        self.iconview.enable_model_drag_dest(targets, actions)
        self.iconview.connect("drag-data-received", self.on_drop_icons)
        self.listview.enable_model_drag_source(Gdk.ModifierType.BUTTON1_MASK, targets, actions)
        self.listview.enable_model_drag_dest(targets, actions)
        self.listview.connect("drag-data-get", self.on_drag_get)
        self.listview.connect("drag-data-received", self.on_drop_list)
        self.dnd_targets, self.dnd_actions = targets, actions
        self.fill_sidebar()                       # again, now that sidebar rows can take drops

    def dnd_column(self, tv):
        tv.enable_model_drag_source(Gdk.ModifierType.BUTTON1_MASK, self.dnd_targets, self.dnd_actions)
        tv.enable_model_drag_dest(self.dnd_targets, self.dnd_actions)
        tv.connect("drag-data-get", self.on_drag_get)
        tv.connect("drag-data-received", self.on_drop_column)

    def dnd_sidebar_row(self, row):
        row.drag_dest_set(Gtk.DestDefaults.ALL, self.dnd_targets, self.dnd_actions)
        row.connect("drag-data-received", lambda w, ctx, x, y, data, info, t: self.drop_files(
            ctx, data, t, "trash" if w.target == "trash:///" else
            (Gio.File.new_for_uri(w.target) if isinstance(w.target, str) else None)))

    def on_drag_get(self, w, ctx, data, info, t):
        data.set_uris([f.get_uri() for f, _ in self.selected()])

    def on_drop_icons(self, w, ctx, x, y, data, info, t):
        dest = self.folder
        hit = w.get_dest_item_at_pos(x, y)
        if hit:
            path, pos = hit
            r = w.get_model()[path]
            if r[C_ISDIR] and pos in (Gtk.IconViewDropPosition.DROP_INTO, Gtk.IconViewDropPosition.DROP_ABOVE,
                                      Gtk.IconViewDropPosition.DROP_BELOW, Gtk.IconViewDropPosition.DROP_LEFT,
                                      Gtk.IconViewDropPosition.DROP_RIGHT):
                dest = r[C_FILE]
        GObject.signal_stop_emission_by_name(w, "drag-data-received")
        self.drop_files(ctx, data, t, dest)

    def on_drop_list(self, w, ctx, x, y, data, info, t):
        dest = self.folder
        hit = w.get_dest_row_at_pos(x, y)
        if hit:
            path, pos = hit
            r = w.get_model()[path]
            if r[C_FILE] is not None and r[C_ISDIR] and pos in (Gtk.TreeViewDropPosition.INTO_OR_BEFORE,
                                                                Gtk.TreeViewDropPosition.INTO_OR_AFTER):
                dest = r[C_FILE]
        GObject.signal_stop_emission_by_name(w, "drag-data-received")
        self.drop_files(ctx, data, t, dest)

    def on_drop_column(self, w, ctx, x, y, data, info, t):
        folder = next((c[0] for c in self.columns.cols if c[1] is w), self.folder)
        dest = folder
        hit = w.get_dest_row_at_pos(x, y)
        if hit:
            r = w.get_model()[hit[0]]
            if r[2] is not None and r[3]:
                dest = r[2]
        GObject.signal_stop_emission_by_name(w, "drag-data-received")
        self.drop_files(ctx, data, t, dest)

    def drop_files(self, ctx, data, t, dest):
        uris = data.get_uris() or []
        files = [Gio.File.new_for_uri(u) for u in uris]
        if not files or dest is None:
            Gtk.drag_finish(ctx, False, False, t); return
        if dest == "trash":
            Gtk.drag_finish(ctx, True, False, t)
            self.run_job("trash", files); return
        files = [f for f in files if not f.equal(dest) and not (f.get_parent() and f.get_parent().equal(dest))]
        if not files:
            Gtk.drag_finish(ctx, False, False, t); return
        # like the Mac: same disk -> move, another disk -> copy; Ctrl (Option) forces a copy
        state = Gdk.Keymap.get_for_display(Gdk.Display.get_default()).get_modifier_state()
        if state & Gdk.ModifierType.CONTROL_MASK:
            kind = "copy"
        else:
            kind = "move" if all(fileops.same_fs(f, dest) for f in files) else "copy"
        Gtk.drag_finish(ctx, True, False, t)
        self.run_job(kind, files, dest)

    # ---------------------------------------------------------- one folder as a sorted list (Columns view)
    def list_folder(self, folder, cb, apply_search=False):
        """Reads a folder in the background; cb(rows) with value lists, sorted, hidden files filtered."""
        rows = []
        q = self.search.get_text().strip().lower() if apply_search else ""

        def batch(en, res):
            try:
                infos = en.next_files_finish(res)
            except GLib.Error:
                infos = []
            for info in infos:
                vals, hidden, ctype = self.row_values(folder, info)
                if hidden and not self.cfg["hidden"]:
                    continue
                if q and q not in vals[C_NAME].lower():
                    continue
                vals.append(ctype)
                rows.append(vals)
            if infos:
                en.next_files_async(BATCH, GLib.PRIORITY_DEFAULT, None, batch)
                return
            en.close_async(GLib.PRIORITY_LOW, None, None)
            rows.sort(key=functools.cmp_to_key(self.cmp_rows))
            cb(rows)

        def opened(src, res):
            try:
                en = src.enumerate_children_finish(res)
            except GLib.Error as e:
                cb(None, e.message)
                return
            en.next_files_async(BATCH, GLib.PRIORITY_DEFAULT, None, batch)
        folder.enumerate_children_async(ATTRS, Gio.FileQueryInfoFlags.NONE, GLib.PRIORITY_DEFAULT, None, opened)

    # ---------------------------------------------------------- preview (Columns and Gallery)
    def preview_widget(self, f, is_dir, max_w, max_h, holder=None):
        """A large image of the file (the picture itself for photos, else its
        thumbnail or icon) and its name, kind, size and dates."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=14, valign=Gtk.Align.CENTER)
        img = Gtk.Image()
        box.pack_start(img, False, False, 0)
        try:
            info = f.query_info(ATTRS + ",time::created", Gio.FileQueryInfoFlags.NONE, None)
        except GLib.Error:
            info = None
        ctype = info.get_content_type() if info else ""
        side = min(max_w, max_h)
        if info:
            img.set_from_pixbuf(self.icon_for(info, min(256, max(64, side // 2)), f, ctype or ""))
        if ctype.startswith("image/") and f.get_uri_scheme() == "file":
            # the photo itself, read in the background so the window never waits
            def done(_src, res):
                try:
                    pb = GdkPixbuf.Pixbuf.new_from_stream_finish(res)
                except GLib.Error:
                    return
                img.set_from_pixbuf(pb)
            try:
                stream = f.read(None)
                GdkPixbuf.Pixbuf.new_from_stream_at_scale_async(stream, max_w, max_h, True, None, done)
            except GLib.Error:
                pass
        name = Gtk.Label(label=info.get_display_name() if info else f.get_basename(), wrap=True,
                         justify=Gtk.Justification.CENTER, max_width_chars=34)
        name.get_style_context().add_class("fd-prev-name")
        box.pack_start(name, False, False, 4)
        if info:
            kind = tr("Folder", "Cartella") if is_dir else self.describe(ctype or "")
            grid = Gtk.Grid(column_spacing=10, row_spacing=3, halign=Gtk.Align.CENTER)
            facts = [(tr("Kind", "Tipo"), kind)]
            if not is_dir:
                facts.append((tr("Size", "Dimensione"), human_size(info.get_size())))
            cdt = info.get_creation_date_time() if hasattr(info, "get_creation_date_time") else None
            if cdt:
                facts.append((tr("Created", "Creato"), nice_date(cdt.to_unix())))
            mdt = info.get_modification_date_time()
            if mdt:
                facts.append((tr("Modified", "Modificato"), nice_date(mdt.to_unix())))
            for i, (k, v) in enumerate(facts):
                a = Gtk.Label(label=k, xalign=1); a.get_style_context().add_class("fd-prev-key")
                b = Gtk.Label(label=v, xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=26)
                grid.attach(a, 0, i, 1, 1); grid.attach(b, 1, i, 1, 1)
            box.pack_start(grid, False, False, 0)
        box.show_all()
        return box

    # ---------------------------------------------------------- drives and network (stage 4)
    def eject(self, obj):
        """Eject (or unmount) a drive, a USB stick, a phone or a network share."""
        op = Gtk.MountOperation.new(self)
        name = obj.get_name()

        def done(o, res):
            try:
                (o.eject_with_operation_finish if eject else o.unmount_with_operation_finish)(res)
            except GLib.Error as e:
                if e.matches(Gio.io_error_quark(), Gio.IOErrorEnum.BUSY):
                    self.message(tr(f"“{name}” cannot be ejected because it is in use.",
                                    f"“{name}” non può essere espulso perché è in uso.") + "\n" +
                                 tr("Close the files and apps that use it, then try again.",
                                    "Chiudi i file e le app che lo usano, poi riprova."))
                elif not e.matches(Gio.io_error_quark(), Gio.IOErrorEnum.FAILED_HANDLED):
                    self.message(tr("Cannot eject: ", "Impossibile espellere: ") + e.message)
                return
            self.status.set_text(tr(f"“{name}” can now be removed", f"Ora puoi rimuovere “{name}”"))
        if isinstance(obj, Gio.Mount):
            root = obj.get_root()
            if self.folder and (self.folder.equal(root) or self.folder.has_prefix(root)):
                self.open_location(GLib.get_home_dir())      # do not keep the drive busy ourselves
            if self.monitor:
                self.monitor.cancel(); self.monitor = None
            eject = obj.can_eject()
        else:
            eject = True
        if eject:
            obj.eject_with_operation(Gio.MountUnmountFlags.NONE, op, None, done)
        else:
            obj.unmount_with_operation(Gio.MountUnmountFlags.NONE, op, None, done)

    def eject_selected(self):
        """Ctrl+E (Cmd+E): eject the drive shown, or the one selected."""
        for f in [f for f, _ in self.selected()] + [self.folder]:
            try:
                m = f.find_enclosing_mount(None)
            except GLib.Error:
                continue
            if m and (m.can_eject() or m.can_unmount()):
                self.eject(m); return

    def try_mount(self, folder, err):
        """A network place or a phone not connected yet: connect, then show it."""
        if not (err.matches(Gio.io_error_quark(), Gio.IOErrorEnum.NOT_MOUNTED) or
                err.matches(Gio.io_error_quark(), Gio.IOErrorEnum.NOT_DIRECTORY) or
                err.matches(Gio.io_error_quark(), Gio.IOErrorEnum.NOT_SUPPORTED)):
            return False
        self.mount_tried = folder.get_uri()
        self.status.set_text(tr("Connecting…", "Connessione…"))
        op = Gtk.MountOperation.new(self)
        try:
            mountable = folder.query_file_type(Gio.FileQueryInfoFlags.NONE, None) == Gio.FileType.MOUNTABLE
        except GLib.Error:
            mountable = False

        def done(f, res):
            try:
                target = f.mount_mountable_finish(res) if mountable else (f.mount_enclosing_volume_finish(res) or f)
            except GLib.Error as e:
                if e.matches(Gio.io_error_quark(), Gio.IOErrorEnum.ALREADY_MOUNTED):
                    target = f
                else:
                    msg = "" if e.matches(Gio.io_error_quark(), Gio.IOErrorEnum.FAILED_HANDLED) else e.message
                    self.show_empty(tr("Not connected", "Non connesso") + (": " + msg if msg else ""))
                    return
            if folder.equal(self.folder):
                if isinstance(target, Gio.File) and not target.equal(folder):
                    self.folder = target
                self.load()
        if mountable:
            folder.mount_mountable(Gio.MountMountFlags.NONE, op, None, done)
        else:
            folder.mount_enclosing_volume(Gio.MountMountFlags.NONE, op, None, done)
        return True

    def connect_dialog(self):
        """Go > Connect to Server (Ctrl+K), like the Mac's: smb://, sftp://, ftp://, dav://..."""
        d = Gtk.Dialog(title=tr("Connect to Server", "Connetti al server"), transient_for=self, modal=True)
        d.add_buttons(tr("Cancel", "Annulla"), Gtk.ResponseType.CANCEL, tr("Connect", "Connetti"), Gtk.ResponseType.OK)
        d.set_default_response(Gtk.ResponseType.OK)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=14)
        d.get_content_area().add(box)
        box.pack_start(Gtk.Label(label=tr("Server Address:", "Indirizzo server:"), xalign=0), False, False, 0)
        recent = self.cfg.get("servers", [])
        e = Gtk.Entry(activates_default=True, width_chars=40, placeholder_text="smb://nas.local/Documenti")
        if recent:
            e.set_text(recent[0])
        box.pack_start(e, False, False, 0)
        hint = Gtk.Label(xalign=0, wrap=True, max_width_chars=48, label=tr(
            "Examples: smb://computer/folder (Windows, Mac, NAS), sftp://user@computer, ftp://server, davs://server/path",
            "Esempi: smb://computer/cartella (Windows, Mac, NAS), sftp://utente@computer, ftp://server, davs://server/percorso"))
        hint.get_style_context().add_class("fd-prev-key"); box.pack_start(hint, False, False, 0)
        if recent:
            box.pack_start(Gtk.Label(label=tr("Recent Servers:", "Server recenti:"), xalign=0, margin_top=6), False, False, 0)
            lb = Gtk.ListBox()
            for r in recent[:6]:
                row = Gtk.ListBoxRow(); row.uri = r
                row.add(Gtk.Label(label=r, xalign=0, margin=4)); lb.add(row)
            lb.connect("row-activated", lambda _l, row: (e.set_text(row.uri), d.response(Gtk.ResponseType.OK)))
            lb.connect("row-selected", lambda _l, row: row and e.set_text(row.uri))
            fr = Gtk.Frame(); fr.add(lb); box.pack_start(fr, False, False, 0)
        d.show_all()
        r = d.run(); text = e.get_text().strip(); d.destroy()
        if r != Gtk.ResponseType.OK or not text:
            return
        if "://" not in text:
            text = "smb://" + text.lstrip("/\\").replace("\\", "/")
        self.cfg["servers"] = [text] + [x for x in recent if x != text][:9]
        save_cfg(self.cfg)
        self.mount_tried = None
        self.open_location(text)

    # ---------------------------------------------------------- open with, info, archives, terminal
    def launch_desktop_file(self, f):
        """A launcher (.desktop) runs its app, like an app on the Mac; only
        when it is executable or on the Desktop (the same rule as the desktop)."""
        p = f.get_path()
        if not p or not p.endswith(".desktop"):
            return False
        desk = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DESKTOP) or ""
        if not (os.access(p, os.X_OK) or (desk and os.path.dirname(p) == desk)):
            return False
        try:
            ai = Gio.DesktopAppInfo.new_from_filename(p)
            if ai:
                ai.launch([], None)
                return True
        except (GLib.Error, TypeError):
            pass
        return False

    def content_type(self, f):
        try:
            return f.query_info("standard::content-type", Gio.FileQueryInfoFlags.NONE, None).get_content_type() or ""
        except GLib.Error:
            return ""

    def open_with_menu(self, files):
        """Open With submenu: the default app first, the others, then Other…"""
        m = Gtk.Menu()
        ctype = self.content_type(files[0])
        default = Gio.AppInfo.get_default_for_type(ctype, False) if ctype else None
        apps = Gio.AppInfo.get_recommended_for_type(ctype) if ctype else []
        seen = set()
        for i, a in enumerate(([default] if default else []) + list(apps)):
            if a is None or a.get_id() in seen or not a.should_show() and a is not default:
                continue
            seen.add(a.get_id())
            label = a.get_display_name() + (tr(" (default)", " (predefinita)") if default and a.get_id() == default.get_id() else "")
            it = Gtk.MenuItem()
            hb = Gtk.Box(spacing=8)
            icon = a.get_icon()
            hb.pack_start(Gtk.Image.new_from_gicon(icon, Gtk.IconSize.MENU) if icon else Gtk.Image(), False, False, 0)
            hb.pack_start(Gtk.Label(label=label, xalign=0), True, True, 0)
            it.add(hb)
            it.connect("activate", lambda _i, app=a: self.launch_with(app, files))
            m.append(it)
            if i == 0 and default:
                m.append(Gtk.SeparatorMenuItem())
        if seen:
            m.append(Gtk.SeparatorMenuItem())
        other = Gtk.MenuItem(label=tr("Other…", "Altro…"))
        other.connect("activate", lambda *_: self.choose_app(files))
        m.append(other)
        return m

    def launch_with(self, app, files):
        try:
            app.launch(files, Gdk.Display.get_default().get_app_launch_context())
        except GLib.Error as e:
            self.message(tr("Cannot open: ", "Impossibile aprire: ") + e.message)

    def choose_app(self, files, open_now=True, always=False):
        """Choose Application (Open With > Other…), with “Always Open With”."""
        ctype = self.content_type(files[0])
        d = Gtk.AppChooserDialog.new(self, Gtk.DialogFlags.MODAL, files[0])
        d.set_title(tr("Open With", "Apri con"))
        w = d.get_widget(); w.set_show_all(True)
        chk = Gtk.CheckButton(label=tr(f"Always open “{self.describe(ctype)}” files with this app",
                                       f"Apri sempre i file “{self.describe(ctype)}” con questa app"), margin=8)
        chk.set_active(always)
        d.get_content_area().pack_end(chk, False, False, 0); chk.show()
        r = d.run(); app = d.get_app_info(); always = chk.get_active(); d.destroy()
        if r != Gtk.ResponseType.OK or app is None:
            return
        if always and ctype:
            try:
                app.set_as_default_for_type(ctype)
            except GLib.Error:
                pass
        if open_now:
            self.launch_with(app, files)

    def get_info(self, files=None):
        files = files or [f for f, _ in self.selected()] or [self.folder]
        for f in files[:10]:
            InfoWindow(self, f).show_all()

    ARCHIVES = ("application/zip", "application/x-tar", "application/x-compressed-tar", "application/x-bzip-compressed-tar",
                "application/x-xz-compressed-tar", "application/x-zstd-compressed-tar", "application/x-7z-compressed",
                "application/x-rar", "application/vnd.rar", "application/gzip", "application/x-bzip", "application/x-xz",
                "application/x-lzma", "application/x-cpio", "application/vnd.ms-cab-compressed", "application/x-archive")

    def is_archive(self, f):
        return self.content_type(f) in self.ARCHIVES

    def act_compress(self):
        files = [f for f, _ in self.selected()]
        if files and not self.in_trash():
            self.run_job("compress", files, files[0].get_parent(), new_name=tr("Archive", "Archivio"))

    def act_extract(self):
        files = [f.get_path() for f, _ in self.selected() if f.get_path() and self.is_archive(f)]
        if files:
            try:
                subprocess.Popen(["engrampa", "--extract-here", "--force"] + files)
            except OSError as e:
                self.message(str(e))

    def open_terminal(self, f=None):
        path = (f or self.drop_folder()).get_path()
        if not path:
            return
        for cmd in (["xfce4-terminal", "--working-directory=" + path], ["x-terminal-emulator"]):
            try:
                subprocess.Popen(cmd, cwd=path); return
            except OSError:
                continue

    def act_alias(self):
        files = [f for f, _ in self.selected()]
        if files and not self.in_trash():
            self.run_job("link", files, self.drop_folder())

    def templates(self):
        """Documents in ~/Templates (Modelli): File > New Document."""
        t = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_TEMPLATES)
        out = []
        if t and os.path.isdir(t) and os.path.realpath(t) != os.path.realpath(GLib.get_home_dir()):
            for n in sorted(os.listdir(t), key=str.lower):
                if not n.startswith(".") and os.path.isfile(os.path.join(t, n)):
                    out.append(Gio.File.new_for_path(os.path.join(t, n)))
        return out, t

    def new_document_menu(self):
        m = Gtk.Menu()
        it = Gtk.MenuItem(label=tr("Empty Text Document", "Documento di testo vuoto"))
        it.connect("activate", lambda *_: self.act_new_document())
        m.append(it)
        tpls, tdir = self.templates()
        if tpls:
            m.append(Gtk.SeparatorMenuItem())
        for t in tpls[:30]:
            it = Gtk.MenuItem(label=fileops.split_ext(t.get_basename())[0])
            it.connect("activate", lambda _i, x=t: self.act_new_document(x))
            m.append(it)
        if tdir:
            m.append(Gtk.SeparatorMenuItem())
            it = Gtk.MenuItem(label=tr("Open Templates Folder", "Apri la cartella Modelli"))
            it.connect("activate", lambda *_: (os.makedirs(tdir, exist_ok=True), self.open_location(tdir)))
            m.append(it)
        return m

    def act_new_document(self, template=None):
        if self.in_trash():
            return
        if template is None:
            self.run_job("new_file", [], self.drop_folder(), new_name=tr("untitled.txt", "Senza titolo.txt"))
        else:
            self.run_job("new_file", [], self.drop_folder(), template=template)

    def show_original(self):
        """For an alias: show the original, selected (Cmd+R on the Mac)."""
        for f, _ in self.selected()[:1]:
            try:
                info = f.query_info("standard::symlink-target", Gio.FileQueryInfoFlags.NOFOLLOW_SYMLINKS, None)
            except GLib.Error:
                continue
            t = info.get_attribute_byte_string("standard::symlink-target") if info.has_attribute("standard::symlink-target") else None
            if t:
                target = f.get_parent().resolve_relative_path(t)
                self.reveal(target)

    def reveal(self, target):
        parent = target.get_parent()
        if parent is not None:
            self.reselect = {target.get_uri()}
            self.open_location(parent)

    def on_close(self, *_):
        w, h = self.get_size()
        self.cfg["w"], self.cfg["h"] = w, h
        save_cfg(self.cfg)
        return False


class ColumnsView(Gtk.ScrolledWindow):
    """The Mac's column view: a folder per column, from left to right; the
    last column previews the selected file."""
    COL_W = 230

    def __init__(self, finder):
        super().__init__(vscrollbar_policy=Gtk.PolicyType.NEVER, hscrollbar_policy=Gtk.PolicyType.AUTOMATIC)
        self.f = finder
        self.box = Gtk.Box()
        self.add(self.box)
        self.cols = []            # [(folder, treeview, store)]
        self.token = 0
        self.set_can_focus(False)

    def grab_focus(self):
        if self.cols:
            self.cols[-1][1].grab_focus()

    def show(self, folder):
        self.token += 1
        for c in self.box.get_children():
            c.destroy()
        self.cols = []
        self.add_column(folder, first=True)

    def resort(self):
        path = [c[0] for c in self.cols]
        if path:
            self.show(path[0])

    def truncate(self, i):
        """Removes the columns (and preview) after column i."""
        kids = self.box.get_children()
        for w in kids[i + 1:]:
            w.destroy()
        self.cols = self.cols[:i + 1]
        if self.cols:                       # the window is named after the deepest folder shown
            self.f.set_title(self.f.display_name(self.cols[-1][0])); self.f.hb.set_title(self.f.get_title())

    def add_column(self, folder, first=False):
        store = Gtk.ListStore(str, GdkPixbuf.Pixbuf, object, bool, str)
        tv = Gtk.TreeView(model=store, headers_visible=False, enable_search=True, search_column=0)
        col = Gtk.TreeViewColumn()
        pr = Gtk.CellRendererPixbuf(); col.pack_start(pr, False); col.add_attribute(pr, "pixbuf", 1)
        tx = Gtk.CellRendererText(ellipsize=Pango.EllipsizeMode.END); col.pack_start(tx, True); col.add_attribute(tx, "text", 0)
        ar = Gtk.CellRendererText(xalign=1, foreground="#8e8e93"); col.pack_end(ar, False); col.add_attribute(ar, "text", 4)
        col.set_expand(True)
        tv.append_column(col)
        sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        sw.set_size_request(self.COL_W, -1); sw.add(tv)
        sw.get_style_context().add_class("fd-col")
        self.box.pack_start(sw, False, False, 0)
        index = len(self.cols)
        self.cols.append((folder, tv, store))
        tv.get_selection().connect("changed", lambda sel, i=index: self.on_select(i, sel))
        tv.connect("row-activated", lambda v, path, c, st=store: self.f.activate(st[path][2], st[path][3])
                   if not st[path][3] else None)
        tv.connect("key-press-event", lambda v, ev, i=index: self.on_key(i, ev))
        tv.connect("button-press-event", self.f.on_button)
        if hasattr(self.f, "dnd_targets"):
            self.f.dnd_column(tv)
        sw.show_all()
        token = self.token

        def filled(rows, error=None):
            if token != self.token:
                return
            if rows is None:
                store.append([error or "", None, None, False, ""])
                return
            for r in rows:
                store.append([r[C_NAME], r[C_SMALL], r[C_FILE], r[C_ISDIR], "›" if r[C_ISDIR] else ""])
            if first and len(store):
                tv.grab_focus()
        self.f.list_folder(folder, filled, apply_search=first)
        GLib.idle_add(self.scroll_end)
        self.f.set_title(self.f.display_name(folder)); self.f.hb.set_title(self.f.get_title())

    def refresh_last(self, select_uris=()):
        """Reads the deepest column's folder again (after a copy, rename...), keeping its selection."""
        if not self.cols:
            return
        folder, tv, store = self.cols[-1]
        model, it = tv.get_selection().get_selected()
        keep = set(select_uris)
        if it is not None and model[it][2] is not None:
            keep.add(model[it][2].get_uri())
        token = self.token

        def filled(rows, error=None):
            if token != self.token or rows is None:
                return
            store.clear()
            for r in rows:
                it2 = store.append([r[C_NAME], r[C_SMALL], r[C_FILE], r[C_ISDIR], "›" if r[C_ISDIR] else ""])
                if r[C_URI] in keep:
                    tv.get_selection().select_iter(it2)
        self.f.list_folder(folder, filled)

    def scroll_end(self):
        adj = self.get_hadjustment()
        adj.set_value(adj.get_upper() - adj.get_page_size())
        return False

    def on_select(self, i, sel):
        if i >= len(self.cols):
            return
        model, it = sel.get_selected()
        self.truncate(i)
        if it is None or model[it][2] is None:
            return
        f, is_dir = model[it][2], model[it][3]
        if is_dir:
            self.add_column(f)
        else:
            prev = self.f.preview_widget(f, False, 260, 260)
            frame = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
            frame.set_size_request(300, -1); frame.add(prev)
            frame.get_style_context().add_class("fd-prev")
            self.box.pack_start(frame, False, False, 0); frame.show_all()
            GLib.idle_add(self.scroll_end)

    def on_key(self, i, ev):
        k = Gdk.keyval_name(ev.keyval) or ""
        if k == "Right" and i + 1 < len(self.cols):
            nxt = self.cols[i + 1][1]
            if len(nxt.get_model()):
                nxt.grab_focus(); nxt.set_cursor(Gtk.TreePath.new_first(), None, False)
            return True
        if k == "Left" and i > 0:
            prev = self.cols[i - 1][1]
            prev.grab_focus()
            return True
        return False

    def selected(self):
        for folder, tv, store in reversed(self.cols):
            model, it = tv.get_selection().get_selected()
            if it is not None and model[it][2] is not None:
                return [(model[it][2], model[it][3])]
        return []


class GalleryView(Gtk.Box):
    """The Mac's gallery view: a large preview of the selected item, with a
    strip of thumbnails to scroll below it."""
    def __init__(self, finder):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.f = finder
        self.top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.top.get_style_context().add_class("fd-gallery-top")
        self.pack_start(self.top, True, True, 0)
        self.strip = Gtk.IconView(pixbuf_column=C_ICON, item_width=72, margin=6, column_spacing=4,
                                  selection_mode=Gtk.SelectionMode.SINGLE, activate_on_single_click=False)
        self.strip.get_style_context().add_class("fd-strip-view")
        self.strip.set_tooltip_column(C_NAME)
        self.strip.connect("selection-changed", lambda *_: self.on_select())
        self.strip.connect("item-activated", lambda v, path: self.f.activate(v.get_model()[path][C_FILE],
                                                                              v.get_model()[path][C_ISDIR]))
        self.strip.connect("button-press-event", self.f.on_button)
        sw = Gtk.ScrolledWindow(vscrollbar_policy=Gtk.PolicyType.NEVER)
        sw.set_size_request(-1, 112); sw.add(self.strip)
        sw.get_style_context().add_class("fd-strip")
        self.pack_start(sw, False, False, 0)
        self.pending = None

    def grab_focus(self):
        self.strip.grab_focus()

    def refresh(self):
        model = self.f.sorted
        self.strip.set_model(model)
        self.strip.set_columns(max(1, len(model)))      # one row, scrolled sideways
        if len(model):
            first = Gtk.TreePath.new_first()
            self.strip.select_path(first); self.strip.set_cursor(first, None, False)
        else:
            self.show_preview(None)

    def on_select(self):
        items = self.strip.get_selected_items()
        if not items:
            return
        row = self.strip.get_model()[items[0]]
        self.strip.scroll_to_path(items[0], True, 0.5, 0.5)
        # wait a moment while arrows are held down, then draw the large preview
        if self.pending:
            GLib.source_remove(self.pending)
        self.pending = GLib.timeout_add(120, self.show_preview, (row[C_FILE], row[C_ISDIR]))

    def show_preview(self, item):
        self.pending = None
        for c in self.top.get_children():
            c.destroy()
        if item is None:
            return False
        alloc = self.top.get_allocation()
        w, h = max(240, alloc.width - 60), max(180, alloc.height - 120)
        self.top.pack_start(self.f.preview_widget(item[0], item[1], w, h), True, True, 0)
        return False

    def selected(self):
        items = self.strip.get_selected_items()
        if not items:
            return []
        row = self.strip.get_model()[items[0]]
        return [(row[C_FILE], row[C_ISDIR])]


class InfoWindow(Gtk.Window):
    """Get Info (Ctrl+I), like the Mac's Info window: kind, size (counted for
    folders), where, dates, Open With for all files of that kind, sharing
    and permissions; for a drive, its capacity."""
    def __init__(self, finder, f):
        super().__init__(title=tr("Info: ", "Info: ") + (finder.display_name(f) or ""), transient_for=None)
        self.finder, self.f = finder, f
        self.set_default_size(330, -1); self.set_resizable(False); self.set_icon_name("dialog-information")
        self.cancel = Gio.Cancellable()
        self.connect("destroy", lambda *_: self.cancel.cancel())
        self.connect("key-press-event", lambda w, ev: (Gdk.keyval_name(ev.keyval) in ("Escape",) or
                     (ev.state & Gdk.ModifierType.CONTROL_MASK and Gdk.keyval_name(ev.keyval) in ("w", "i"))) and self.destroy())
        try:
            info = f.query_info("*", Gio.FileQueryInfoFlags.NONE, None)
        except GLib.Error as e:
            self.add(Gtk.Label(label=e.message, margin=20)); return
        self.info = info
        is_dir = info.get_file_type() in (Gio.FileType.DIRECTORY, Gio.FileType.MOUNTABLE)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=16); self.add(box)
        top = Gtk.Box(spacing=12)
        ctype = info.get_content_type() or ""
        icon = finder.icon_for(info, 64, f, ctype)
        top.pack_start(Gtk.Image.new_from_pixbuf(icon) if icon else Gtk.Image(), False, False, 0)
        names = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, spacing=2)
        nl = Gtk.Label(label=info.get_display_name(), xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE, max_width_chars=28)
        nl.get_style_context().add_class("fd-prev-name"); names.pack_start(nl, False, False, 0)
        self.top_size = Gtk.Label(xalign=0); self.top_size.get_style_context().add_class("fd-prev-key")
        names.pack_start(self.top_size, False, False, 0)
        top.pack_start(names, True, True, 0); box.pack_start(top, False, False, 0)

        grid = Gtk.Grid(column_spacing=10, row_spacing=5)
        self.row = 0

        def add(k, v):
            a = Gtk.Label(label=k, xalign=1); a.get_style_context().add_class("fd-prev-key")
            b = v if isinstance(v, Gtk.Widget) else Gtk.Label(label=v, xalign=0, wrap=True,
                                                               max_width_chars=30, ellipsize=Pango.EllipsizeMode.NONE)
            grid.attach(a, 0, self.row, 1, 1); grid.attach(b, 1, self.row, 1, 1); self.row += 1
            return b
        box.pack_start(self.section(tr("General", "Generale")), False, False, 0)
        add(tr("Kind:", "Tipo:"), tr("Folder", "Cartella") if is_dir else finder.describe(ctype))
        self.size_label = add(tr("Size:", "Dimensione:"), "")
        if is_dir:
            self.size_label.set_text(tr("Calculating…", "Calcolo in corso…"))
            threading.Thread(target=self.count, daemon=True).start()
        else:
            sz = info.get_size()
            txt = f"{human_size(sz)} ({f'{sz:,}'.replace(',', '.')} byte)" if sz >= 1000 else human_size(sz)
            self.size_label.set_text(txt); self.top_size.set_text(human_size(sz))
        parent = f.get_parent()
        if parent is not None:
            add(tr("Where:", "Posizione:"), parent.get_path() or parent.get_uri())
        tgt = info.get_attribute_byte_string("standard::symlink-target") if info.has_attribute("standard::symlink-target") else None
        if tgt:
            add(tr("Original:", "Originale:"), tgt)
        for key, label in (("time::created", tr("Created:", "Creato:")), ("time::modified", tr("Modified:", "Modificato:"))):
            if info.has_attribute(key):
                add(label, time.strftime("%d/%m/%Y %H:%M", time.localtime(info.get_attribute_uint64(key))))
        if ctype.startswith("image/") and f.get_path():
            try:
                fmt, w, h = GdkPixbuf.Pixbuf.get_file_info(f.get_path())
                if fmt:
                    add(tr("Dimensions:", "Dimensioni:"), f"{w} × {h}")
            except GLib.Error:
                pass
        # a drive or the root of a disk: capacity and free space
        try:
            fs = f.query_filesystem_info("filesystem::size,filesystem::free,filesystem::type", None)
        except GLib.Error:
            fs = None
        try:
            mnt = f.find_enclosing_mount(None)
        except GLib.Error:
            mnt = None
        if fs is not None and (f.get_path() in ("/",) or (mnt is not None and mnt.get_root().equal(f))):
            if fs.has_attribute("filesystem::size"):
                add(tr("Capacity:", "Capacità:"), human_size(fs.get_attribute_uint64("filesystem::size")))
                add(tr("Available:", "Disponibile:"), human_size(fs.get_attribute_uint64("filesystem::free")))
            if fs.has_attribute("filesystem::type"):
                add(tr("Format:", "Formato:"), fs.get_attribute_string("filesystem::type"))
        box.pack_start(grid, False, False, 0)

        if not is_dir and ctype:
            box.pack_start(self.section(tr("Open With", "Apri con")), False, False, 0)
            store = Gtk.ListStore(Gio.Icon, str, object)
            default = Gio.AppInfo.get_default_for_type(ctype, False)
            seen = set()
            for a in ([default] if default else []) + list(Gio.AppInfo.get_all_for_type(ctype)):
                if a is None or a.get_id() in seen:
                    continue
                seen.add(a.get_id())
                store.append([a.get_icon(), a.get_display_name() + (tr(" (default)", " (predefinita)")
                              if default and a.get_id() == default.get_id() else ""), a])
            ob = Gtk.ComboBox(model=store)
            ri = Gtk.CellRendererPixbuf(); ob.pack_start(ri, False); ob.add_attribute(ri, "gicon", 0)
            rt = Gtk.CellRendererText(ellipsize=Pango.EllipsizeMode.END); ob.pack_start(rt, True); ob.add_attribute(rt, "text", 1)
            if len(store):
                ob.set_active(0)
            else:
                store.append([None, tr("No app for this kind of file", "Nessuna app per questo tipo di file"), None])
                ob.set_active(0); ob.set_sensitive(False)
            box.pack_start(ob, False, False, 0)
            hint = Gtk.Label(xalign=0, wrap=True, max_width_chars=40, label=tr(
                "Use this app to open all documents like this one.", "Usa questa app per aprire tutti i documenti come questo."))
            hint.get_style_context().add_class("fd-prev-key"); box.pack_start(hint, False, False, 0)
            cb = Gtk.Button(label=tr("Change All…", "Cambia tutto…"), halign=Gtk.Align.START)
            cb.set_sensitive(False)

            def change_all(*_):
                it = ob.get_active_iter()
                app = store[it][2] if it else None
                if app:
                    try:
                        app.set_as_default_for_type(ctype)
                        cb.set_label(tr("Done", "Fatto")); cb.set_sensitive(False)
                    except GLib.Error as e:
                        finder.message(e.message)

            def picked(*_):
                it = ob.get_active_iter()
                app = store[it][2] if it else None
                cb.set_label(tr("Change All…", "Cambia tutto…"))
                cb.set_sensitive(bool(app) and not (default and app.get_id() == default.get_id()))
            cb.connect("clicked", change_all)
            ob.connect("changed", picked)
            box.pack_start(cb, False, False, 0)

        if f.get_path():
            box.pack_start(self.section(tr("Sharing & Permissions", "Condivisione e permessi")), False, False, 0)
            box.pack_start(self.permissions(), False, False, 0)

    def section(self, title):
        l = Gtk.Label(label=title, xalign=0, margin_top=6)
        l.get_style_context().add_class("fd-side-head"); l.set_margin_start(0)
        return l

    def count(self):
        """Size of a folder, counted in the background (shown as it grows)."""
        total, n, last = 0, 0, 0
        stack = [self.f]
        while stack and not self.cancel.is_cancelled():
            d = stack.pop()
            try:
                en = d.enumerate_children("standard::name,standard::type,standard::size", Gio.FileQueryInfoFlags.NOFOLLOW_SYMLINKS, self.cancel)
                for ci in en:
                    if ci.get_file_type() == Gio.FileType.DIRECTORY:
                        stack.append(d.get_child(ci.get_name()))
                    else:
                        total += ci.get_size()
                    n += 1
                en.close(None)
            except GLib.Error:
                continue
            if time.monotonic() - last > 0.3:
                last = time.monotonic(); GLib.idle_add(self.show_count, total, n, False)
        GLib.idle_add(self.show_count, total, n, True)

    def show_count(self, total, n, final):
        if self.cancel.is_cancelled():
            return False
        items = tr(f"{n} items", f"{n} elementi")
        self.size_label.set_text(f"{human_size(total)} ({f'{total:,}'.replace(',', '.')} byte) — {items}" +
                                 ("" if final else "…"))
        self.top_size.set_text(human_size(total))
        return False

    def permissions(self):
        """Owner, group and everyone: Read & Write / Read only / No Access."""
        p = self.f.get_path()
        try:
            st = os.lstat(p)
        except OSError:
            return Gtk.Label()
        import grp, pwd
        mine = st.st_uid == os.getuid()
        grid = Gtk.Grid(column_spacing=10, row_spacing=4)
        choices = [(6, tr("Read & Write", "Lettura e scrittura")), (4, tr("Read only", "Sola lettura")), (0, tr("No Access", "Nessun accesso"))]
        try:
            owner = pwd.getpwuid(st.st_uid).pw_name
        except KeyError:
            owner = str(st.st_uid)
        try:
            group = grp.getgrgid(st.st_gid).gr_name
        except KeyError:
            group = str(st.st_gid)
        rows = ((owner + (tr(" (Me)", " (io)") if mine else ""), 6), (group, 3), (tr("everyone", "tutti"), 0))
        is_dir = os.path.isdir(p)

        def changed(combo, shift):
            v = int(combo.get_active_id())
            mode = os.lstat(p).st_mode & 0o7777
            mode &= ~(0o7 << shift)
            bits = v | (1 if (is_dir and v) else 0)          # folders: open (x) whenever readable
            if not is_dir and (mode >> shift) & 1:
                bits |= 1                                     # keep "executable" on programs
            try:
                os.chmod(p, mode | (bits << shift))
            except OSError as e:
                self.finder.message(tr("Cannot change permissions: ", "Impossibile cambiare i permessi: ") + str(e))
        for i, (who, shift) in enumerate(rows):
            perm = (st.st_mode >> shift) & 0o6
            perm = 6 if perm == 6 else (4 if perm & 4 else 0)
            a = Gtk.Label(label=who, xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=16)
            c = Gtk.ComboBoxText()
            for v, l in choices:
                c.append(str(v), l)
            c.set_active_id(str(perm)); c.set_sensitive(mine)
            c.connect("changed", changed, shift)
            grid.attach(a, 0, i, 1, 1); grid.attach(c, 1, i, 1, 1)
        if not mine:
            note = Gtk.Label(label=tr("Only the owner can change these.", "Solo il proprietario può cambiarli."), xalign=0)
            note.get_style_context().add_class("fd-prev-key"); grid.attach(note, 0, 3, 2, 1)
        return grid


class OpsWindow(Jobs, Gtk.ApplicationWindow):
    """A small progress window for what the desktop (or another app) asks
    Mango Finder to do through D-Bus: copy, move, Trash, rename, new file."""
    def __init__(self, app):
        super().__init__(application=app, title="Mango Finder")
        self.set_default_size(460, -1); self.set_resizable(False)
        self.set_icon_name("system-file-manager"); self.set_position(Gtk.WindowPosition.CENTER)
        self.add(self.build_progress())
        self.reselect = set()
        self.connect("delete-event", lambda *_: (self.stop_jobs(), self.hide()) and True)
        self.icon_theme = Gtk.IconTheme.get_default()

    def maybe_show_progress(self, job):
        if job in self.jobs:
            self.show_all(); self.prog_rev.set_reveal_child(True)
        return False

    def after_job(self, job, errs):
        if not self.jobs:
            self.hide()
        if job.kind in ("new_folder", "new_file") and job.created and not errs:
            GLib.idle_add(self.rename_dialog, job.created[0])


class Prefs(Gtk.Window):
    """Mango Finder Settings (Ctrl+,): new windows show..., USB sticks and drives."""
    def __init__(self):
        super().__init__(title=tr("Mango Finder Settings", "Impostazioni di Mango Finder"))
        self.set_default_size(440, -1); self.set_resizable(False); self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("system-file-manager")
        c = load_cfg()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=20); self.add(box)
        row = Gtk.Box(spacing=8)
        row.pack_start(Gtk.Label(label=tr("New windows show:", "Le nuove finestre mostrano:")), False, False, 0)
        combo = Gtk.ComboBoxText()
        for k, l in (("home", GLib.get_user_name()), ("desktop", tr("Desktop", "Scrivania")),
                     ("documents", tr("Documents", "Documenti")), ("recents", tr("Recents", "Recenti"))):
            combo.append(k, l)
        combo.set_active_id(c.get("new_window", "home"))
        row.pack_start(combo, False, False, 0); box.pack_start(row, False, False, 0)
        h = Gtk.Label(label=tr("USB sticks, drives, phones and cameras", "Chiavette USB, dischi, telefoni e fotocamere"),
                      xalign=0, margin_top=8)
        h.get_style_context().add_class("fd-prev-name"); box.pack_start(h, False, False, 0)
        am = Gtk.CheckButton(label=tr("Open them automatically when connected", "Aprili automaticamente quando li colleghi"))
        am.set_active(c.get("automount", True)); box.pack_start(am, False, False, 0)
        ao = Gtk.CheckButton(label=tr("Show a window with their files", "Mostra una finestra con i loro file"), margin_start=24)
        ao.set_active(c.get("autoopen", True)); ao.set_sensitive(am.get_active()); box.pack_start(ao, False, False, 0)
        hint = Gtk.Label(xalign=0, wrap=True, max_width_chars=52, label=tr(
            "Eject them with the button next to their name in the sidebar before you unplug them.",
            "Prima di scollegarli, espellili con il pulsante accanto al nome nella barra laterale."))
        hint.get_style_context().add_class("fd-prev-key"); box.pack_start(hint, False, False, 0)

        def changed(*_):
            ao.set_sensitive(am.get_active())
            save_cfg({"new_window": combo.get_active_id(), "automount": am.get_active(), "autoopen": ao.get_active()}, PREF_KEYS)
        combo.connect("changed", changed); am.connect("toggled", changed); ao.connect("toggled", changed)
        self.connect("key-press-event", lambda w, ev: Gdk.keyval_name(ev.keyval) == "Escape" and self.destroy())


DBUS_XML = """<node>
  <interface name="org.freedesktop.FileManager1">
    <method name="ShowFolders"><arg type="as" name="URIs" direction="in"/><arg type="s" name="StartupId" direction="in"/></method>
    <method name="ShowItems"><arg type="as" name="URIs" direction="in"/><arg type="s" name="StartupId" direction="in"/></method>
    <method name="ShowItemProperties"><arg type="as" name="URIs" direction="in"/><arg type="s" name="StartupId" direction="in"/></method>
  </interface>
  <interface name="org.xfce.FileManager">
    <method name="DisplayApplicationChooserDialog"><arg type="s" direction="in"/><arg type="b" direction="in"/><arg type="b" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="DisplayFolder"><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="DisplayFolderAndSelect"><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="DisplayFileProperties"><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="Launch"><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="Execute"><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="as" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="DisplayPreferencesDialog"><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="CopyTo"><arg type="s" direction="in"/><arg type="as" direction="in"/><arg type="as" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="CopyInto"><arg type="s" direction="in"/><arg type="as" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="MoveInto"><arg type="s" direction="in"/><arg type="as" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="LinkInto"><arg type="s" direction="in"/><arg type="as" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="UnlinkFiles"><arg type="s" direction="in"/><arg type="as" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="LaunchFiles"><arg type="s" direction="in"/><arg type="as" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="RenameFile"><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="CreateFile"><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="CreateFileFromTemplate"><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
  </interface>
  <interface name="org.xfce.Trash">
    <method name="DisplayTrash"><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="EmptyTrash"><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="MoveToTrash"><arg type="as" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="in"/></method>
    <method name="QueryTrash"><arg type="b" name="full" direction="out"/></method>
    <signal name="TrashChanged"/>
  </interface>
</node>"""


def to_file(name, wd=""):
    """A Gio.File from a URI, an absolute path or a path relative to wd."""
    if "://" in name or name.startswith("trash:") or name.startswith("file:"):
        return Gio.File.new_for_uri(name)
    if not os.path.isabs(name) and wd:
        wdf = to_file(wd)
        return wdf.resolve_relative_path(name)
    return Gio.File.new_for_path(name)


class App(Gtk.Application):
    """One process for all windows (they share the clipboard and Undo).
    At login it runs as `mangos-finder --daemon`: no window, but it opens
    USB sticks and drives when they are connected, and answers the desktop
    and other apps (D-Bus: org.freedesktop.FileManager1, org.xfce.FileManager,
    org.xfce.Trash) like the file manager it replaces did."""
    def __init__(self):
        super().__init__(application_id="org.mangos.Finder",
                         flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.clip = None          # ("copy"|"cut", [Gio.File])
        self.undo_stack = []      # [(label, records)]
        self.ready = False
        self.skip_activate = False
        self.ops = None
        self.add_main_option("daemon", 0, GLib.OptionFlags.NONE, GLib.OptionArg.NONE,
                             "Run in the background (started at login)", None)
        self.add_main_option("preferences", 0, GLib.OptionFlags.NONE, GLib.OptionArg.NONE, "Show the settings", None)
        self.add_main_option("connect", 0, GLib.OptionFlags.NONE, GLib.OptionArg.NONE, "Connect to Server", None)
        self.add_main_option("select", 0, GLib.OptionFlags.NONE, GLib.OptionArg.STRING,
                             "Open the folder of this file and select it", "FILE")
        self.add_main_option("info", 0, GLib.OptionFlags.NONE, GLib.OptionArg.STRING, "Get Info of this file", "FILE")
        for name, cb in (("preferences", lambda *_: self.show_prefs()),
                         ("connect", lambda *_: self.new_window(None).connect_dialog())):
            a = Gio.SimpleAction.new(name, None); a.connect("activate", cb); self.add_action(a)
        for name, cb in (("select", lambda _a, v: self.show_items([v.get_string()])),
                         ("info", lambda _a, v: self.show_properties([v.get_string()]))):
            a = Gio.SimpleAction.new(name, GLib.VariantType.new("s")); a.connect("activate", cb); self.add_action(a)

    def do_handle_local_options(self, opts):
        d = opts.end().unpack()
        if "daemon" in d:
            self.register(None)
            if self.get_is_remote():
                return 0                          # already running
            self.hold()
            self.skip_activate = True
            return -1
        for name in ("preferences", "connect"):
            if name in d:
                self.register(None); self.activate_action(name, None); return 0
        for name in ("select", "info"):
            if name in d:
                self.register(None)
                uri = Gio.File.new_for_commandline_arg(d[name]).get_uri()
                self.activate_action(name, GLib.Variant("s", uri)); return 0
        return -1

    def setup(self):
        if self.ready:
            return
        self.ready = True
        load_css()
        p = Gtk.CssProvider(); p.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.setup()
        self.own_names()
        self.watch_drives()

    def do_activate(self):
        if self.skip_activate:
            self.skip_activate = False
            return
        self.new_window(None)

    def do_open(self, files, n, hint):
        for f in files:
            self.new_window(f)

    def new_window(self, where):
        if where is None:
            c = load_cfg().get("new_window", "home")
            where = {"desktop": GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DESKTOP),
                     "documents": GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS),
                     "recents": "recent:///"}.get(c) or GLib.get_home_dir()
        w = Finder(self, where)
        w.show_all(); w.present()
        return w

    def show_prefs(self):
        for w in self.get_windows():
            if isinstance(w, Prefs):
                w.present(); return
        w = Prefs(); self.add_window(w); w.show_all()

    def any_finder(self):
        for w in self.get_windows():
            if isinstance(w, Finder):
                return w
        return None

    def show_items(self, uris):
        """Open the folder of each item with the item selected (Show in Finder)."""
        for u in uris:
            f = to_file(u)
            parent = f.get_parent()
            if parent is None:
                self.new_window(f); continue
            w = self.new_window(parent)          # loads in the background: selected when shown
            w.reselect = {f.get_uri()}

    def show_properties(self, uris):
        helper = self.any_finder() or self.helper_finder()
        for u in uris:
            InfoWindow(helper, to_file(u)).show_all()

    def helper_finder(self):
        """A Finder window kept hidden, for Get Info and dialogs asked by the desktop."""
        if getattr(self, "hidden_finder", None) is None:
            self.hidden_finder = Finder(self, GLib.get_home_dir())
            self.hidden_finder.connect("delete-event", lambda w, *_: w.hide() or True)
        return self.hidden_finder

    def ops_window(self):
        if self.ops is None:
            self.ops = OpsWindow(self)
        return self.ops

    # ------------------------------------------------ USB sticks, drives, phones
    def watch_drives(self):
        """Mount what is connected (like the Mac), and show its files."""
        self.vm = Gio.VolumeMonitor.get()
        self.vm.connect("volume-added", self.on_volume_added)
        self.vm.connect("mount-added", self.on_mount_added)
        self.automounting = set()

    def on_volume_added(self, vm, v):
        c = load_cfg()
        if not c.get("automount", True) or not v.should_automount() or not v.can_mount() or v.get_mount():
            return
        self.automounting.add(v.get_uuid() or v.get_name())

        def done(vol, res):
            try:
                vol.mount_finish(res)
            except GLib.Error:
                return
            m = vol.get_mount()
            if m and load_cfg().get("autoopen", True):
                self.new_window(m.get_default_location())
        v.mount(Gio.MountMountFlags.NONE, Gtk.MountOperation.new(None), None, done)

    def on_mount_added(self, vm, m):
        # a phone or a camera mounted by GVFS itself (not one we mounted above)
        v = m.get_volume()
        key = (v.get_uuid() or v.get_name()) if v else None
        if key in self.automounting:
            self.automounting.discard(key); return
        scheme = m.get_root().get_uri_scheme()
        if scheme in ("mtp", "gphoto2", "afc") and load_cfg().get("autoopen", True) and load_cfg().get("automount", True):
            self.new_window(m.get_default_location())

    # ------------------------------------------------ D-Bus: the desktop and other apps
    def own_names(self):
        conn = self.get_dbus_connection()
        if conn is None:
            return
        node = Gio.DBusNodeInfo.new_for_xml(DBUS_XML)
        self.conn = conn
        for path, ifaces in (("/org/freedesktop/FileManager1", ("org.freedesktop.FileManager1",)),
                             ("/org/xfce/FileManager", ("org.xfce.FileManager", "org.xfce.Trash"))):
            for name in ifaces:
                try:
                    conn.register_object(path, node.lookup_interface(name), self.on_call, None, None)
                except GLib.Error:
                    pass
        flags = Gio.BusNameOwnerFlags.ALLOW_REPLACEMENT | Gio.BusNameOwnerFlags.REPLACE
        self.name_ids = [Gio.bus_own_name_on_connection(conn, n, flags, None, None)
                         for n in ("org.freedesktop.FileManager1", "org.xfce.FileManager")]
        # the desktop's Trash icon follows the Trash
        try:
            self.trash_mon = Gio.File.new_for_uri("trash:///").monitor_directory(Gio.FileMonitorFlags.NONE, None)
            self.trash_mon.connect("changed", lambda *_: conn.emit_signal(
                None, "/org/xfce/FileManager", "org.xfce.Trash", "TrashChanged", None))
        except GLib.Error:
            pass

    def on_call(self, conn, sender, path, iface, method, params, inv):
        a = params.unpack()
        if method == "QueryTrash":
            inv.return_value(self.dispatch(iface, method, a)); return
        # answer at once (the desktop must not wait for our dialogs), then do it
        inv.return_value(None)

        def later():
            try:
                self.dispatch(iface, method, a)
            except Exception as e:
                print(f"mangos-finder: {method}: {e}", file=sys.stderr)
            return False
        GLib.idle_add(later)

    def dispatch(self, iface, method, a):
        ops = lambda: self.ops_window()
        if iface == "org.freedesktop.FileManager1":
            uris = a[0]
            if method == "ShowFolders":
                for u in uris:
                    self.new_window(to_file(u))
            elif method == "ShowItems":
                self.show_items(uris)
            elif method == "ShowItemProperties":
                self.show_properties(uris)
            return None
        if iface == "org.xfce.Trash":
            if method == "DisplayTrash":
                self.new_window("trash:///")
            elif method == "EmptyTrash":
                if ops().yes_no(tr("Empty the Trash?", "Vuoi svuotare il Cestino?"),
                                tr("Everything in the Trash will be deleted. You cannot undo this.",
                                   "Tutti gli elementi nel Cestino verranno eliminati. Non si potrà annullare."),
                                tr("Empty Trash", "Svuota il Cestino")):
                    ops().run_job("empty_trash", [])
            elif method == "MoveToTrash":
                ops().run_job("trash", [to_file(x) for x in a[0]])
            elif method == "QueryTrash":
                try:
                    info = Gio.File.new_for_uri("trash:///").query_info("trash::item-count", Gio.FileQueryInfoFlags.NONE, None)
                    return GLib.Variant("(b)", (info.get_attribute_uint32("trash::item-count") > 0,))
                except GLib.Error:
                    return GLib.Variant("(b)", (False,))
            return None
        # org.xfce.FileManager
        if method == "DisplayFolder":
            self.new_window(to_file(a[0]))
        elif method == "DisplayFolderAndSelect":
            self.show_items([to_file(a[0]).get_child(a[1]).get_uri()])
        elif method == "DisplayFileProperties":
            self.show_properties([a[0]])
        elif method == "Launch":
            self.launch(to_file(a[0]))
        elif method == "LaunchFiles":
            for n in a[1]:
                self.launch(to_file(n, a[0]))
        elif method == "Execute":
            wd, uri, files = a[0], a[1], a[2]
            f = to_file(uri, wd)
            p = f.get_path() or ""
            if p.endswith(".desktop"):
                ai = Gio.DesktopAppInfo.new_from_filename(p)
                if ai:
                    ai.launch([to_file(x, wd) for x in files], None)
            elif p and os.access(p, os.X_OK):
                subprocess.Popen([p] + [to_file(x, wd).get_path() or x for x in files], cwd=to_file(wd).get_path() if wd else None)
            else:
                self.launch(f)
        elif method == "DisplayPreferencesDialog":
            self.show_prefs()
        elif method == "DisplayApplicationChooserDialog":
            f = to_file(a[0])
            self.helper_finder().choose_app([f], open_now=a[1], always=a[2])
        elif method in ("CopyInto", "MoveInto", "LinkInto"):
            wd, srcs, dest = a[0], a[1], a[2]
            kind = {"CopyInto": "copy", "MoveInto": "move", "LinkInto": "link"}[method]
            ops().run_job(kind, [to_file(x, wd) for x in srcs], to_file(dest, wd))
        elif method == "CopyTo":
            wd, srcs, tgts = a[0], a[1], a[2]
            ops().run_job("copy_to", [to_file(x, wd) for x in srcs], None, targets=[to_file(x, wd) for x in tgts])
        elif method == "UnlinkFiles":
            files = [to_file(x, a[0]) for x in a[1]]
            if files and ops().yes_no(tr("Delete immediately?", "Eliminare definitivamente?"),
                                      tr("These items will be deleted. You cannot undo this.",
                                         "Questi elementi verranno eliminati. Non si potrà annullare."),
                                      tr("Delete", "Elimina")):
                ops().run_job("delete", files)
        elif method == "RenameFile":
            ops().rename_dialog(to_file(a[0]))
        elif method == "CreateFile":
            parent, ctype = to_file(a[0]), a[1]
            if ctype == "inode/directory":
                ops().run_job("new_folder", [], parent)
            else:
                ops().run_job("new_file", [], parent, new_name=tr("untitled.txt", "Senza titolo.txt") if ctype.startswith("text/") or not ctype else tr("untitled", "Senza titolo"))
        elif method == "CreateFileFromTemplate":
            ops().run_job("new_file", [], to_file(a[0]), template=to_file(a[1]))
        return None

    def launch(self, f):
        try:
            if f.query_file_type(Gio.FileQueryInfoFlags.NONE, None) in (Gio.FileType.DIRECTORY, Gio.FileType.MOUNTABLE):
                self.new_window(f); return
        except GLib.Error:
            pass
        if (f.get_path() or "").endswith(".desktop"):
            ai = Gio.DesktopAppInfo.new_from_filename(f.get_path())
            if ai:
                ai.launch([], None); return
        Gio.AppInfo.launch_default_for_uri(f.get_uri(), None)


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
