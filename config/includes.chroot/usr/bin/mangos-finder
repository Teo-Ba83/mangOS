#!/usr/bin/python3
"""Mango Finder (beta): a file browser laid out like the Mac's Finder.

usage: mangos-finder [FOLDER or URI]

Stages 1-3:
  - sidebar: Favourites (Recents, Desktop, Documents, Downloads, Pictures,
    Music, Videos, Home), Locations (drives and USB sticks, Trash)
  - views (Ctrl+1..4 like Cmd+1..4): Icons (thumbnails for photos, videos,
    PDFs through Tumbler); List (folders open in place with a triangle;
    Name, Date Modified, Size, Kind); Columns (each folder opens in a new
    column, the last one previews the selected file); Gallery (a large
    preview with a strip of thumbnails below)
  - sort by name, date, size or kind, ascending or descending, folders first
  - search in the folder, show hidden files (Ctrl+Shift+.)
  - back / forward (Ctrl+[ / Ctrl+]), enclosing folder (Ctrl+Up), open
    (double click, Enter, Ctrl+Down), Quick Look (Space), Open in Thunar,
    Copy Path, path bar at the bottom
  - copy / cut / paste (Ctrl+C / X / V; Ctrl+Alt+V moves, like Cmd+Option+V),
    drag and drop (same disk: move, another disk or Ctrl: copy), Move to
    Trash (Delete or Ctrl+Backspace), Rename (F2), New Folder (Ctrl+Shift+N),
    Duplicate (Ctrl+D), Undo (Ctrl+Z); in the Trash: Put Back, Delete
    Immediately, Empty Trash; progress bar with Stop; asks before replacing
    (mangos.fileops does the work and has its own tests)
Files go through GIO/GVFS (the same layer Thunar uses), so drives, Trash
and network places work the same. Thunar stays the default file manager
until Mango Finder is complete."""
import functools, json, os, subprocess, sys, threading, time, urllib.parse
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, GObject, Gtk, Pango
from mangos import tr, load_css
from mangos import fileops

CFG = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "mangos", "finder.json")
ATTRS = ("standard::name,standard::display-name,standard::type,standard::icon,standard::size,"
         "standard::content-type,standard::is-hidden,standard::is-backup,standard::symlink-target,"
         "standard::target-uri,time::modified,thumbnail::path,thumbnail::failed")
BATCH = 200
THUMB_TYPES = ("image/", "video/", "application/pdf")

CSS = b"""
