         "standard::content-type,standard::is-hidden,standard::is-backup,standard::symlink-target,"
         "standard::target-uri,time::modified,thumbnail::path,thumbnail::failed")
BATCH = 200
THUMB_TYPES = ("image/", "video/", "application/pdf")

