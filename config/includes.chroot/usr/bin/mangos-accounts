#!/usr/bin/python3
"""MangOS Internet Accounts: connect Calendar and Contacts to Google, iCloud and others.

Accounts are GNOME Online Accounts (gnome-online-accounts-gtk), which
Calendar (gnome-calendar), Contacts (gnome-contacts) and the reminders use.
Google signs in through its web page. iCloud has no direct sign-in for
Linux: it works through CalDAV/CardDAV with an app-specific password made
at account.apple.com; this window walks through it."""
import subprocess, sys
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gtk
from mangos import tr, load_css

CSS = b"""
.ac-title { font-size: 22px; font-weight: 800; }
.ac-dim { opacity: .65; }
.ac-card { border-radius: 12px; border: 1px solid alpha(currentColor, .13); padding: 14px 16px; background: alpha(currentColor, .03); }
.ac-name { font-size: 15px; font-weight: 700; }
.ac-step { font-size: 13px; }
.ac-code { font-family: monospace; background: alpha(currentColor, .08); border-radius: 5px; padding: 1px 6px; }
"""
ICLOUD = (("Server", "https://caldav.icloud.com"),
          (tr("Calendar (CalDAV)", "Calendario (CalDAV)"), "https://caldav.icloud.com"),
          (tr("Contacts (CardDAV)", "Contatti (CardDAV)"), "https://contacts.icloud.com"))


def launch(cmd):
    try:
        subprocess.Popen(cmd)
    except OSError:
        pass


class Accounts(Gtk.ScrolledWindow):
    """The panel; in its own window, or inside System Settings (--socket-id)."""
    def __init__(self, embedded=False):
        super().__init__(hscrollbar_policy=Gtk.PolicyType.NEVER, propagate_natural_height=not embedded)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=20)
        if not embedded:
            self.set_max_content_height(600)
        self.add(box)

        t = Gtk.Label(label=tr("Calendar and Contacts", "Calendario e Contatti"), xalign=0)
        t.get_style_context().add_class("ac-title"); box.pack_start(t, False, False, 0)
        d = Gtk.Label(xalign=0, wrap=True, max_width_chars=64, label=tr(
            "Connect an account and its calendars, reminders and contacts appear in Calendar and Contacts, "
            "and stay in sync with your phone.",
            "Collega un account: i suoi calendari, promemoria e contatti compaiono in Calendario e Contatti "
            "e restano sincronizzati con il telefono."))
        d.get_style_context().add_class("ac-dim"); box.pack_start(d, False, False, 0)

        # Google
        g = self.card("goa-account-google", "Google", tr(
            "Sign in on Google's page: Gmail calendars and contacts.",
            "Accedi dalla pagina di Google: calendari e contatti di Gmail."))
        b = Gtk.Button(label=tr("Add Google Account…", "Aggiungi account Google…"), halign=Gtk.Align.START)
        b.get_style_context().add_class("suggested-action")
        b.connect("clicked", lambda *_: launch(["gnome-online-accounts-gtk"]))
        g.pack_start(b, False, False, 0)
        box.pack_start(g, False, False, 0)

        # iCloud
        c = self.card("gnome-online-accounts-gtk", "iCloud", tr(
            "Apple calendars and contacts, in three steps:", "Calendari e contatti Apple, in tre passi:"))
        steps = [
            tr("1. On account.apple.com, under Sign-In and Security > App-Specific Passwords, create one "
               "called “MangOS”.",
               "1. Su account.apple.com, in Accesso e sicurezza > Password specifiche per le app, creane una "
               "chiamata “MangOS”."),
            tr("2. Press “Add iCloud Account…” and choose “Calendar, Contacts and Files”.",
               "2. Premi “Aggiungi account iCloud…” e scegli “Calendario, contatti e file”."),
            tr("3. Enter these addresses (under Server Addresses), your Apple ID e-mail and the app-specific "
               "password:",
               "3. Inserisci questi indirizzi (in Indirizzi server), l'e-mail del tuo ID Apple e la password "
               "specifica per le app:"),
        ]
        for s in steps:
            l = Gtk.Label(label=s, xalign=0, wrap=True, max_width_chars=62); l.get_style_context().add_class("ac-step")
            c.pack_start(l, False, False, 0)
        grid = Gtk.Grid(column_spacing=10, row_spacing=6, margin_start=16)
        for i, (k, v) in enumerate(ICLOUD):
            grid.attach(Gtk.Label(label=k, xalign=1), 0, i, 1, 1)
            val = Gtk.Label(label=v, xalign=0, selectable=True); val.get_style_context().add_class("ac-code")
            grid.attach(val, 1, i, 1, 1)
            cp = Gtk.Button.new_from_icon_name("edit-copy-symbolic", Gtk.IconSize.BUTTON)
            cp.set_relief(Gtk.ReliefStyle.NONE); cp.set_tooltip_text(tr("Copy", "Copia"))
            cp.connect("clicked", lambda _b, v=v: Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(v, -1))
            grid.attach(cp, 2, i, 1, 1)
        c.pack_start(grid, False, False, 0)
        row = Gtk.Box(spacing=8)
        a = Gtk.Button(label="account.apple.com")
        a.connect("clicked", lambda *_: launch(["xdg-open", "https://account.apple.com"]))
        i_ = Gtk.Button(label=tr("Add iCloud Account…", "Aggiungi account iCloud…"))
        i_.get_style_context().add_class("suggested-action")
        i_.connect("clicked", lambda *_: launch(["gnome-online-accounts-gtk"]))
        row.pack_start(a, False, False, 0); row.pack_start(i_, False, False, 0)
        c.pack_start(row, False, False, 0)
        box.pack_start(c, False, False, 0)

        # others
        o = self.card("x-office-address-book", tr("Other Accounts", "Altri account"), tr(
            "Microsoft 365, Nextcloud, or any CalDAV / CardDAV server.",
            "Microsoft 365, Nextcloud o qualsiasi server CalDAV / CardDAV."))
        b = Gtk.Button(label=tr("Manage Accounts…", "Gestisci gli account…"), halign=Gtk.Align.START)
        b.connect("clicked", lambda *_: launch(["gnome-online-accounts-gtk"]))
        o.pack_start(b, False, False, 0)
        box.pack_start(o, False, False, 0)

        row = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        for label, cmd in ((tr("Open Calendar", "Apri Calendario"), ["gnome-calendar"]),
                           (tr("Open Contacts", "Apri Contatti"), ["gnome-contacts"])):
            b = Gtk.Button(label=label); b.connect("clicked", lambda _b, c=cmd: launch(c))
            row.pack_start(b, False, False, 0)
        box.pack_start(row, False, False, 0)

    def card(self, icon, name, sub):
        c = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8); c.get_style_context().add_class("ac-card")
        top = Gtk.Box(spacing=12)
        theme = Gtk.IconTheme.get_default()
        img = Gtk.Image.new_from_icon_name(icon if theme.has_icon(icon) else "avatar-default", Gtk.IconSize.DND)
        img.set_pixel_size(32); top.pack_start(img, False, False, 0)
        tb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        n = Gtk.Label(label=name, xalign=0); n.get_style_context().add_class("ac-name")
        s = Gtk.Label(label=sub, xalign=0, wrap=True, max_width_chars=56); s.get_style_context().add_class("ac-dim")
        tb.pack_start(n, False, False, 0); tb.pack_start(s, False, False, 0)
        top.pack_start(tb, True, True, 0)
        c.pack_start(top, False, False, 0)
        return c


def main():
    load_css()
    p = Gtk.CssProvider(); p.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    sid = next((int(a.split("=", 1)[1]) for a in sys.argv[1:] if a.startswith("--socket-id=")), None)
    if sid is not None:
        w = Gtk.Plug.new(sid)                 # embedded in System Settings
    else:
        w = Gtk.Window(title=tr("Internet Accounts", "Account Internet"))
        w.set_default_size(620, -1); w.set_icon_name("gnome-online-accounts-gtk")
        w.set_position(Gtk.WindowPosition.CENTER)
        w.set_titlebar(Gtk.HeaderBar(show_close_button=True, title=tr("Internet Accounts", "Account Internet")))
    w.add(Accounts(embedded=sid is not None))
    w.connect("destroy", Gtk.main_quit); w.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
