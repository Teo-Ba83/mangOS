#!/bin/sh
# Runs at every login (autostart). Applies the MangOS look the first time,
# shows the installer icon in the live session and the welcome window on
# the first login of an installed system.
cfg=${XDG_CONFIG_HOME:-$HOME/.config}/mangos
mkdir -p "$cfg"
live=false; grep -qw 'boot=live' /proc/cmdline && live=true

if [ ! -e "$cfg/appearance" ]; then
  sleep 2   # let xfdesktop register the monitors first
  mangos-appearance light
fi

# One-time additions to the dock of existing users after an update.
add_dock_item() { # name desktop-id
  [ -e "$cfg/dock-added-$1" ] && return 0
  [ -f "/usr/share/applications/$2.desktop" ] || return 0
  l=$HOME/.config/plank/dock1/launchers
  if [ -d "$l" ] && [ ! -e "$l/$1.dockitem" ]; then
    printf '[PlankDockItemPreferences]\nLauncher=file:///usr/share/applications/%s.desktop\n' "$2" > "$l/$1.dockitem"
    items=$(dconf read /net/launchpad/plank/docks/dock1/dock-items 2>/dev/null || true)
    case "$items" in
      *"'$1.dockitem'"*|"") ;;
      *) dconf write /net/launchpad/plank/docks/dock1/dock-items "$(echo "$items" | sed "s/'xfce4-terminal.dockitem'/'$1.dockitem', 'xfce4-terminal.dockitem'/")" ;;
    esac
  fi
  touch "$cfg/dock-added-$1"
}
add_dock_item mangos-store mangos-store

# Mac-style shortcuts added in later MangOS versions (kept if the user chose
# something else): Cmd+Space Spotlight, F3 / Ctrl+Up Mission Control,
# Cmd+Shift+3/4/5 screenshots on the Desktop.
ks() { # property new-value old-value...
  cur=$(xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/$1" 2>/dev/null || true)
  p=$1; n=$2; shift 2
  if [ -z "$cur" ]; then
    xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/$p" -n -t string -s "$n"; return 0
  fi
  for o in "$@"; do [ "$cur" = "$o" ] && xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/$p" -s "$n"; done
  return 0
}
ks '<Super>space' mangos-spotlight mangos-launchpad
ks F3 mangos-mission-control
ks '<Primary>Up' mangos-mission-control
ks '<Primary><Shift>3' 'mangos-screenshot full' 'xfce4-screenshooter -f -s Pictures'
ks '<Primary><Shift>4' 'mangos-screenshot area' 'xfce4-screenshooter -r -s Pictures'
ks '<Primary><Shift>5' 'mangos-screenshot tool' 'xfce4-screenshooter'
ks XF86MonBrightnessUp 'mangos-brightness up' 'brightnessctl -q set +10%'
ks XF86MonBrightnessDown 'mangos-brightness down' 'brightnessctl -q set 10%-'

# Quick Look in the Finder: Space (and right-click > Quick Look).
QL_ID=1700000000000001-mangos-quicklook
td=$HOME/.config/Thunar; mkdir -p "$td"
changed=false
[ -f "$td/uca.xml" ] || { cp /etc/xdg/Thunar/uca.xml "$td/uca.xml" 2>/dev/null || printf '<?xml version="1.0" encoding="UTF-8"?>\n<actions>\n</actions>\n' > "$td/uca.xml"; }
if ! grep -q "$QL_ID" "$td/uca.xml"; then
  sed -i "s|</actions>|<action>\n\t<icon>view-reveal-symbolic</icon>\n\t<name>Quick Look</name>\n\t<name xml:lang=\"it\">Anteprima rapida</name>\n\t<unique-id>$QL_ID</unique-id>\n\t<command>mangos-quicklook %F</command>\n\t<description>Preview without opening (Space)</description>\n\t<description xml:lang=\"it\">Anteprima senza aprire (Spazio)</description>\n\t<patterns>*</patterns>\n\t<startup-notify/>\n\t<directories/>\n\t<audio-files/>\n\t<image-files/>\n\t<other-files/>\n\t<text-files/>\n\t<video-files/>\n</action>\n</actions>|" "$td/uca.xml"
  changed=true
fi
if ! grep -q "uca-action-$QL_ID" "$td/accels.scm" 2>/dev/null; then
  echo "(gtk_accel_path \"<Actions>/ThunarActions/uca-action-$QL_ID\" \"space\")" >> "$td/accels.scm"
  changed=true
fi
if $changed; then thunar -q 2>/dev/null || true; fi

# A click on the date and time in the top bar opens the Notification Center
# (added in 0.2; a command the user set on the clock is kept).
if [ ! -e "$cfg/clock-notifications" ]; then
  for p in $(xfconf-query -c xfce4-panel -l 2>/dev/null | grep -E '^/plugins/plugin-[0-9]+$'); do
    [ "$(xfconf-query -c xfce4-panel -p "$p" 2>/dev/null)" = clock ] || continue
    [ -n "$(xfconf-query -c xfce4-panel -p "$p/command" 2>/dev/null)" ] ||
      xfconf-query -c xfce4-panel -p "$p/command" -n -t string -s mangos-notifications
  done
  touch "$cfg/clock-notifications"
fi

# LocalSend (AirDrop) is a Flutter app: on the old Macs' graphics it closed
# right after opening. Its Launchpad / menu entry goes through run-gl-safe,
# which falls back to processor drawing (user-level copy of its entry).
for f in /usr/share/applications/*ocalsend*.desktop; do
  [ -f "$f" ] || continue
  u=$HOME/.local/share/applications/$(basename "$f"); mkdir -p "${u%/*}"
  if [ ! -e "$u" ] || grep -q 'X-MangOS-GL-Safe' "$u"; then
    sed -e 's|^Exec=\(.*\)$|Exec=/usr/lib/mangos/run-gl-safe \1|' -e '/^\[Desktop Entry\]/a X-MangOS-GL-Safe=true' "$f" > "$u"
  fi
done

# The dock's Settings item now opens MangOS System Settings (gear icon).
di=$HOME/.config/plank/dock1/launchers/xfce-settings-manager.dockitem
if [ -f "$di" ] && grep -q 'xfce-settings-manager.desktop' "$di"; then
  sed -i 's|xfce-settings-manager.desktop|mangos-settings.desktop|' "$di"
fi

# Light mode used the "WhiteSur" icons, whose panel icons are white: Wi-Fi,
# volume and battery were invisible on the light top bar. Use WhiteSur-light.
if [ "$(xfconf-query -c xsettings -p /Net/IconThemeName 2>/dev/null)" = WhiteSur ]; then
  xfconf-query -c xsettings -p /Net/IconThemeName -s WhiteSur-light
fi

if $live; then
  # Never lock or blank the screen in the live session (e.g. while installing).
  xfconf-query -c xfce4-session -p /shutdown/LockScreen -n -t bool -s false
  xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/lock-screen-suspend-hibernate -n -t bool -s false
  xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/dpms-enabled -n -t bool -s false
  xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/blank-on-ac -n -t int -s 0
  xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/blank-on-battery -n -t int -s 0
  pkill -u "$(id -u)" -x light-locker 2>/dev/null || true
  xset s off -dpms 2>/dev/null || true
  d=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop"); mkdir -p "$d"
  f=$d/install-mangos.desktop
  if [ ! -e "$f" ]; then
    cp /usr/share/applications/install-mangos.desktop "$f"; chmod +x "$f"
    gio set --type=string "$f" metadata::trusted true 2>/dev/null || true
    gio set --type=string "$f" metadata::xfce-exe-checksum "$(sha256sum "$f" | cut -d' ' -f1)" 2>/dev/null || true
    touch "$f"
  fi
  # Wi-Fi check icon on the live desktop (lspci -nn + Wi-Fi state)
  w=$d/mangos-wifi-check.desktop
  if [ ! -e "$w" ]; then
    cp /usr/share/applications/mangos-wifi-check.desktop "$w"; chmod +x "$w"
    gio set --type=string "$w" metadata::trusted true 2>/dev/null || true
    gio set --type=string "$w" metadata::xfce-exe-checksum "$(sha256sum "$w" | cut -d' ' -f1)" 2>/dev/null || true
    touch "$w"
  fi
elif [ ! -e "$cfg/welcome-done" ]; then
  mangos-welcome &
fi
