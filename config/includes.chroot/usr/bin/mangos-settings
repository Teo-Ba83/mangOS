#!/usr/bin/python3
"""MangOS System Settings.

Layout inspired by the Mac's System Settings: a sidebar with a search field,
the user card and coloured rounded icons grouped by topic; the chosen pane
on the right. Xfce settings dialogs are embedded with XEmbed (their
--socket-id option, the same mechanism as xfce4-settings-manager); MangOS
panels and other tools that cannot be embedded open in their own window.

usage: mangos-settings [pane-id]"""
import os, pwd, shutil, signal, subprocess, sys
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk, Pango
from mangos import tr, load_css, os_release

# (id, English, Italian, tile colour, icon, command, embeddable, keywords)
