#!/usr/bin/python3
"""MangOS display brightness, for the Mac brightness keys (F1/F2) and scripts.

usage: mangos-brightness up | down | set PERCENT | get
Uses the same backlight and helper as xfce4-power-manager (no password for
the logged-in user). Never goes below 10 %: the screen always stays lit.
Shows the level in a notification bubble."""
import os, subprocess, sys

BL = "/sys/class/backlight"
HELPER = "/usr/sbin/xfpm-power-backlight-helper"
MIN, STEP = 10, 10


def device():
    try:
        devs = sorted(os.listdir(BL))
    except OSError:
        return None
    for kind in ("firmware", "platform", "raw"):
        for d in devs:
            try:
                if open(f"{BL}/{d}/type").read().strip() == kind:
                    return d
            except OSError:
                pass
    return None


def read(d, name):
    return int(open(f"{BL}/{d}/{name}").read())


def get(d):
    return round(read(d, "brightness") * 100 / max(1, read(d, "max_brightness")))


def set_pct(d, pct):
    pct = max(MIN, min(100, pct))
    mx = read(d, "max_brightness")
    val = max(1, round(mx * pct / 100))
    ok = subprocess.run(["pkexec", HELPER, "--set-brightness", str(val)],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0 \
        if os.path.exists(HELPER) else False
    if not ok:
        subprocess.run(["brightnessctl", "-q", "-d", d, "set", f"{pct}%"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return pct


def osd(pct):
    icon = "display-brightness-symbolic"
    subprocess.run(["notify-send", "-a", "mangos-brightness", "-i", icon, "-t", "1200",
                    "-h", f"int:value:{pct}", "-h", "string:x-canonical-private-synchronous:brightness",
                    "-h", "string:synchronous:brightness", " ", f"{pct} %"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "get"
    d = device()
    if not d:
        print("no backlight found", file=sys.stderr); sys.exit(1)
    cur = get(d)
    if cmd == "get":
        print(cur); return
    if cmd == "up":
        new = set_pct(d, (cur // STEP + 1) * STEP)
    elif cmd == "down":
        new = set_pct(d, ((cur + STEP - 1) // STEP - 1) * STEP)
    elif cmd == "set" and len(sys.argv) > 2:
        new = set_pct(d, int(sys.argv[2]))
    else:
        print(__doc__); sys.exit(2)
    if cmd in ("up", "down"):
        osd(new)


if __name__ == "__main__":
    main()
