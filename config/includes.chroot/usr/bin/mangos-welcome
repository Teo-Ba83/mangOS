#!/usr/bin/python3
"""First-start welcome: choose light or dark, check the network.
   mangos-welcome [--appearance]   (--appearance: only the look chooser)"""
import os, subprocess, sys, gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GdkPixbuf, GLib
from mangos import tr, load_css

CFG = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "mangos")

def current_mode():
    try:
        return open(os.path.join(CFG, "appearance")).read().strip()
    except OSError:
        return "light"

class Welcome(Gtk.Window):
    def __init__(self, appearance_only=False):
        super().__init__(title=tr("Welcome to MangOS", "Benvenuto in MangOS"))
        self.set_default_size(620, 0); self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER); self.set_icon_name("mangos-logo")
        self.mode = current_mode()
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=28)
        self.add(root)
        if not appearance_only:
            pix = GdkPixbuf.Pixbuf.new_from_file_at_size("/usr/share/mangos/logo/mangos-logo.svg", 96, 96)
            root.pack_start(Gtk.Image.new_from_pixbuf(pix), False, False, 0)
            t = Gtk.Label(label=tr("Welcome to MangOS", "Benvenuto in MangOS"))
            t.get_style_context().add_class("mangos-title"); root.pack_start(t, False, False, 0)
        s = Gtk.Label(label=tr("Choose how your desktop looks.", "Scegli l'aspetto della scrivania."))
        s.get_style_context().add_class("mangos-subtitle"); root.pack_start(s, False, False, 6)

        cards = Gtk.Box(spacing=18, halign=Gtk.Align.CENTER); root.pack_start(cards, False, False, 4)
        self.cards = {}
        for mode, label in (("light", tr("Light", "Chiaro")), ("dark", tr("Dark", "Scuro"))):
            ev = Gtk.EventBox(); box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            box.get_style_context().add_class("mangos-card")
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(f"/usr/share/backgrounds/mangos/mangos-{mode}.png", 220, 138, False)
            box.pack_start(Gtk.Image.new_from_pixbuf(pix), False, False, 0)
            box.pack_start(Gtk.Label(label=label), False, False, 0)
            ev.add(box); ev.connect("button-press-event", self.pick, mode)
            cards.pack_start(ev, False, False, 0); self.cards[mode] = box
        self.refresh_cards()

        if not appearance_only:
            net = Gtk.Box(spacing=10, margin_top=14, halign=Gtk.Align.CENTER)
            self.net_icon = Gtk.Image.new_from_icon_name("network-wireless", Gtk.IconSize.LARGE_TOOLBAR)
            self.net_label = Gtk.Label(label=tr("Checking the network…", "Controllo della rete…"))
            self.net_btn = Gtk.Button(label=tr("Network settings…", "Impostazioni di rete…"))
            self.net_btn.connect("clicked", lambda *_: subprocess.Popen(["nm-connection-editor"]))
            for w in (self.net_icon, self.net_label, self.net_btn):
                net.pack_start(w, False, False, 0)
            root.pack_start(net, False, False, 0)
            GLib.timeout_add_seconds(1, self.check_network)
            GLib.timeout_add_seconds(5, self.check_network_repeat)

        bar = Gtk.Box(margin_top=18); root.pack_end(bar, False, False, 0)
        go = Gtk.Button(label=tr("Done", "Fine") if appearance_only else tr("Get Started", "Inizia"))
        go.get_style_context().add_class("suggested-action")
        go.connect("clicked", self.finish); bar.pack_end(go, False, False, 0)
        self.connect("destroy", Gtk.main_quit)

    def refresh_cards(self):
        for m, box in self.cards.items():
            ctx = box.get_style_context()
            (ctx.add_class if m == self.mode else ctx.remove_class)("selected")

    def pick(self, _w, _e, mode):
        self.mode = mode; self.refresh_cards()
        subprocess.Popen(["mangos-appearance", mode])

    def check_network(self):
        try:
            state = subprocess.run(["nmcli", "-t", "networking", "connectivity", "check"],
                                   capture_output=True, text=True, timeout=10).stdout.strip()
        except Exception:
            state = "unknown"
        if state == "full":
            self.net_icon.set_from_icon_name("emblem-ok-symbolic", Gtk.IconSize.LARGE_TOOLBAR)
            self.net_label.set_text(tr("You are connected to the internet.", "Sei connesso a internet."))
            self.net_btn.hide()
        else:
            self.net_icon.set_from_icon_name("network-offline-symbolic", Gtk.IconSize.LARGE_TOOLBAR)
            self.net_label.set_text(tr("Not connected. Choose a Wi-Fi network from the top bar.",
                                       "Non connesso. Scegli una rete Wi-Fi dalla barra in alto."))
            self.net_btn.show()
        return False

    def check_network_repeat(self):
        self.check_network(); return True

    def finish(self, *_):
        os.makedirs(CFG, exist_ok=True)
        open(os.path.join(CFG, "welcome-done"), "w").close()
        subprocess.call(["mangos-appearance", self.mode])
        Gtk.main_quit()

load_css(); Welcome("--appearance" in sys.argv).show_all(); Gtk.main()
