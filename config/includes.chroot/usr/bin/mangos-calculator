#!/usr/bin/python3
"""MangOS Calculator: basic and scientific, laid out and behaving like the
calculator Mac users know (our own code and artwork).

Basic: AC/C, ±, %, ÷ × − +, =, with operator precedence, the pressed operator
lit until the next number, = repeating the last operation, 50 + 10 % = 55.
Scientific (Ctrl+2; Ctrl+1 back): parentheses, memory (mc m+ m− mr), 2nd,
powers and roots, eˣ 10ˣ ln log₁₀, x!, trigonometry and hyperbolic
functions in degrees or radians, π, e, EE, Rand. History of the last
calculations (Ctrl+H). Keyboard: digits, + - * / ^ %, Enter or =, Esc (AC),
Backspace, Ctrl+C / Ctrl+V. Italian uses the decimal comma."""
import locale, math, random, sys
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk, Pango
from mangos import tr, is_italian

DEC, GROUP = (",", ".") if is_italian() else (".", ",")
PREC = {"+": 1, "-": 1, "*": 2, "/": 2, "^": 3, "root": 3, "EE": 3, "logy": 3}
RIGHT = {"^", "root", "EE"}
SHOW = {"+": "+", "-": "−", "*": "×", "/": "÷", "^": "^", "root": "√", "EE": "E", "logy": "log"}

CSS = b"""
window.calc, window.calc headerbar { background: #2c2c2e; border: none; box-shadow: none; }
window.calc headerbar { min-height: 30px; padding: 0 6px; }
window.calc headerbar button:not(.titlebutton) { color: #d1d1d6; background: transparent; border: none; box-shadow: none; min-height: 22px; min-width: 22px; padding: 2px; }
window.calc headerbar button:not(.titlebutton):checked { color: #FF9F0A; }
.calc-display { color: white; font-family: Inter; font-weight: 300; padding: 0 14px 4px 14px; }
.calc-flag { color: #8e8e93; font-size: 11px; padding-left: 14px; }
.calc-keys { background: #1c1c1e; }
.calc-keys button { border-radius: 0; border: none; box-shadow: none; background-image: none; font-family: Inter;
                    font-size: 21px; color: white; padding: 0; min-height: 48px; min-width: 58px; text-shadow: none; }
.calc-keys button.digit { background-color: #5c5c5f; }
.calc-keys button.digit:active { background-color: #8e8e93; }
.calc-keys button.fn { background-color: #444447; font-size: 17px; }
.calc-keys button.fn:active { background-color: #6e6e72; }
.calc-keys button.sci { background-color: #3a3a3c; font-size: 14px; min-width: 58px; }
.calc-keys button.sci:active { background-color: #5c5c5f; }
.calc-keys button.sci.on { background-color: #6e6e72; }
.calc-keys button.op { background-color: #FF9F0A; font-size: 25px; }
.calc-keys button.op:active { background-color: #CC7F08; }
.calc-keys button.op.lit { background-color: white; color: #FF9F0A; }
.calc-hist { background: #1c1c1e; }
.calc-hist row { padding: 6px 12px; color: white; }
.calc-hist-expr { color: #8e8e93; font-size: 12px; }
.calc-hist-res { color: white; font-size: 17px; }
.calc-hist-title { color: #8e8e93; font-size: 11px; font-weight: 700; padding: 8px 12px 2px 12px; }
"""


class CalcError(Exception):
    pass


def fact(x):
    if x < 0 or x != int(x) or x > 170:
        raise CalcError()
    return float(math.factorial(int(x)))


def binary(op, a, b):
    try:
        if op == "+": r = a + b
        elif op == "-": r = a - b
        elif op == "*": r = a * b
        elif op == "/":
            if b == 0:
                raise CalcError()
            r = a / b
        elif op == "^": r = a ** b
        elif op == "root":                       # a-th root of b... shown as  b ʸ√ a  on the Mac: x ʸ√ y
            if b == 0:
                raise CalcError()
            r = math.copysign(abs(a) ** (1 / b), a) if a < 0 and b % 2 == 1 else a ** (1 / b)
        elif op == "EE": r = a * 10 ** b
        elif op == "logy": r = math.log(a) / math.log(b)
        else:
            raise CalcError()
    except (OverflowError, ValueError, ZeroDivisionError):
        raise CalcError()
    if isinstance(r, complex) or math.isnan(r) or math.isinf(r):
        raise CalcError()
    return float(r)


def fmt(x, digits=10):
    """A number as the display shows it: grouping, locale decimal sign, at most `digits` significant digits."""
    if x == 0:
        return "0"
    if abs(x) >= 10 ** digits or abs(x) < 10 ** -(digits - 2):
        s = f"{x:.{digits - 4}e}"
        mant, exp = s.split("e")
        mant = mant.rstrip("0").rstrip(".")
        return mant.replace(".", DEC) + "e" + str(int(exp))
    s = f"{x:.{digits}g}"
    if "e" in s:
        s = f"{x:.{max(0, digits - 1 - int(math.floor(math.log10(abs(x)))))}f}"
    if "." in s:
        s = s.rstrip("0").rstrip(".")
    return group(s)


def group(s):
    """'-1234567.5' -> '-1.234.567,5' (Italian)."""
    neg = s.startswith("-")
    s = s.lstrip("-")
    ip, _, fp = s.partition(".")
    out = ""
    while len(ip) > 3:
        out = GROUP + ip[-3:] + out
        ip = ip[:-3]
    out = ip + out
    return ("-" if neg else "") + out + ((DEC + fp) if _ else "")


class Engine:
    """Immediate-execution calculator with precedence, like the Mac's."""
    def __init__(self):
        self.memory = 0.0
        self.deg = True
        self.history = []
        self.clear_all()

    def clear_all(self):
        self.vals, self.ops = [], []
        self.entry, self.typing, self.last = "0", False, None
        self.repeat = None
        self.trail = []
        self.error = False

    # value currently shown
    def value(self):
        try:
            return float(self.entry)
        except ValueError:
            return 0.0

    def set_value(self, v, last="func"):
        if math.isnan(v) or math.isinf(v):
            raise CalcError()
        self.entry = repr(float(v)) if v != int(v) or abs(v) >= 1e15 else str(int(v))
        self.typing = False
        self.last = last

    def digit(self, d):
        if not self.typing or self.last == "eq":
            if self.last == "eq":
                self.trail = []
            self.entry = ""
            self.typing = True
        if d == ".":
            if "." in self.entry:
                return
            self.entry = (self.entry or "0") + "."
        else:
            if len(self.entry.replace("-", "").replace(".", "")) >= 15:
                return
            self.entry = d if self.entry in ("0", "") else self.entry + d
            if self.entry == "-0":
                self.entry = "-" + d
        self.last = "digit"

    def backspace(self):
        if self.typing and self.last == "digit":
            self.entry = self.entry[:-1]
            if self.entry in ("", "-"):
                self.entry, self.typing = "0", False

    def apply_top(self):
        op = self.ops.pop()
        b = self.vals.pop(); a = self.vals.pop()
        self.vals.append(binary(op, a, b))

    def reduce(self, prec):
        while self.ops and self.ops[-1] != "(" and (
                PREC[self.ops[-1]] > prec or (PREC[self.ops[-1]] == prec and self.ops[-1] not in RIGHT)):
            self.apply_top()

    def operator(self, op):
        if self.last == "op" and self.ops and self.ops[-1] != "(":
            self.ops[-1] = op                       # changed their mind: replace the operator
            if self.trail:
                self.trail[-1] = SHOW[op]
            return
        if self.last != ")":
            self.vals.append(self.value()); self.trail.append(fmt(self.value()))
        self.reduce(PREC[op])
        self.ops.append(op); self.trail.append(SHOW[op])
        self.set_value(self.vals[-1], "op")

    def equals(self):
        if not self.ops:
            if self.repeat:                          # = again: repeat the last operation
                op, b = self.repeat
                a = self.value()
                r = binary(op, a, b)
                self.history.insert(0, (f"{fmt(a)} {SHOW[op]} {fmt(b)}", fmt(r)))
                self.set_value(r, "eq")
            return
        if self.last == "op":                        # 5 + =  ->  5 + 5
            self.vals.append(self.vals[-1]); self.trail.append(fmt(self.vals[-1]))
        elif self.last != ")":
            self.vals.append(self.value()); self.trail.append(fmt(self.value()))
        last_op = next((o for o in reversed(self.ops) if o != "("), None)
        right = self.vals[-1]
        while self.ops:
            if self.ops[-1] == "(":
                self.ops.pop()
                continue
            self.apply_top()
        r = self.vals.pop()
        self.history.insert(0, (" ".join(self.trail), fmt(r)))
        del self.history[30:]
        self.vals, self.trail = [], []
        self.repeat = (last_op, right) if last_op else None
        self.set_value(r, "eq")

    def paren_open(self):
        if self.last in ("digit", "func", ")"):     # 2(3+4): multiply
            self.operator("*")
        self.ops.append("("); self.trail.append("(")
        self.last = "("
        self.entry, self.typing = "0", False

    def paren_close(self):
        if "(" not in self.ops:
            return
        if self.last != ")":
            self.vals.append(self.value()); self.trail.append(fmt(self.value()))
        while self.ops[-1] != "(":
            self.apply_top()
        self.ops.pop(); self.trail.append(")")
        self.set_value(self.vals[-1], ")")

    def percent(self):
        x = self.value()
        if self.ops and self.ops[-1] in "+-" and self.vals:
            self.set_value(self.vals[-1] * x / 100)   # 50 + 10 % -> 50 + 5
        else:
            self.set_value(x / 100)

    def negate(self):
        if self.typing:
            self.entry = self.entry[1:] if self.entry.startswith("-") else "-" + self.entry
        else:
            self.set_value(-self.value(), self.last or "func")

    def angle(self, x):
        return math.radians(x) if self.deg else x

    def unangle(self, x):
        return math.degrees(x) if self.deg else x

    def func(self, name):
        x = self.value()
        f = {
            "x2": lambda: x * x, "x3": lambda: x ** 3, "ex": lambda: math.exp(x), "10x": lambda: 10 ** x,
            "2x": lambda: 2 ** x, "1/x": lambda: 1 / x, "sqrt": lambda: math.sqrt(x), "cbrt": lambda: math.copysign(abs(x) ** (1 / 3), x),
            "ln": lambda: math.log(x), "log10": lambda: math.log10(x), "log2": lambda: math.log2(x), "fact": lambda: fact(x),
            "sin": lambda: math.sin(self.angle(x)), "cos": lambda: math.cos(self.angle(x)), "tan": lambda: math.tan(self.angle(x)),
            "asin": lambda: self.unangle(math.asin(x)), "acos": lambda: self.unangle(math.acos(x)), "atan": lambda: self.unangle(math.atan(x)),
            "sinh": lambda: math.sinh(x), "cosh": lambda: math.cosh(x), "tanh": lambda: math.tanh(x),
            "asinh": lambda: math.asinh(x), "acosh": lambda: math.acosh(x), "atanh": lambda: math.atanh(x),
        }[name]
        try:
            r = f()
        except (ValueError, ZeroDivisionError, OverflowError):
            raise CalcError()
        if isinstance(r, complex):
            raise CalcError()
        if name in ("sin", "cos", "tan") and abs(r) < 1e-12:
            r = 0.0                                  # sin 180° is 0, not 1.2e-16
        if name == "tan" and self.deg and abs((x % 180) - 90) < 1e-12:
            raise CalcError()
        self.set_value(r)

    def constant(self, v):
        self.set_value(v)


class Calculator(Gtk.Window):
    def __init__(self):
        super().__init__(title=tr("Calculator", "Calcolatrice"))
        self.get_style_context().add_class("calc")
        self.set_resizable(False)
        self.set_icon_name("mangos-calculator")
        self.e = Engine()
        self.scientific, self.second = False, False

        hb = Gtk.HeaderBar(show_close_button=True)
        hb.set_decoration_layout("close,minimize:")
        self.sci_btn = Gtk.ToggleButton(image=Gtk.Image.new_from_icon_name("view-grid-symbolic", Gtk.IconSize.MENU))
        self.sci_btn.set_tooltip_text(tr("Scientific (Ctrl+2)", "Scientifica (Ctrl+2)"))
        self.sci_btn.connect("toggled", lambda b: self.set_scientific(b.get_active()))
        self.hist_btn = Gtk.ToggleButton(image=Gtk.Image.new_from_icon_name("document-open-recent-symbolic", Gtk.IconSize.MENU))
        self.hist_btn.set_tooltip_text(tr("History (Ctrl+H)", "Cronologia (Ctrl+H)"))
        self.hist_btn.connect("toggled", lambda b: self.show_history(b.get_active()))
        hb.pack_end(self.hist_btn); hb.pack_end(self.sci_btn)
        self.set_titlebar(hb)

        outer = Gtk.Box()
        self.add(outer)
        main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.pack_start(main, True, True, 0)
        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.flag = Gtk.Label(xalign=0); self.flag.get_style_context().add_class("calc-flag")
        self.display = Gtk.Label(label="0", xalign=1, ellipsize=Pango.EllipsizeMode.START)
        self.display.get_style_context().add_class("calc-display")
        self.display.set_size_request(-1, 76); self.display.set_valign(Gtk.Align.END)
        top.pack_start(self.flag, False, False, 0); top.pack_start(self.display, True, True, 0)
        main.pack_start(top, False, False, 0)

        keys = Gtk.Box(); keys.get_style_context().add_class("calc-keys")
        main.pack_start(keys, True, True, 0)
        self.sci_grid = Gtk.Grid(row_spacing=1, column_spacing=1, margin_end=1, row_homogeneous=True, column_homogeneous=True)
        self.basic = Gtk.Grid(row_spacing=1, column_spacing=1, row_homogeneous=True, column_homogeneous=True)
        keys.pack_start(self.sci_grid, True, True, 0); keys.pack_start(self.basic, False, False, 0)
        self.buttons = {}
        self.build_basic(); self.build_scientific()

        self.hist_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); self.hist_box.get_style_context().add_class("calc-hist")
        self.hist_box.set_size_request(230, -1)
        ht = Gtk.Label(label=tr("HISTORY", "CRONOLOGIA"), xalign=0); ht.get_style_context().add_class("calc-hist-title")
        self.hist_box.pack_start(ht, False, False, 0)
        self.hist_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE); self.hist_list.get_style_context().add_class("calc-hist")
        self.hist_list.connect("row-activated", self.on_history)
        hs = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER); hs.add(self.hist_list)
        self.hist_box.pack_start(hs, True, True, 0)
        clear = Gtk.Button(label=tr("Clear", "Cancella"), relief=Gtk.ReliefStyle.NONE, margin=6)
        clear.connect("clicked", lambda *_: (self.e.history.clear(), self.fill_history()))
        self.hist_box.pack_end(clear, False, False, 0)
        outer.pack_start(self.hist_box, False, False, 0)

        self.connect("key-press-event", self.on_key)
        self.connect("destroy", Gtk.main_quit)
        self.show_all()
        self.sci_grid.hide(); self.hist_box.hide()
        self.update()

    # ---- keys
    def key(self, grid, label, col, row, cls, action, w=1):
        b = Gtk.Button(label=label, can_focus=False)
        b.get_style_context().add_class(cls)
        b.connect("clicked", lambda *_: self.press(action))
        grid.attach(b, col, row, w, 1)
        self.buttons[action] = b
        return b

    def build_basic(self):
        g = self.basic
        self.key(g, "AC", 0, 0, "fn", "clear"); self.key(g, "⁺∕₋", 1, 0, "fn", "neg"); self.key(g, "%", 2, 0, "fn", "pct")
        self.key(g, "÷", 3, 0, "op", "/")
        for r, row in enumerate(("789", "456", "123")):
            for c, d in enumerate(row):
                self.key(g, d, c, r + 1, "digit", d)
        self.key(g, "×", 3, 1, "op", "*"); self.key(g, "−", 3, 2, "op", "-"); self.key(g, "+", 3, 3, "op", "+")
        z = self.key(g, "0", 0, 4, "digit", "0", w=2); z.get_child().set_xalign(0.2)
        self.key(g, DEC, 2, 4, "digit", "."); self.key(g, "=", 3, 4, "op", "=")

    SCI = [
        [("(", "("), (")", ")"), ("mc", "mc"), ("m+", "m+"), ("m−", "m-"), ("mr", "mr")],
        [("2ⁿᵈ", "2nd"), ("x²", "x2"), ("x³", "x3"), ("xʸ", "^"), ("eˣ", "ex"), ("10ˣ", "10x")],
        [("¹∕ₓ", "1/x"), ("²√x", "sqrt"), ("³√x", "cbrt"), ("ʸ√x", "root"), ("ln", "ln"), ("log₁₀", "log10")],
        [("x!", "fact"), ("sin", "sin"), ("cos", "cos"), ("tan", "tan"), ("e", "e"), ("EE", "EE")],
        [("Rad", "rad"), ("sinh", "sinh"), ("cosh", "cosh"), ("tanh", "tanh"), ("π", "pi"), ("Rand", "rand")],
    ]
    SECOND = {"ex": ("yˣ", "yx"), "10x": ("2ˣ", "2x"), "ln": ("logᵧ", "logy"), "log10": ("log₂", "log2"),
              "sin": ("sin⁻¹", "asin"), "cos": ("cos⁻¹", "acos"), "tan": ("tan⁻¹", "atan"),
              "sinh": ("sinh⁻¹", "asinh"), "cosh": ("cosh⁻¹", "acosh"), "tanh": ("tanh⁻¹", "atanh")}

    def build_scientific(self):
        self.sci_keys = {}
        for r, row in enumerate(self.SCI):
            for c, (label, action) in enumerate(row):
                b = Gtk.Button(label=label, can_focus=False); b.get_style_context().add_class("sci")
                b.connect("clicked", lambda _b, a=action: self.press(self.SECOND[a][1] if self.second and a in self.SECOND else a))
                self.sci_grid.attach(b, c, r, 1, 1)
                self.sci_keys[action] = (b, label)

    def set_scientific(self, on):
        self.scientific = on
        if self.sci_btn.get_active() != on:
            self.sci_btn.set_active(on)
        self.sci_grid.set_visible(on)
        GLib.idle_add(lambda: self.resize(1, 1) or False)

    def show_history(self, on):
        if self.hist_btn.get_active() != on:
            self.hist_btn.set_active(on)
        self.hist_box.set_visible(on)
        self.fill_history()
        if not on:
            GLib.idle_add(lambda: self.resize(1, 1) or False)

    def fill_history(self):
        for c in self.hist_list.get_children():
            c.destroy()
        for expr, res in self.e.history:
            row = Gtk.ListBoxRow(); row.result = res
            b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            a = Gtk.Label(label=expr.replace(".", "\0").replace(",", ".").replace("\0", ",") if False else expr,
                          xalign=1, ellipsize=Pango.EllipsizeMode.START)
            a.get_style_context().add_class("calc-hist-expr")
            r = Gtk.Label(label="= " + res, xalign=1); r.get_style_context().add_class("calc-hist-res")
            b.pack_start(a, False, False, 0); b.pack_start(r, False, False, 0)
            row.add(b); self.hist_list.add(row)
        self.hist_list.show_all()

    def on_history(self, lb, row):
        self.paste(row.result)

    # ---- actions
    def press(self, a):
        e = self.e
        if e.error and a not in ("clear",):
            e.clear_all()
            if a in ("+", "-", "*", "/", "=", "^"):
                self.update(); return
        try:
            if a in "0123456789." and len(a) == 1:
                e.digit(a)
            elif a in ("+", "-", "*", "/", "^", "root", "EE", "logy", "yx"):
                e.operator("^" if a == "yx" else a)
            elif a == "=":
                e.equals()
            elif a == "clear":
                if e.typing and e.entry not in ("0",) and not e.error:
                    e.entry, e.typing = "0", False          # C: only the number being typed
                    if e.last == "digit":
                        e.last = "op" if e.ops else None
                else:
                    e.clear_all()
            elif a == "neg":
                e.negate()
            elif a == "pct":
                e.percent()
            elif a == "(":
                e.paren_open()
            elif a == ")":
                e.paren_close()
            elif a == "mc":
                e.memory = 0.0
            elif a == "m+":
                e.memory += e.value()
            elif a == "m-":
                e.memory -= e.value()
            elif a == "mr":
                e.constant(e.memory)
            elif a == "2nd":
                self.second = not self.second
                for key, (b, label) in self.sci_keys.items():
                    b.set_label(self.SECOND[key][0] if self.second and key in self.SECOND else label)
                (b.get_style_context().add_class if self.second else b.get_style_context().remove_class)("on") \
                    if (b := self.sci_keys["2nd"][0]) else None
            elif a == "rad":
                e.deg = not e.deg
                self.sci_keys["rad"][0].set_label("Rad" if e.deg else "Deg")
            elif a == "pi":
                e.constant(math.pi)
            elif a == "e":
                e.constant(math.e)
            elif a == "rand":
                e.constant(random.random())
            elif a == "back":
                e.backspace()
            else:
                e.func(a)
        except (CalcError, IndexError):
            e.error = True
        self.update()

    def update(self):
        e = self.e
        if e.error:
            text = tr("Error", "Errore")
        elif e.typing:
            text = group(e.entry)
            if e.entry.endswith("."):
                text = group(e.entry[:-1]) + DEC
        else:
            text = fmt(e.value())
        n = len(text)
        size = 46 if n <= 9 else 38 if n <= 11 else 30 if n <= 14 else 24
        self.display.set_markup(f"<span size='{size * Pango.SCALE}'>{GLib.markup_escape_text(text)}</span>")
        self.buttons["clear"].set_label("C" if e.typing and e.entry != "0" and not e.error else "AC")
        for op in ("+", "-", "*", "/"):
            ctx = self.buttons[op].get_style_context()
            (ctx.add_class if e.last == "op" and e.ops and e.ops[-1] == op else ctx.remove_class)("lit")
        flags = []
        if not e.deg:
            flags.append("Rad")
        if e.memory:
            flags.append("M")
        self.flag.set_text("  ".join(flags))
        if self.hist_box.get_visible() and len(self.hist_list.get_children()) != len(e.history):
            self.fill_history()

    def paste(self, text):
        t = (text or "").strip().replace(GROUP, "").replace(DEC, ".").replace("−", "-")
        try:
            v = float(t)
        except ValueError:
            return
        self.e.clear_all() if self.e.error else None
        self.e.set_value(v, "func")
        self.update()

    def on_key(self, w, ev):
        k = Gdk.keyval_name(ev.keyval) or ""
        ctrl = ev.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD4_MASK)
        ch = chr(Gdk.keyval_to_unicode(ev.keyval)) if Gdk.keyval_to_unicode(ev.keyval) else ""
        if ctrl:
            if k.lower() == "c":
                Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(self.display.get_text(), -1)
            elif k.lower() == "v":
                Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).request_text(lambda _c, t: self.paste(t))
            elif k in ("1", "2"):
                self.set_scientific(k == "2")
            elif k.lower() == "h":
                self.show_history(not self.hist_box.get_visible())
            elif k.lower() in ("q", "w"):
                self.destroy()
            else:
                return False
            return True
        mapping = {"Return": "=", "KP_Enter": "=", "equal": "=", "Escape": "clear", "Delete": "clear",
                   "BackSpace": "back", "KP_Add": "+", "KP_Subtract": "-", "KP_Multiply": "*", "KP_Divide": "/",
                   "KP_Decimal": ".", "KP_Separator": "."}
        if k in mapping:
            a = mapping[k]
        elif ch and ch in "0123456789":
            a = ch
        elif ch and ch in (".", ","):
            a = "."
        elif ch and ch in "+-*/^%()":
            a = {"%": "pct"}.get(ch, ch)
        elif ch in ("x", "X"):
            a = "*"
        else:
            return False
        if a in self.buttons:                       # brief press feedback on the key
            b = self.buttons[a]
            b.set_state_flags(Gtk.StateFlags.ACTIVE, False)
            GLib.timeout_add(110, lambda: b.unset_state_flags(Gtk.StateFlags.ACTIVE) or False)
        self.press(a)
        return True


def main():
    p = Gtk.CssProvider(); p.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 2)
    Calculator()
    Gtk.main()


if __name__ == "__main__":
    main()
