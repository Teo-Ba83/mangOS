#!/usr/bin/python3
"""MangOS Store: find, install and update Debian software.

Layout inspired by the Mac's app store (sidebar with search and sections,
featured card, rows of apps with a round "Get" button, app pages), built on
Debian's AppStream catalog. Installing/removing goes through
/usr/lib/mangos/store-helper (pkexec, administrator password)."""
import html, json, os, re, subprocess, threading, urllib.request
