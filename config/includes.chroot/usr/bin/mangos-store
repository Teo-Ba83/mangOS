def markup_from_appstream(desc):
    """AppStream description markup (<p>, <ul><li>) -> Pango text."""
    if not desc:
        return ""
    text = re.sub(r"\s+", " ", desc)
    text = re.sub(r"<li>\s*", "\n  •  ", text)
    text = re.sub(r"</p>\s*", "\n\n", text)
    text = re.sub(r"<[^>]+>", "", text)
    return html.escape(html.unescape(text).strip(), quote=False)


PREFS = os.path.join(GLib.get_user_config_dir(), "mangos", "store.conf")


def prefer_flathub():
    try:
        return "prefer=flathub" in open(PREFS).read()
    except OSError:
        return False


def set_prefer_flathub(on):
    os.makedirs(os.path.dirname(PREFS), exist_ok=True)
    with open(PREFS, "w") as f:
        f.write("prefer=flathub\n" if on else "prefer=debian\n")


class Catalog:
    def __init__(self):
        self.pool = AS.Pool()
        self.apps = []
        self.by_pkg = {}
        self.flat, self.flat_alt, self.flat_only, self.flat_installed = {}, {}, [], set()
        self.installed = set()
        self.protected = set()
        self.reload()

    def reload(self):
        try:
            self.pool.load(None)
            box = self.pool.get_components()
            comps = [box.index_safe(i) for i in range(box.get_size())]
        except GLib.Error:
            comps = []
        seen, apps, flat = set(), [], {}
        for c in comps:
            if c.get_kind() != AS.ComponentKind.DESKTOP_APP:
                continue
            fid = flatpak_id(c)
            if fid:
                flat.setdefault(fid, c)
                continue
            if not c.get_pkgname() or c.get_pkgname() in seen:
                continue
            seen.add(c.get_pkgname())
            apps.append(c)
        apps.sort(key=lambda c: (c.get_name() or "").lower())
        self.apps = apps
        self.by_pkg = {c.get_pkgname(): c for c in apps}
        self.flat = flat                                   # Flathub apps by flatpak id
        names = {(c.get_name() or "").lower() for c in apps}
        ids = {c.get_id().removesuffix(".desktop") for c in apps}
        # the same app on Debian and on Flathub: Debian first, Flathub offered on its page
        self.flat_alt = {}
        self.deb_alt = {}                                  # flatpak id -> the Debian version
        by_name = {(c.get_name() or "").lower(): c for c in apps}
        by_id = {c.get_id().removesuffix(".desktop"): c for c in apps}
        for fid, c in flat.items():
            deb = by_id.get(fid) or by_name.get((c.get_name() or "").lower())
            if deb is not None:
                self.flat_alt[(c.get_name() or "").lower()] = c
                self.flat_alt[fid] = c
                self.deb_alt[fid] = deb
        self.flat_only = [c for fid, c in flat.items() if fid not in self.flat_alt]
        # one catalog: every Debian app plus the apps only Flathub has
        self.deb_apps = apps
        self.apps = sorted(apps + self.flat_only, key=lambda c: (c.get_name() or "").lower())
        self.refresh_installed()

    def flathub_enabled(self):
        out = subprocess.run(["flatpak", "remotes", "--system", "--columns=name"], capture_output=True,
                             text=True).stdout if shutil.which("flatpak") else ""
        return "flathub" in out.split()

    def is_installed(self, c):
        fid = flatpak_id(c)
        return fid in self.flat_installed if fid else c.get_pkgname() in self.installed

    def alternative(self, c):
        """The same app from the other source (Debian <-> Flathub), if any."""
        fid = flatpak_id(c)
        if fid:
            return self.deb_alt.get(fid)
        return self.flat_alt.get(c.get_id().removesuffix(".desktop")) or self.flat_alt.get((c.get_name() or "").lower())

    def pick(self, c):
        """The version to show: Debian (lighter) unless the user prefers the
        newer Flathub versions; an installed version always wins."""
        alt = self.alternative(c)
        if alt is None:
            return c
        if self.is_installed(c):
            return c
        if self.is_installed(alt):
            return alt
        flat_first = prefer_flathub()
        return (alt if flatpak_id(alt) else c) if flat_first else (c if not flatpak_id(c) else alt)

    def refresh_installed(self):
        out = subprocess.run(["dpkg-query", "-W", "-f=${Package} ${Status}\n"],
                             capture_output=True, text=True).stdout
        self.installed = {l.split()[0] for l in out.splitlines() if l.endswith("install ok installed")}
        deps = subprocess.run(["dpkg-query", "-W", "-f=${Depends}", "mangos-system"],
                              capture_output=True, text=True).stdout
        self.protected = {d.strip().split()[0] for d in deps.split(",") if d.strip()} | {"mangos-system"}
        self.flat_installed = set()
        if shutil.which("flatpak"):
            out = subprocess.run(["flatpak", "list", "--app", "--columns=application"],
                                 capture_output=True, text=True).stdout
            self.flat_installed = {l.strip() for l in out.splitlines() if l.strip()}

    def in_categories(self, cats, first=(), limit=150):
        res = [c for c in self.apps if set(c.get_categories()) & set(cats) and self.icon_file(c, 64)]
        top = [self.by_pkg[p] for p in first if p in self.by_pkg]
        rest = [c for c in res if c not in top]
        return (top + rest)[:limit]

    def search(self, text, limit=90):
        t = text.lower()
        res = [c for c in self.apps
               if t in (c.get_name() or "").lower() or t in (c.get_summary() or "").lower()
               or t in (c.get_pkgname() or flatpak_id(c) or "").lower()]
        res.sort(key=lambda c: (not (c.get_name() or "").lower().startswith(t), not self.icon_file(c, 64)))
        return res[:limit]

    @staticmethod
    def icon_file(c, size):
        best = None
        for ic in c.get_icons():
            if ic.get_kind() == AS.IconKind.CACHED and ic.get_filename() and os.path.exists(ic.get_filename()):
                if ic.get_width() >= size:
                    return ic.get_filename()
                best = ic.get_filename()
        return best

    @staticmethod
    def stock_icon(c):
        for ic in c.get_icons():
            if ic.get_kind() == AS.IconKind.STOCK and ic.get_name():
                return ic.get_name()
        return "application-x-executable"


def icon_pixbuf(c, size):
    f = Catalog.icon_file(c, size)
    if f:
        try:
            return GdkPixbuf.Pixbuf.new_from_file_at_scale(f, size * 2, size * 2, True)
        except GLib.Error:
            pass
    try:
        return Gtk.IconTheme.get_default().load_icon(Catalog.stock_icon(c), size * 2, 0)
    except GLib.Error:
        return Gtk.IconTheme.get_default().load_icon("application-x-executable", size * 2, 0)


def rounded(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def opaque_corners(pb):
    """True for icons that are already full squares (they get clipped, not framed)."""
    if not pb.get_has_alpha():
        return True
    w, h, rs, n = pb.get_width(), pb.get_height(), pb.get_rowstride(), pb.get_n_channels()
    px = pb.get_pixels()
    pts = [(int(w * .08), int(h * .5)), (int(w * .92), int(h * .5)), (int(w * .5), int(h * .08)), (int(w * .5), int(h * .92))]
    return all(px[y * rs + x * n + 3] > 230 for x, y in pts)


class Tile(Gtk.DrawingArea):
    """An app icon on a uniform rounded tile, like on the Mac."""
    def __init__(self, c, size, light=False):
        super().__init__()
        self.size = size
        self.light = light
        self.pb = icon_pixbuf(c, size)
        self.full = opaque_corners(self.pb)
        self.set_size_request(size, size)
        self.set_valign(Gtk.Align.CENTER)
        self.connect("draw", self.on_draw)

    def on_draw(self, w, cr):
        s = self.size
        r = s * 0.225
        fg = self.get_style_context().get_color(Gtk.StateFlags.NORMAL)
        dark = (fg.red + fg.green + fg.blue) / 3 > 0.6 and not self.light
        # soft shadow
        rounded(cr, 0.5, 1.5, s - 1, s - 1.5, r); cr.set_source_rgba(0, 0, 0, 0.10); cr.fill()
        rounded(cr, 0.5, 0.5, s - 1, s - 1.5, r)
        cr.save(); cr.clip_preserve()
        if self.full:
            pb = self.pb.scale_simple(s, s, GdkPixbuf.InterpType.BILINEAR)
            Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0); cr.paint()
        else:
            if dark:
                cr.set_source_rgb(0.23, 0.23, 0.25)
            else:
                g = cairo.LinearGradient(0, 0, 0, s); g.add_color_stop_rgb(0, 1, 1, 1); g.add_color_stop_rgb(1, .94, .94, .96)
                cr.set_source(g)
            cr.fill()
            inner = int(s * 0.72)
            pb = self.pb.scale_simple(inner, int(inner * self.pb.get_height() / max(1, self.pb.get_width())),
                                      GdkPixbuf.InterpType.BILINEAR)
            Gdk.cairo_set_source_pixbuf(cr, pb, (s - pb.get_width()) / 2, (s - pb.get_height()) / 2)
            cr.paint()
        cr.restore()
        rounded(cr, 0.5, 0.5, s - 1, s - 1.5, r)
        cr.set_source_rgba(0, 0, 0, 0.10 if not dark else 0.35); cr.set_line_width(1); cr.stroke()
        return False


def app_icon(c, size):
    return Tile(c, size)


class GetButton(Gtk.Button):
    """GET / OPEN pill; while installing, a progress ring with a stop square."""
    def __init__(self, c, style=None):
        super().__init__(valign=Gtk.Align.CENTER)
        self.app = c
        self.frac = None
        ctx = self.get_style_context(); ctx.add_class("store-get")
        if style:
            ctx.add_class(style)
        self.stack = Gtk.Stack()
        self.lab = Gtk.Label()
        self.ring = Gtk.DrawingArea(); self.ring.set_size_request(26, 26)
        self.ring.connect("draw", self.draw_ring)
        self.stack.add_named(self.lab, "label"); self.stack.add_named(self.ring, "ring")
        self.lab.show(); self.ring.show(); self.stack.show()   # a Stack only switches to shown children
        self.add(self.stack)

    def set_text(self, text):
        self.frac = None
        self.get_style_context().remove_class("ring")
        self.lab.set_text(text.upper())
        self.stack.set_visible_child_name("label")

    def set_progress(self, frac):
        self.frac = frac
        self.get_style_context().add_class("ring")
        self.stack.set_visible_child_name("ring")
        self.ring.queue_draw()

    def draw_ring(self, w, cr):
        size = min(w.get_allocated_width(), w.get_allocated_height())
        cx = w.get_allocated_width() / 2; cy = w.get_allocated_height() / 2; r = size / 2 - 2
        cr.set_line_width(2.4)
        cr.set_source_rgba(0.5, 0.5, 0.55, 0.35); cr.arc(cx, cy, r, 0, 2 * math.pi); cr.stroke()
        cr.set_source_rgb(0.04, 0.52, 1.0)
        f = self.frac or 0.0
        if f <= 0.01:      # waiting (password, download start): a spinning arc
            a = (time.monotonic() * 5) % (2 * math.pi)
            cr.arc(cx, cy, r, a, a + 1.3)
            GLib.timeout_add(40, lambda: (w.queue_draw(), False)[1])
        else:
            cr.arc(cx, cy, r, -math.pi / 2, -math.pi / 2 + 2 * math.pi * f)
        cr.stroke()
        cr.rectangle(cx - 3.5, cy - 3.5, 7, 7); cr.fill()
        return False


# ------------------------------------------------------- apps of the week
POPCON_URLS = ("https://popcon.debian.org/by_vote", "http://popcon.debian.org/by_vote")
POPCON_SNAPSHOT = "/usr/share/mangos/popcon-top.txt"   # taken when this MangOS build was made
WEEK_POOL = 15
WEEK_OK = {"Graphics", "AudioVideo", "Audio", "Video", "Office", "Game", "Education", "Science",
           "Development", "Network", "Finance"}
WEEK_NOT = {"Settings", "System", "FileManager", "TerminalEmulator", "Core", "DesktopSettings",
            "PackageManager", "Archiving", "Compression", "Monitor", "Security", "HardwareSettings"}


def parse_popcon(lines, max_rank=9000):
    names = []
    for line in lines:
        if line.startswith("#"):
            continue
        p = line.split()
        if len(p) < 2 or not p[0].isdigit():
            continue
        names.append(p[1])
        if int(p[0]) >= max_rank:
            break
    return names


def popcon_names():
    """Package names in popcon's order (most used first), refreshed weekly.
    Returns (names, source): 'live', 'cache' or 'snapshot'."""
    os.makedirs(CACHE, exist_ok=True)
    path = os.path.join(CACHE, "popcon.json")
    try:
        d = json.load(open(path))
        if time.time() - d["time"] < 7 * 86400 and len(d["names"]) > 100:
            return d["names"], "cache"
    except Exception:
        d = None
    errors = []
    for url in POPCON_URLS:
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "MangoStore/1.0 (MangOS)"})
            with urllib.request.urlopen(req, timeout=30) as r:
                names = parse_popcon(raw.decode("utf-8", "replace") for raw in r)
            if len(names) > 100:
                json.dump({"time": time.time(), "names": names}, open(path, "w"))
                return names, "live"
            errors.append(f"{url}: only {len(names)} names")
        except Exception as e:
            errors.append(f"{url}: {e!r}")
    try:
        with open(os.path.join(CACHE, "popcon.log"), "w") as log:
            log.write(time.strftime("%Y-%m-%d %H:%M ") + "\n".join(errors) + "\n")
    except OSError:
        pass
    if d and d.get("names"):
        return d["names"], "cache"        # stale is better than nothing
    try:
        with open(POPCON_SNAPSHOT) as f:
            names = parse_popcon(f)
        if names:
            return names, "snapshot"
    except OSError:
        pass
    return [], None


def weekly_picks(cat, names):
    """Three most-used desktop apps you do not have yet; a new trio each week."""
    pool, families = [], set()
    for n in names:
        c = cat.by_pkg.get(n)
        if not c or n in cat.installed or n in cat.protected or not cat.icon_file(c, 64):
            continue
        # MangOS has no LibreOffice by design (ArtCraft instead), and one app
        # per suite is enough (not Calc, Draw and Impress in the same week).
        family = re.split(r"[-.]", n)[0]
        if n.startswith("libreoffice") or family in families:
            continue
        # apps people choose, not desktop plumbing (settings, file managers,
        # archivers, terminals: every Debian desktop has them, MangOS too)
        cats = set(c.get_categories())
        if cats & WEEK_NOT or not cats & WEEK_OK:
            continue
        families.add(family)
        pool.append(c)
        if len(pool) >= WEEK_POOL:
            break
    if not pool:
        pool = [cat.by_pkg[p] for p in FEATURED["essentials"] if p in cat.by_pkg and p not in cat.installed]
    if not pool:
        return []
    week = datetime.date.today().isocalendar()[1]
    start = (week * 3) % len(pool)
    return [(pool + pool)[start + i] for i in range(min(3, len(pool)))]


def flathub_popular():
    """Flathub app ids by downloads in the last month (cached for a day)."""
    path = os.path.join(CACHE, "flathub-popular.json")
    try:
        d = json.load(open(path))
        if time.time() - d["time"] < 86400 and d["ids"]:
            return d["ids"], True
    except Exception:
        d = None
    try:
        req = urllib.request.Request(FLATHUB_POPULAR, headers={"User-Agent": "MangoStore/1.0 (MangOS)"})
        with urllib.request.urlopen(req, timeout=20) as r:
            ids = [h["app_id"] for h in json.load(r).get("hits", []) if h.get("app_id")]
        if ids:
            os.makedirs(CACHE, exist_ok=True)
            json.dump({"time": time.time(), "ids": ids}, open(path, "w"))
            return ids, True
    except Exception:
        pass
    if d and d.get("ids"):
        return d["ids"], True
    return FLATHUB_FALLBACK, False


class Store(Gtk.Window):
    def __init__(self):
        super().__init__(title="Mango Store")
        self.set_default_size(1080, 720)
        self.set_icon_name("mangos-store")
        self.set_position(Gtk.WindowPosition.CENTER)
        self.cat = Catalog()
        threading.Thread(target=appweight.machine, daemon=True).start()   # glxinfo, once per boot
        self.busy = False
        self.buttons = {}   # pkgname -> list of Get buttons to refresh
        prov = Gtk.CssProvider(); prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov, 801)

        root = Gtk.Box(); self.add(root)
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        side.set_size_request(220, -1); side.get_style_context().add_class("store-sidebar")
        root.pack_start(side, False, False, 0)
        brand = Gtk.Box(spacing=8, margin_start=16, margin_top=16, margin_bottom=2)
        try:
            logo = Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_scale(
                "/usr/share/mangos/logo/mangos-logo.svg", 30, 30, True))
        except GLib.Error:
            logo = Gtk.Image.new_from_icon_name("mangos-logo", Gtk.IconSize.LARGE_TOOLBAR)
        brand.pack_start(logo, False, False, 0)
        bl = Gtk.Label(label="Mango Store", xalign=0); bl.get_style_context().add_class("store-brand")
        brand.pack_start(bl, False, False, 0)
        side.pack_start(brand, False, False, 0)
        self.search = Gtk.SearchEntry(placeholder_text=tr("Search", "Cerca"), margin=12, margin_bottom=4)
        self.search.connect("search-changed", self.on_search)
        side.pack_start(self.search, False, False, 0)
        self.menu = Gtk.ListBox(); self.menu.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.menu.get_style_context().add_class("store-sidebar")
        for sid, en, it, icon, _ in SECTIONS:
            row = Gtk.ListBoxRow(); row.sid = sid
            b = Gtk.Box(spacing=10)
            b.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU), False, False, 0)
            b.pack_start(Gtk.Label(label=tr(en, it), xalign=0), True, True, 0)
            row.add(b); self.menu.add(row)
        self.menu.connect("row-selected", self.on_section)
        side.pack_start(self.menu, False, False, 0)
        # all Debian and Flathub apps are in one catalog; this picks the default
        pref = Gtk.Box(spacing=8, margin=14, valign=Gtk.Align.END)
        pl = Gtk.Label(label=tr("Prefer the newest versions (Flathub)", "Preferisci le versioni più recenti (Flathub)"),
                       xalign=0, wrap=True, max_width_chars=18)
        pl.get_style_context().add_class("store-dim")
        ps = Gtk.Switch(active=prefer_flathub(), valign=Gtk.Align.CENTER)
        ps.connect("notify::active", lambda w, _p: (set_prefer_flathub(w.get_active()),
                                                    self.on_section(self.menu, self.menu.get_selected_row())))
        pref.pack_start(pl, True, True, 0); pref.pack_end(ps, False, False, 0)
        side.pack_end(pref, False, False, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); root.pack_start(right, True, True, 0)
        self.progress = Gtk.ProgressBar(no_show_all=True); right.pack_start(self.progress, False, False, 0)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=150)
        right.pack_start(self.stack, True, True, 0)
        self.history = []
        self.connect("destroy", Gtk.main_quit)
        self.menu.select_row(self.menu.get_row_at_index(0))

    # ------------------------------------------------------------ pages
    def page(self, widget, name):
        old = self.stack.get_child_by_name(name)
        if old:
            self.stack.remove(old)
        sc = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        sc.add(widget); sc.show_all()
        self.stack.add_named(sc, name); self.stack.set_visible_child_name(name)

    def column(self):
        return Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin=30, margin_top=24)

    def header(self, box, title, subtitle=None):
        t = Gtk.Label(label=title, xalign=0); t.get_style_context().add_class("store-title")
        box.pack_start(t, False, False, 0)
        if subtitle:
            s = Gtk.Label(label=subtitle, xalign=0); s.get_style_context().add_class("store-subtitle")
            box.pack_start(s, False, False, 0)

    def empty_catalog(self, box):
        lab = Gtk.Label(wrap=True, xalign=0, label=tr(
            "The app catalog has not been downloaded yet. It needs an internet connection.",
            "Il catalogo delle app non è ancora stato scaricato. Serve una connessione a internet."))
        box.pack_start(lab, False, False, 0)
        b = Gtk.Button(label=tr("Download the catalog", "Scarica il catalogo"), halign=Gtk.Align.START)
        b.get_style_context().add_class("store-get"); b.get_style_context().add_class("primary")
        b.connect("clicked", lambda *_: self.run_helper(["refresh"], self.after_refresh))
        box.pack_start(b, False, False, 0)

    def grid(self, apps, ranked=False):
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                           min_children_per_line=1, max_children_per_line=3,
                           column_spacing=26, row_spacing=0)
        for i, c in enumerate(apps):
            flow.add(self.app_row(self.cat.pick(c), i + 1 if ranked else None))
        return flow

    def app_row(self, c, rank=None):
        ev = Gtk.EventBox(); row = Gtk.Box(spacing=12); row.get_style_context().add_class("store-row")
        ev.add(row); ev.set_size_request(250, -1)
        row.pack_start(app_icon(c, 60), False, False, 0)
        if rank:
            rl = Gtk.Label(label=str(rank)); rl.get_style_context().add_class("store-rank")
            row.pack_start(rl, False, False, 0)
        txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        n = Gtk.Label(label=c.get_name(), xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=22)
        n.get_style_context().add_class("store-name")
        s = Gtk.Label(label=c.get_summary() or "", xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=26)
        s.get_style_context().add_class("store-dim")
        txt.pack_start(n, False, False, 0); txt.pack_start(s, False, False, 0)
        if self.incompatible(c):
            f = Gtk.Label(label=tr("Not compatible with this Mac", "Non compatibile con questo Mac"), xalign=0)
            f.get_style_context().add_class("store-badge"); f.get_style_context().add_class("bad")
            txt.pack_start(f, False, False, 0)
        elif flatpak_id(c):
            f = Gtk.Label(label="Flathub", xalign=0); f.get_style_context().add_class("store-badge")
            txt.pack_start(f, False, False, 0)
        row.pack_start(txt, True, True, 0)
        row.pack_end(self.get_button(c), False, False, 0)
        ev.connect("button-press-event", lambda *_: self.show_app(c))
        return ev

    def get_button(self, c, primary=False, style=None):
        b = GetButton(c, "primary" if primary else style)
        b.connect("clicked", self.on_get)
        self.buttons.setdefault(app_key(c), []).append(b)
        self.update_button(b)
        return b

    def update_button(self, b):
        if b.frac is not None and self.busy:
            return
        if b.app is None:
            return
        inst = self.cat.is_installed(b.app)
        b.set_text(tr("Open", "Apri") if inst else tr("Get", "Ottieni"))
        b.set_sensitive(not self.busy or inst)

    def refresh_buttons(self):
        for lst in self.buttons.values():
            for b in lst:
                self.update_button(b)

    # ------------------------------------------------------------ sections
    def on_section(self, _lb, row):
        if not row:
            return
        self.search.set_text("")
        self.buttons = {}
        sec = next(s for s in SECTIONS if s[0] == row.sid)
        if row.sid == "discover":
            self.show_discover()
        elif row.sid == "updates":
            self.show_updates()
        else:
            box = self.column(); self.header(box, tr(sec[1], sec[2]))
            if not self.cat.apps:
                self.empty_catalog(box)
            else:
                box.pack_start(self.grid(self.cat.in_categories(sec[4], POPULAR.get(row.sid, ()))), False, False, 0)
            self.page(box, row.sid)

    def show_discover(self):
        box = self.column()
        self.header(box, tr("Discover", "Scopri"),
                    GLib.DateTime.new_now_local().format("%A %e %B").strip().upper())
        box.pack_start(self.carousel(), False, False, 4)
        if not self.cat.apps:
            self.empty_catalog(box); self.page(box, "discover"); return
        self.week_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.pack_start(self.week_box, False, False, 0)
        if not self.cat.flat and shutil.which("flatpak"):
            note = Gtk.Box(spacing=12, margin_top=8)
            nl = Gtk.Label(xalign=0, wrap=True, label=tr(
                "The Flathub apps (Spotify, Discord, OBS and thousands more) appear here once their catalog is downloaded.",
                "Le app di Flathub (Spotify, Discord, OBS e migliaia di altre) compaiono qui appena ne scarichi il catalogo."))
            nl.get_style_context().add_class("store-dim")
            nb = GetButton(None, "primary"); nb.set_text(tr("Download", "Scarica"))
            nb.connect("clicked", lambda _b: self.run_helper(["refresh"], self.after_refresh, button=_b))
            note.pack_start(nl, True, True, 0); note.pack_end(nb, False, False, 0)
            box.pack_start(note, False, False, 0)
        self.flat_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.pack_start(self.flat_box, False, False, 0)
        for key, en, it in (("essentials", "Essential apps", "App essenziali"), ("play", "Games to try", "Giochi da provare")):
            apps = [self.cat.by_pkg[p] for p in FEATURED[key] if p in self.cat.by_pkg]
            if not apps:
                continue
            t = Gtk.Label(label=tr(en, it), xalign=0, margin_top=14); t.get_style_context().add_class("store-section")
            box.pack_start(t, False, False, 0); box.pack_start(self.grid(apps[:12]), False, False, 0)
        self.page(box, "discover")

        token = object()          # only the latest Discover page gets the result
        self.week_token = token

        def work():
            names, _src = popcon_names()
            GLib.idle_add(self.show_week, weekly_picks(self.cat, names), bool(names), token)
            if self.cat.flat:
                ids, live = flathub_popular()
                GLib.idle_add(self.show_flat_top, ids, live, token)
        threading.Thread(target=work, daemon=True).start()

    # ---- sliding banner: ArtCraft + the apps of the week
    def carousel(self):
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        overlay = Gtk.Overlay()
        self.slides = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT,
                                transition_duration=450, hhomogeneous=True, vhomogeneous=True)
        overlay.add(self.slides)
        for icon, step, align in (("go-previous-symbolic", -1, Gtk.Align.START), ("go-next-symbolic", 1, Gtk.Align.END)):
            b = Gtk.Button.new_from_icon_name(icon, Gtk.IconSize.BUTTON)
            b.get_style_context().add_class("store-arrow")
            b.set_halign(align); b.set_valign(Gtk.Align.CENTER); b.set_margin_start(8); b.set_margin_end(8)
            b.connect("clicked", lambda _b, st=step: self.slide(st, user=True))
            overlay.add_overlay(b)
        outer.pack_start(overlay, False, False, 0)
        self.dots = Gtk.Box(spacing=6, halign=Gtk.Align.CENTER)
        outer.pack_start(self.dots, False, False, 0)
        self.slide_names = []
        self.add_slide("artcraft", "hero-artcraft", tr("FROM MANGOS", "DA MANGOS"),
                       tr("ArtCraft: the creative apps", "ArtCraft: le app creative"),
                       tr("WordCraft, PdfCraft and PhotoCraft are already on your Mac. Get the rest of the suite from the ArtCraft launcher.",
                          "WordCraft, PdfCraft e PhotoCraft sono già sul tuo Mac. Il resto della suite è nel launcher ArtCraft."),
                       Gtk.Image.new_from_icon_name(
                           next((n for n in ("artcraft-launcher", "artcraft", "mangos-logo")
                                 if Gtk.IconTheme.get_default().has_icon(n)), "mangos-logo"), Gtk.IconSize.DIALOG),
                       lambda *_: subprocess.Popen(["mangos-open-artcraft"]))
        ev = Gtk.EventBox(); ev.add(outer)
        self.banner = ev
        if getattr(self, "slide_timer", None):
            GLib.source_remove(self.slide_timer)
        self.slide_timer = GLib.timeout_add_seconds(6, self.auto_slide)
        return ev

    def add_slide(self, name, style, kicker, title, text, image, action, button=None):
        hero = Gtk.Box(spacing=24); hero.get_style_context().add_class("store-hero"); hero.get_style_context().add_class(style)
        txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, valign=Gtk.Align.CENTER, margin_start=26)
        k = Gtk.Label(label=kicker, xalign=0); k.get_style_context().add_class("store-hero-kicker")
        t = Gtk.Label(label=title, xalign=0, wrap=True); t.get_style_context().add_class("store-hero-title")
        d = Gtk.Label(label=text, xalign=0, wrap=True, max_width_chars=60, lines=2,
                      ellipsize=Pango.EllipsizeMode.END); d.get_style_context().add_class("store-hero-text")
        for w in (k, t, d):
            txt.pack_start(w, False, False, 0)
        if button is None:
            button = Gtk.Button(label=tr("Open", "Apri").upper(), halign=Gtk.Align.START)
            button.get_style_context().add_class("hero-open")
            button.connect("clicked", action)
        else:
            button.set_halign(Gtk.Align.START)
        txt.pack_start(button, False, False, 8)
        hero.pack_start(txt, True, True, 0)
        if isinstance(image, Gtk.Image):
            image.set_pixel_size(120)
        image.set_margin_end(40)
        hero.pack_end(image, False, False, 0)
        if action:
            ev = Gtk.EventBox(); ev.add(hero)
        else:
            ev = hero
        self.slides.add_named(ev, name); ev.show_all()
        self.slide_names.append(name)
        dot = Gtk.Button(); dot.get_style_context().add_class("store-dot")
        dot.connect("clicked", lambda *_: self.show_slide(name, user=True))
        self.dots.pack_start(dot, False, False, 0); dot.show()
        self.mark_dot()

    def mark_dot(self):
        cur = self.slides.get_visible_child_name()
        for n, d in zip(self.slide_names, self.dots.get_children()):
            (d.get_style_context().add_class if n == cur else d.get_style_context().remove_class)("active")

    def show_slide(self, name, user=False):
        self.slides.set_visible_child_name(name)
        if user:
            self.last_user_slide = time.monotonic()
        self.mark_dot()

    def slide(self, step, user=False):
        if not self.slide_names:
            return
        cur = self.slides.get_visible_child_name()
        i = self.slide_names.index(cur) if cur in self.slide_names else 0
        nxt = self.slide_names[(i + step) % len(self.slide_names)]
        self.slides.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT if step > 0
                                        else Gtk.StackTransitionType.SLIDE_RIGHT)
        self.show_slide(nxt, user)

    def auto_slide(self):
        if self.slides.get_toplevel() is not self or not self.slides.get_mapped():
            return self.slides.get_toplevel() is self
        if not self.pointer_on_banner() and time.monotonic() - getattr(self, "last_user_slide", 0) > 10:
            self.slide(1)
        return True

    def pointer_on_banner(self):
        """Pause while the pointer rests on the banner (checked, not tracked:
        crossing events are unreliable when the window maps under it)."""
        win = self.banner.get_window()
        if win is None:
            return False
        _s, px, py = Gdk.Display.get_default().get_default_seat().get_pointer().get_position()
        _ok, ox, oy = win.get_origin()
        a = self.banner.get_allocation()
        if self.banner.get_has_window():
            a.x = a.y = 0
        return ox + a.x <= px < ox + a.x + a.width and oy + a.y <= py < oy + a.y + a.height

    def show_flat_top(self, ids, live, token):
        if token is not getattr(self, "week_token", None) or self.flat_box.get_toplevel() is not self:
            return False
        apps = [self.cat.flat[i] for i in ids if i in self.cat.flat and i not in FLATHUB_SKIP][:9]
        if not apps:
            return False
        t = Gtk.Label(label=tr("Most downloaded this month", "Le più scaricate del mese"), xalign=0, margin_top=14)
        t.get_style_context().add_class("store-section")
        sub = Gtk.Label(xalign=0, label=tr("Downloads in the last 30 days on Flathub.",
                                           "Download degli ultimi 30 giorni su Flathub.") if live else
                        tr("Popular on Flathub.", "Popolari su Flathub."))
        sub.get_style_context().add_class("store-dim")
        self.flat_box.pack_start(t, False, False, 0); self.flat_box.pack_start(sub, False, False, 0)
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True, min_children_per_line=1,
                           max_children_per_line=3, column_spacing=26, row_spacing=0)
        for i, c in enumerate(apps):          # Flathub's numbers: its versions, unless Debian's is installed
            alt = self.cat.alternative(c)
            flow.add(self.app_row(alt if alt is not None and self.cat.is_installed(alt) else c, i + 1))
        self.flat_box.pack_start(flow, False, False, 0); self.flat_box.show_all()
        return False

    def show_week(self, picks, from_popcon, token=None):
        if token is not getattr(self, "week_token", None):
            return False
        if not picks or not getattr(self, "week_box", None) or self.week_box.get_toplevel() is not self:
            return False
        if "week0" in self.slide_names:
            return False
        for i, c in enumerate(picks):
            self.add_slide(f"week{i}", f"hero-week{i + 1}",
                           tr("APP OF THE WEEK", "APP DELLA SETTIMANA") + f"  ·  {i + 1}/3",
                           c.get_name(), c.get_summary() or "", Tile(c, 120, light=True),
                           lambda *_a, app=c: self.show_app(app),
                           button=self.get_button(c, style="light"))
        t = Gtk.Label(label=tr("Apps of the week", "App della settimana"), xalign=0, margin_top=14)
        t.get_style_context().add_class("store-section")
        sub = Gtk.Label(xalign=0, label=tr(
            "Among the most used by Debian users (Debian Popularity Contest), and not on your Mac yet.",
            "Tra le più usate dagli utenti Debian (Debian Popularity Contest) e non ancora sul tuo Mac.")
            if from_popcon else tr("Suggested apps (popularity data not reachable right now).",
                                   "App suggerite (dati di popolarità non raggiungibili ora)."))
        sub.get_style_context().add_class("store-dim")
        self.week_box.pack_start(t, False, False, 0); self.week_box.pack_start(sub, False, False, 0)
        self.week_box.pack_start(self.grid(picks, ranked=True), False, False, 0)
        self.week_box.show_all()
        return False

    def on_search(self, entry):
        text = entry.get_text().strip()
        if not text:
            row = self.menu.get_selected_row()
            if row:
                self.on_section(self.menu, row)
            return
        self.buttons = {}
        box = self.column(); self.header(box, tr("Results for “%s”", "Risultati per “%s”") % text)
        res = self.cat.search(text)
        if res:
            box.pack_start(self.grid(res), False, False, 0)
        else:
            box.pack_start(Gtk.Label(label=tr("No apps found.", "Nessuna app trovata."), xalign=0), False, False, 0)
        self.page(box, "search")

    # ------------------------------------------------------------ app page
    def show_app(self, c):
        self.buttons = {}
        box = self.column()
        back = Gtk.Button(label="‹ " + tr("Back", "Indietro"), halign=Gtk.Align.START)
        back.get_style_context().add_class("store-back")
        back.connect("clicked", lambda *_: self.on_section(self.menu, self.menu.get_selected_row()))
        box.pack_start(back, False, False, 0)
        top = Gtk.Box(spacing=22); box.pack_start(top, False, False, 0)
        top.pack_start(app_icon(c, 128), False, False, 0)
        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, valign=Gtk.Align.CENTER)
        n = Gtk.Label(label=c.get_name(), xalign=0, wrap=True); n.get_style_context().add_class("store-big-name")
        s = Gtk.Label(label=c.get_summary() or "", xalign=0, wrap=True); s.get_style_context().add_class("store-subtitle")
        dev = c.get_developer().get_name() if c.get_developer() else ""
        d = Gtk.Label(label=dev, xalign=0); d.get_style_context().add_class("store-dim")
        info.pack_start(n, False, False, 0); info.pack_start(s, False, False, 0); info.pack_start(d, False, False, 0)
        acts = Gtk.Box(spacing=10, margin_top=10)
        acts.pack_start(self.get_button(c, primary=True), False, False, 0)
        pkg = c.get_pkgname()
        fid = flatpak_id(c)
        if self.cat.is_installed(c) and (fid or pkg not in self.cat.protected):
            rm = Gtk.Button(label=tr("Remove", "Rimuovi")); rm.get_style_context().add_class("store-get")
            rm.connect("clicked", lambda *_: self.confirm_remove(c))
            acts.pack_start(rm, False, False, 0)
        info.pack_start(acts, False, False, 0)
        src = Gtk.Label(xalign=0, margin_top=6)
        src.get_style_context().add_class("store-dim")
        alt = self.cat.alternative(c)
        if fid:
            src.set_text(tr("From Flathub · runs in a sandbox, updated by its developers",
                            "Da Flathub · gira in un ambiente protetto, aggiornata dagli sviluppatori"))
        else:
            src.set_text(tr("From Debian · checked and kept up to date by Debian",
                            "Da Debian · controllata e aggiornata da Debian"))
        info.pack_start(src, False, False, 0)
        if alt is not None:
            # same app from both sources: a switch, like a Mac app with two versions
            sw = Gtk.Box(halign=Gtk.Align.START, margin_top=6)
            sw.get_style_context().add_class("linked")
            deb, flat = (alt, c) if fid else (c, alt)
            for comp, label in ((deb, tr("Debian (lighter)", "Debian (più leggera)")),
                                (flat, tr("Flathub (newer)", "Flathub (più recente)"))):
                b = Gtk.ToggleButton(label=label, active=comp is c)
                b.get_style_context().add_class("store-source")
                if comp is not c:
                    b.connect("toggled", lambda _b, other=comp: self.show_app(other))
                else:
                    b.connect("toggled", lambda _b: _b.set_active(True))
                sw.pack_start(b, False, False, 0)
            lab = Gtk.Label(label=tr("Source", "Fonte"), xalign=0, margin_top=8)
            lab.get_style_context().add_class("store-info-key")
            info.pack_start(lab, False, False, 0)
            info.pack_start(sw, False, False, 0)
        top.pack_start(info, True, True, 0)

        why = self.incompatible(c)
        if why:
            warn = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin_top=6)
            warn.get_style_context().add_class("store-warn")
            wt = Gtk.Label(label=tr("Not compatible with this Mac", "Non compatibile con questo Mac"), xalign=0)
            wt.get_style_context().add_class("store-warn-title")
            wd = Gtk.Label(label=why, xalign=0, wrap=True)
            warn.pack_start(wt, False, False, 0); warn.pack_start(wd, False, False, 0)
            box.pack_start(warn, False, False, 0)

        facts = Gtk.Box(spacing=0, margin_top=8)
        fields = {} if fid else self.apt_fields(pkg)
        w = appweight.weight(fid if fid else pkg, fields, flatpak=bool(fid))
        wlabel, wexplain = appweight.describe(w, tr)
        for k, v, cls, tip in [(tr("On this Mac", "Su questo Mac"), "● " + wlabel, "store-weight-" + w, wexplain)] + \
                [(k, v, None, None) for k, v in self.package_facts(pkg, c, fields)]:
            fb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            fb.get_style_context().add_class("store-fact")
            a = Gtk.Label(label=k.upper()); a.get_style_context().add_class("store-info-key")
            b = Gtk.Label(label=v); b.get_style_context().add_class("store-info-val")
            if cls:
                b.get_style_context().add_class(cls)
            if tip:
                fb.set_tooltip_text(tip)
            fb.pack_start(a, False, False, 0); fb.pack_start(b, False, False, 0)
            facts.pack_start(fb, False, False, 0)
        box.pack_start(facts, False, False, 0)
        box.pack_start(Gtk.Separator(), False, False, 4)

        shots = Gtk.Box(spacing=14)
        sw = Gtk.ScrolledWindow(vscrollbar_policy=Gtk.PolicyType.NEVER, min_content_height=10)
        sw.add(shots); box.pack_start(sw, False, False, 0)
        self.load_screenshots(c, shots, sw)

        desc = Gtk.Label(xalign=0, wrap=True, selectable=True, max_width_chars=90)
        desc.set_markup(markup_from_appstream(c.get_description()))
        box.pack_start(desc, False, False, 0)
        self.page(box, "app")

    def incompatible(self, c):
        """Why the app cannot run on this Mac (None if it can, or we do not know)."""
        fid = flatpak_id(c)
        return appweight.problem(fid if fid else c.get_pkgname(), tr)

    def apt_fields(self, pkg):
        if not pkg:
            return {}
        out = subprocess.run(["apt-cache", "show", "--no-all-versions", pkg], capture_output=True, text=True).stdout
        return dict(re.findall(r"^(Version|Installed-Size|Section|Depends|Pre-Depends): (.*)$", out, re.M))

    def package_facts(self, pkg, c, fields=None):
        if flatpak_id(c):
            facts = [(tr("Source", "Fonte"), "Flathub")]
            rel = c.get_releases_plain().get_entries() if hasattr(c, "get_releases_plain") else []
            if rel:
                facts.append((tr("Version", "Versione"), (rel[0].get_version() or "")[:18]))
            cats = [x for x in c.get_categories() if x in CATEGORY_NAMES]
            if cats:
                facts.append((tr("Category", "Categoria"), tr(*CATEGORY_NAMES[cats[0]])))
            lic = c.get_project_license()
            if lic:
                facts.append((tr("License", "Licenza"), "LicenseRef" in lic and tr("Proprietary", "Proprietaria")
                              or lic.split(" ")[0][:20]))
            return facts
        f = fields if fields is not None else self.apt_fields(pkg)
        facts = []
        if "Installed-Size" in f:
            kb = int(f["Installed-Size"])
            facts.append((tr("Size", "Dimensioni"), "%.0f MB" % (kb / 1024) if kb >= 1024 else "%d KB" % kb))
        if "Version" in f:
            facts.append((tr("Version", "Versione"), f["Version"].split("-")[0].split(":")[-1]))
        cats = [x for x in c.get_categories() if x not in ("GTK", "Qt", "KDE", "GNOME")]
        named = [CATEGORY_NAMES[x] for x in cats if x in CATEGORY_NAMES]
        if named:
            facts.append((tr("Category", "Categoria"), tr(*named[0])))
        lic = c.get_project_license()
        if lic:
            facts.append((tr("License", "Licenza"), lic.split(" ")[0][:20]))
        return facts

    def load_screenshots(self, c, box, sw):
        urls = []
        for shot in c.get_screenshots_all()[:4]:
            imgs = shot.get_images()
            best = None
            for im in imgs:
                if im.get_kind() == AS.ImageKind.THUMBNAIL and 300 <= im.get_width() <= 760:
                    best = im
            best = best or (imgs[0] if imgs else None)
            if best and best.get_url():
                urls.append(best.get_url())
        if not urls:
            sw.hide(); return

        def work():
            os.makedirs(CACHE, exist_ok=True)
            for u in urls:
                path = os.path.join(CACHE, re.sub(r"[^A-Za-z0-9._-]", "_", u)[-120:])
                try:
                    if not os.path.exists(path):
                        with urllib.request.urlopen(u, timeout=15) as r, open(path, "wb") as f:
                            f.write(r.read(4_000_000))
                    GLib.idle_add(add, path)
                except Exception:
                    pass

        def add(path):
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, -1, 260, True)
                img = Gtk.Image.new_from_pixbuf(pb); img.get_style_context().add_class("store-shot")
                box.pack_start(img, False, False, 0); img.show(); sw.set_min_content_height(270)
            except GLib.Error:
                pass
            return False
        threading.Thread(target=work, daemon=True).start()

    # ------------------------------------------------------------ updates
    def show_updates(self):
        box = self.column(); self.header(box, tr("Updates", "Aggiornamenti"))
        status = Gtk.Label(label=tr("Checking…", "Controllo in corso…"), xalign=0)
        box.pack_start(status, False, False, 0)
        listbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); box.pack_start(listbox, False, False, 0)
        allb = Gtk.Button(label=tr("Update All", "Aggiorna tutto"), halign=Gtk.Align.START, no_show_all=True)
        allb.get_style_context().add_class("store-get"); allb.get_style_context().add_class("primary")
        allb.connect("clicked", lambda *_: self.run_helper(["upgrade"], lambda ok: self.show_updates()))
        box.pack_start(allb, False, False, 6)
        self.page(box, "updates")

        def work():
            mangos = subprocess.run(["/usr/lib/mangos/mangos-updater", "check"], capture_output=True, text=True)
            apt = subprocess.run(["apt", "list", "--upgradable"], capture_output=True, text=True,
                                 env=dict(os.environ, LANG="C")).stdout
            pk = [l.split("/")[0] for l in apt.splitlines() if "/" in l and "upgradable" in l]
            if shutil.which("flatpak"):
                fl = subprocess.run(["flatpak", "remote-ls", "--updates", "--app", "--columns=application"],
                                    capture_output=True, text=True).stdout
                pk += ["flatpak:" + l.strip() for l in fl.splitlines() if l.strip()]
            GLib.idle_add(done, mangos.returncode, mangos.stdout.strip(), pk)

        def done(rc, msg, pk):
            items = []   # (icon widget, name, subtitle)
            if rc == 10:
                im = Gtk.Image.new_from_icon_name("mangos-logo", Gtk.IconSize.DND); im.set_pixel_size(44)
                items.append((im, "MangOS", tr("New version ", "Nuova versione ") + msg.split("->")[-1].strip()))
            for p in pk:
                c = self.cat.flat.get(p[8:]) if p.startswith("flatpak:") else self.cat.by_pkg.get(p)
                if c:
                    items.append((app_icon(c, 44), c.get_name(), c.get_summary() or p))
                else:
                    im = Gtk.Image.new_from_icon_name("package-x-generic", Gtk.IconSize.DND); im.set_pixel_size(44)
                    items.append((im, p, tr("System component", "Componente di sistema")))
            if rc == 2:
                warn = Gtk.Label(xalign=0, wrap=True, label=tr(
                    "Cannot reach the MangOS update server (not set up yet, or no connection).",
                    "Non riesco a raggiungere il server degli aggiornamenti di MangOS (non ancora configurato o connessione assente)."))
                warn.get_style_context().add_class("store-dim")
                listbox.pack_start(warn, False, False, 4); warn.show()
            if not items:
                status.set_text(tr("Your apps are up to date.", "Le tue app sono aggiornate.") if rc == 2 else
                                tr("MangOS and your apps are up to date.", "MangOS e le tue app sono aggiornati."))
                return False
            status.set_text(tr("%d updates available", "%d aggiornamenti disponibili") % len(items))
            for im, name, sub in items[:80]:
                r = Gtk.Box(spacing=12); r.get_style_context().add_class("store-row")
                r.pack_start(im, False, False, 0)
                t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
                a = Gtk.Label(label=name, xalign=0); a.get_style_context().add_class("store-name")
                b = Gtk.Label(label=sub, xalign=0, ellipsize=Pango.EllipsizeMode.END); b.get_style_context().add_class("store-dim")
                t.pack_start(a, False, False, 0); t.pack_start(b, False, False, 0)
                r.pack_start(t, True, True, 0); listbox.pack_start(r, False, False, 0)
            listbox.show_all(); allb.show()
            return False
        threading.Thread(target=work, daemon=True).start()

    # ------------------------------------------------------------ actions
    def on_get(self, b):
        c = b.app
        if self.cat.is_installed(c):
            self.launch(c); return
        fid = flatpak_id(c)
        why = self.incompatible(c)
        if why:
            d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                  buttons=Gtk.ButtonsType.NONE,
                                  text=tr("“%s” will probably not work on this Mac", "“%s” probabilmente non funzionerà su questo Mac") % c.get_name())
            d.format_secondary_text(why)
            d.add_buttons(tr("Cancel", "Annulla"), Gtk.ResponseType.CANCEL,
                          tr("Install Anyway", "Installa comunque"), Gtk.ResponseType.OK)
            ok = d.run() == Gtk.ResponseType.OK
            d.destroy()
            if not ok:
                return
        if fid:
            self.run_helper(["flatpak-install", fid], lambda ok: self.after_change(c, ok), button=b)
        else:
            self.run_helper(["install", c.get_pkgname()], lambda ok: self.after_change(c, ok), button=b)

    def launch(self, c):
        fid = flatpak_id(c)
        if fid:
            subprocess.Popen(["flatpak", "run", fid]); return
        lid = None
        la = c.get_launchable(AS.LaunchableKind.DESKTOP_ID)
        if la and la.get_entries():
            lid = la.get_entries()[0]
        for cand in filter(None, [lid, c.get_id(), c.get_id() + ".desktop"]):
            try:
                info = Gio.DesktopAppInfo.new(cand)
            except TypeError:
                info = None
            if info:
                info.launch([], None); return
        subprocess.Popen(["mangos-launchpad"])

    def confirm_remove(self, c):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                              buttons=Gtk.ButtonsType.NONE,
                              text=tr("Remove “%s”?", "Rimuovere “%s”?") % c.get_name())
        d.add_button(tr("Cancel", "Annulla"), Gtk.ResponseType.CANCEL)
        d.add_button(tr("Remove", "Rimuovi"), Gtk.ResponseType.OK)
        if d.run() == Gtk.ResponseType.OK:
            fid = flatpak_id(c)
            self.run_helper(["flatpak-remove", fid] if fid else ["remove", c.get_pkgname()],
                            lambda ok: self.after_change(c, ok))
        d.destroy()

    def after_change(self, c, ok):
        self.cat.refresh_installed()
        if self.stack.get_visible_child_name() == "app":
            self.show_app(c)
        else:
            self.refresh_buttons()

    def after_refresh(self, ok):
        self.cat.reload()
        self.on_section(self.menu, self.menu.get_selected_row())

    def run_helper(self, args, done, button=None):
        if self.busy:
            return
        self.busy = True; self.refresh_buttons()
        self.progress.set_fraction(0); self.progress.show()
        if button:
            button.set_progress(0.0)
        proc = Gio.Subprocess.new(["pkexec", HELPER] + args,
                                  Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
        stream = Gio.DataInputStream.new(proc.get_stdout_pipe())
        log = []

        def read_line(src, res):
            line, _ = src.read_line_finish_utf8(res)
            if line is None:
                proc.wait_async(None, finished); return
            log.append(line)
            m = re.match(r"^(pm|dl)status:[^:]*:([\d.]+):", line) or re.search(r"()(\d{1,3})%", line)
            if m:
                frac = min(1.0, float(m.group(2)) / 100)
                self.progress.set_fraction(frac)
                if button:
                    button.set_progress(max(0.02, frac))
            src.read_line_async(GLib.PRIORITY_DEFAULT, None, read_line)

        def finished(p, res):
            p.wait_finish(res)
            ok = p.get_successful()
            self.busy = False; self.progress.hide()
            if button:
                button.frac = None
            if not ok and p.get_exit_status() != 126:   # 126: password dialog dismissed
                d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.ERROR,
                                      buttons=Gtk.ButtonsType.CLOSE,
                                      text=tr("Something went wrong", "Qualcosa non ha funzionato"))
                d.format_secondary_text("\n".join(l for l in log if not l.startswith(("pmstatus", "dlstatus")))[-600:])
                d.run(); d.destroy()
            done(ok)
            self.refresh_buttons()
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, read_line)


if __name__ == "__main__":
    load_css()
    Store().show_all()
    Gtk.main()
