def flatpak_id(c):
    b = c.get_bundle(AS.BundleKind.FLATPAK)
    if not b or not b.get_id():
        return None
    parts = b.get_id().split("/")
    return parts[1] if len(parts) > 1 else b.get_id()


def app_key(c):
    fid = flatpak_id(c)
    return "flatpak:" + fid if fid else c.get_pkgname()
