from gi.repository import AppStream as AS, Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango
from mangos import tr, load_css

HELPER = "/usr/lib/mangos/store-helper"
CACHE = os.path.join(GLib.get_user_cache_dir(), "mangos-store")

# Sections of the sidebar: (id, English, Italian, icon, AppStream categories)
