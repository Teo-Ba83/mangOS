#!/bin/sh
# MangOS: keep the Broadcom wl driver on 2.4 GHz for dual-band networks.
# With routers and mesh extenders that move devices between 2.4 and 5 GHz
# (band steering) the 2007 BCM4321 associates on 5 GHz but never gets an
# address (DHCP), so the Wi-Fi icon spins forever. Once a Wi-Fi network has
# connected, if the same network is also on 2.4 GHz, its saved profile is
# locked to 2.4 GHz. 5 GHz-only networks are left alone. Undo for a network:
#   sudo nmcli connection modify "<name>" 802-11-wireless.band ""
IFACE=$1 ACTION=$2
[ "$ACTION" = up ] || exit 0
[ -d "/sys/class/net/$IFACE/wireless" ] || exit 0
drv=$(basename "$(readlink "/sys/class/net/$IFACE/device/driver" 2>/dev/null)" 2>/dev/null)
[ "$drv" = wl ] || exit 0
[ -n "$CONNECTION_UUID" ] || exit 0
[ -z "$(nmcli -g 802-11-wireless.band connection show uuid "$CONNECTION_UUID" 2>/dev/null)" ] || exit 0
ssid=$(nmcli -g 802-11-wireless.ssid connection show uuid "$CONNECTION_UUID" 2>/dev/null)
[ -n "$ssid" ] || exit 0
esc=$(printf '%s' "$ssid" | sed 's/\\/\\\\/g; s/:/\\:/g')
nmcli -t -f SSID,CHAN device wifi list ifname "$IFACE" --rescan no 2>/dev/null |
while IFS= read -r line; do
  [ "${line%:*}" = "$esc" ] || continue
  chan=${line##*:}
  if [ "$chan" -ge 1 ] 2>/dev/null && [ "$chan" -le 14 ]; then
    nmcli connection modify uuid "$CONNECTION_UUID" 802-11-wireless.band bg &&
      logger -t mangos-wifi "network '$ssid' locked to 2.4 GHz (wl driver, dual-band network)"
    break
  fi
done
exit 0
