#!/bin/sh
# Live boot menu: MangOS names, an Italian entry, no startup beep.
set -e
[ -d binary ] && cd binary
IT="locales=it_IT.UTF-8 keyboard-layouts=it"

if [ -f boot/grub/grub.cfg ]; then
  sed -i 's/Live system (autodetect)/MangOS/; s/Live system (amd64 fail-safe mode)/MangOS (safe graphics)/; s/Live system (amd64)/MangOS/; s/Live system/MangOS/g' boot/grub/grub.cfg
  # 32-bit EFI (2006-2008 Macs): the 64-bit kernel crashes when it calls the
  # 32-bit firmware's runtime services (EFI mixed mode), so turn them off there.
  if ! grep -q mangos_efi32 boot/grub/grub.cfg; then
    { echo 'if [ "${grub_platform}" = "efi" -a "${grub_cpu}" = "i386" ]; then set mangos_efi32="efi=noruntime"; else set mangos_efi32=""; fi'
      cat boot/grub/grub.cfg; } > boot/grub/grub.cfg.new
    mv boot/grub/grub.cfg.new boot/grub/grub.cfg
    sed -i 's|^\(\s*linux\s.*boot=live.*\)$|\1 ${mangos_efi32}|' boot/grub/grub.cfg
  fi
  # Extra entries copied from the first one: Italian, and Wi-Fi with b43
  python3 - boot/grub/grub.cfg "$IT" <<'PY'
import re, sys
p, it = sys.argv[1], sys.argv[2]
s = open(p).read()
m = re.search(r'menuentry "MangOS"[^{]*\{.*?\n\}', s, re.S)
extra = [("MangOS (Italiano)", it, True), ("MangOS (Wi-Fi: b43 driver)", "mangos.wifi=b43", False)]
if m:
    add = ""
    for label, args, strip_locale in extra:
        if label in s:
            continue
        e = m.group(0).replace('menuentry "MangOS"', 'menuentry "%s"' % label, 1)
        if strip_locale:
            e = re.sub(r"locales=\S+", "", e); e = re.sub(r"keyboard-layouts=\S+", "", e)
        e = re.sub(r"(linux\s+\S+)", r"\1 " + args, e, count=1)
        add += "\n" + e
    s = s[:m.end()] + add + s[m.end():]
    open(p, "w").write(s)
PY
fi
[ -f boot/grub/live-theme/theme.txt ] && sed -i 's/^title-text:.*/title-text: ""/' boot/grub/live-theme/theme.txt
[ -f boot/grub/config.cfg ] && sed -i '/^insmod play$/d; /^play /d' boot/grub/config.cfg

for f in isolinux/live.cfg syslinux/live.cfg; do
  [ -f "$f" ] || continue
  sed -i 's/Live system (amd64 fail-safe mode)/MangOS (safe graphics)/; s/Live system (amd64)/MangOS/; s/Live system/MangOS/g' "$f"
  python3 - "$f" "$IT" <<'PY'
import re, sys
p, it = sys.argv[1], sys.argv[2]
s = open(p).read()
m = re.search(r"label live-amd64\n.*?\n\s*append[^\n]*\n", s, re.S)
extra = [("live-amd64-it", "MangOS (Italiano)", it, True), ("live-amd64-b43", "MangOS (Wi-Fi: b43 driver)", "mangos.wifi=b43", False)]
if m:
    add = ""
    for lab, title, args, strip_locale in extra:
        if "label " + lab + "\n" in s:
            continue
        e = m.group(0).replace("label live-amd64\n", "label %s\n" % lab, 1)
        e = re.sub(r"menu label [^\n]*", "menu label " + title, e, count=1)
        e = re.sub(r"\s*menu default\n", "\n", e)
        if strip_locale:
            e = re.sub(r"locales=\S+", "", e); e = re.sub(r"keyboard-layouts=\S+", "", e)
        e = re.sub(r"append ", "append " + args + " ", e, count=1)
        add += "\n" + e
    s = s[:m.end()] + add + s[m.end():]
    open(p, "w").write(s)
PY
done
for f in isolinux/menu.cfg syslinux/menu.cfg isolinux/stdmenu.cfg; do
  [ -f "$f" ] && sed -i 's/^menu title .*/menu title MangOS/' "$f"
done
echo "boot menu branded"
