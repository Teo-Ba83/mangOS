#!/bin/sh
# Step 1.3: add a 32-bit EFI loader (EFI/boot/bootia32.efi) to the ISO, for
# Intel Macs from 2006-2008 (MacBook A1181) whose firmware is 32-bit EFI.
# live-build 20250505 only does this when signed GRUB is in use, and even
# then its check reads variables that are out of scope, so we do it here
# with live-build's own efi-image helper. Runs inside binary/ on the host.
set -e
B=$PWD
LB=/usr/lib/live/build
export SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH:-$(date +%s)}
export PATH="$PATH:$LB"
[ -d /usr/lib/grub/i386-efi ] || { echo "grub-efi-ia32-bin missing on build host" >&2; exit 1; }

T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT
(cd "$T" && "$LB/efi-image" "$T/out" i386-efi ia32 debian-live/i386 >/dev/null)

mkdir -p "$B/EFI/boot"
mcopy -n -i "$T/out/efi.img" ::efi/boot/bootia32.efi "$B/EFI/boot/bootia32.efi"
rm -rf "$B/boot/grub/i386-efi"
cp -a "$T/out/boot/grub/i386-efi" "$B/boot/grub/"

# Rebuild the El Torito / ESP image with every loader plus the small
# grub.cfg live-build put there (it finds the ISO partition and chains on).
mcopy -n -i "$B/boot/grub/efi.img" ::boot/grub/grub.cfg "$T/cfg.cfg"
size=0
for f in "$B"/EFI/boot/*.efi "$T/cfg.cfg"; do size=$((size + $(stat -c %s "$f"))); done
size=$((size + 4096 * 4))
blocks=$(( (size / 1024 + 55) / 32 * 32 ))
rm -f "$B/boot/grub/efi.img"
mkfs.msdos -C "$B/boot/grub/efi.img" $blocks -i $(printf "%08x" $((SOURCE_DATE_EPOCH % 4294967296))) >/dev/null
mmd -i "$B/boot/grub/efi.img" ::EFI ::EFI/boot ::boot ::boot/grub
mcopy -m -o -i "$B/boot/grub/efi.img" "$B"/EFI/boot/*.efi ::EFI/boot
mcopy -m -o -i "$B/boot/grub/efi.img" "$T/cfg.cfg" ::boot/grub/grub.cfg
echo "EFI loaders:"; mdir -b -i "$B/boot/grub/efi.img" ::EFI/boot
