#!/bin/sh
# Desktop defaults: merge xfconf settings, compile dconf/gsettings, caches,
# default apps and services.
set -e
/usr/lib/mangos/xfconf-merge /usr/share/mangos/xfconf /etc/xdg/xfce4/xfconf/xfce-perchannel-xml

dconf update
glib-compile-schemas /usr/share/glib-2.0/schemas
for t in /usr/share/icons/*/; do
  [ -f "$t/index.theme" ] && gtk-update-icon-cache -q -f "$t" || true
done
fc-cache -f >/dev/null
update-desktop-database -q /usr/share/applications || true

update-alternatives --set x-session-manager /usr/bin/xfce4-session || true
update-alternatives --set x-www-browser /usr/bin/firefox-esr || true
update-alternatives --set x-terminal-emulator /usr/bin/xfce4-terminal.wrapper || true
update-alternatives --install /usr/share/icons/default/index.theme x-cursor-theme \
  /usr/share/icons/WhiteSur-cursors/index.theme 90
update-alternatives --set x-cursor-theme /usr/share/icons/WhiteSur-cursors/index.theme

# Global menu: load the appmenu GTK module in every X session.
cat > /etc/X11/Xsession.d/85mangos-appmenu <<'XS'
if [ -z "$GTK_MODULES" ]; then GTK_MODULES=appmenu-gtk-module; else
  case ":$GTK_MODULES:" in *:appmenu-gtk-module:*) ;; *) GTK_MODULES="$GTK_MODULES:appmenu-gtk-module";; esac
fi
export GTK_MODULES UBUNTU_MENUPROXY=1
XS

# Services: Mac keyboard (keyd), MacBook fan control (mbpfan)
systemctl enable keyd.service || true
systemctl enable mbpfan.service || true
# Avoid slow boots waiting for the network
systemctl disable NetworkManager-wait-online.service 2>/dev/null || true

# Automatic security updates
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'AU'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
AU

# Locales: English default, Italian ready.
sed -i 's/^# *\(en_US.UTF-8 UTF-8\)/\1/; s/^# *\(it_IT.UTF-8 UTF-8\)/\1/; s/^# *\(en_GB.UTF-8 UTF-8\)/\1/' /etc/locale.gen
locale-gen
update-locale LANG=en_US.UTF-8

# Firefox: follow the system light/dark look, no first-run noise.
mkdir -p /etc/firefox-esr
cat > /etc/firefox-esr/mangos.js <<'FF'
pref("browser.startup.homepage_override.mstone", "ignore");
pref("browser.aboutwelcome.enabled", false);
pref("widget.gtk.overlay-scrollbars.enabled", true);
pref("layout.css.prefers-color-scheme.content-override", 2);
FF

# Hide menu entries that only add clutter to Launchpad.
for f in xfce4-about debian-xterm debian-uxterm display-im6.q16 im-config ibus-setup \
         xfce4-run org.xfce.xfce4-appfinder xfce4-session-logout lightdm-gtk-greeter-settings \
         rofi rofi-theme-selector blueman-adapters vim; do
  [ -f /usr/share/applications/$f.desktop ] && \
    { grep -q '^NoDisplay=true' /usr/share/applications/$f.desktop || \
      sed -i 's/^\[Desktop Entry\]$/[Desktop Entry]\nNoDisplay=true/' /usr/share/applications/$f.desktop; }
done
